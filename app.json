{
  "expo": {
    "name": "Lexy",
    "slug": "lexy",
    "owner": "ide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lexy",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/50920011-b780-458b-9aaa-e305a424af77"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.ide.lexy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ide.lexy",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "./plugins/without-widget-push-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.ide.lexy.Widgets",
          "widgets": [
            {
              "name": "LexyStatusWidget",
              "displayName": "Lexy Status",
              "description": "Vehicle lock status at a glance",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.ide.lexy.Widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.ide.lexy"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "50920011-b780-458b-9aaa-e305a424af77"
      }
    }
  }
}
