size 390x844

test "command controls wait for the request and then enable the current choices"
  expect disabled "command-door-lock"
  expect disabled "command-door-unlock"
  expect disabled "command-engine-start"
  expect disabled "command-trunk-lock"
  expect disabled "command-trunk-unlock"
  expect disabled "command-hazard-on"
  expect disabled "command-headlight-on"
  expect disabled "command-buzzer-warning"
  expect disabled "command-sound-horn"
  tap "finish"
  expect enabled "command-door-lock"
  expect enabled "command-door-unlock"
  expect enabled "command-engine-stop"
  expect enabled "command-trunk-lock"
  expect enabled "command-trunk-unlock"
  expect enabled "command-hazard-off"
  expect enabled "command-headlight-on"
  expect enabled "command-buzzer-warning"
  expect enabled "command-sound-horn"

// The fixture's Fail button (`failed`) starts a climate write, refused a minute later, while a command's
// confirmation is open, so the error waits behind it: first a confirmation that is cancelled, then one
// that is confirmed. The error's text stays in the tree after the first refusal, so `climatePending` shows the
// second one.
test "a climate error waits until the remote confirmation closes, and Confirm dispatches its command before the error is acknowledged"
  tap "finish"
  tap "failed"
  tap "command-door-lock"
  clock settle
  expect state climatePending == true
  clock +60000
  clock settle
  expect state climatePending == false
  expect tree has "cancel-door-lock"
  tap "cancel-door-lock"
  clock settle
  expect text "climate-failed-message" == "Lexus didn't accept the new climate settings. Try the change again in a moment."
  tap "climate-failed-ok"
  clock settle
  tap "command-door-lock"
  clock settle
  expect tree has "cancel-door-lock"
  tap "cancel-door-lock"
  clock settle
  expect state lastCommand == ""
  tap "failed"
  tap "command-door-lock"
  clock settle
  expect state climatePending == true
  clock +60000
  clock settle
  expect state climatePending == false
  tap "confirm-door-lock"
  clock settle
  expect state lastCommand == "door-lock"
  expect text "climate-failed-message" == "Lexus didn't accept the new climate settings. Try the change again in a moment."
  tap "climate-failed-ok"
  clock settle
  expect state lastCommand == "door-lock"

test "Performance distinguishes a pending read, failure and empty success"
  tap "performance"
  clock settle
  expect text "performance-recent-message" == "Loading performance data…"
  tap "failed"
  expect text "performance-recent-message" == "Performance data is unavailable."
  tap "empty"
  expect text "performance-recent-message" == "Nothing recorded yet. Open a screen or relaunch the app."
  tap "fill"
  clock settle
  expect tree missing "performance-recent-message"
  expect tree has "perf-launch-timeToInteractive"
  expect tree missing "perf-nav-199"
  tap "perf-launch-row-timeToInteractive" contextmenu
  clock settle
  expect tree has "copy-metric"
  tap "copy-metric"
  clock settle

test "the unfolded Performance screen keeps medians in their own pane"
  size 951x669
  tap "performance"
  tap "fill"
  clock settle
  expect tree has "performance-recent-list"
  expect tree has "performance-medians-list"
  expect tree has "perf-median-timeToInteractive"
  expect tree has "perf-launch-timeToInteractive"
  expect tree missing "perf-nav-199"
