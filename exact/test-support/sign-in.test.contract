// Login Flow answers from its mock tree, so no request leaves the app. The mock answers at once, and
// `clock data` lands a step's answers and opens its next screen, so no test can hold a request out
// to look at it. The screen that left shows what the request looked like: it keeps its disabled
// controls and its spinner for a second while it slides away.
at "/settings?developer=on"

test "the screen a step leaves keeps its disabled controls and its spinner while it slides away, then turns idle" on macos
  clock settle
  tap "try-demo"
  clock data
  clock settle
  tap "tab-settings"
  clock settle
  tap "dev-login"
  clock settle
  expect disabled "sign-in-button"
  type "email" "driver@example.com"
  type "password" "secret"
  expect enabled "sign-in-button"
  tap "sign-in-button"
  clock data
  expect state authRouteStep == "choice"
  expect enabled "method-0"
  expect enabled "method-1"
  expect disabled "sign-in-button"
  expect disabled "email"
  expect tree has "sign-in-button-spinner"
  clock +1000
  expect enabled "sign-in-button"
  expect tree missing "sign-in-button-spinner"
  tap "method-1"
  clock data
  expect state authRouteStep == "otp"
  expect enabled "resend"
  expect disabled "verify-button"
  expect disabled "method-0"
  expect disabled "method-1"
  expect tree has "method-actions-spinner"
  clock +1000
  expect enabled "method-1"
  expect tree missing "method-actions-spinner"
  tap "resend"
  clock data
  clock settle
  expect enabled "resend"
  expect tree missing "resend-spinner"
  expect state signInfo == "Lexus sent a new code."
  type "code" "123456"
  expect enabled "verify-button"
  tap "verify-button"
  clock data
  expect tree has "preview-done"

test "Resend Code says Lexus sent a new code where the code comes without a method choice" on macos
  clock settle
  tap "try-demo"
  clock data
  clock settle
  tap "tab-settings"
  clock settle
  tap "dev-login"
  clock settle
  tap "scenario"
  clock settle
  tap "scenario-success-single"
  clock settle
  type "email" "driver@example.com"
  type "password" "secret"
  tap "sign-in-button"
  clock data
  clock settle
  expect state authRouteStep == "otp"
  expect state signInfo == ""
  tap "resend"
  clock data
  clock settle
  expect enabled "resend"
  expect state signInfo == "Lexus sent a new code."

test "a refused password or code enables its controls again at once and stops the spinner" on macos
  clock settle
  tap "try-demo"
  clock data
  clock settle
  tap "tab-settings"
  clock settle
  tap "dev-login"
  clock settle
  tap "scenario"
  clock settle
  tap "scenario-wrong-password"
  clock settle
  type "email" "driver@example.com"
  type "password" "secret"
  tap "sign-in-button"
  clock data
  expect enabled "sign-in-button"
  expect enabled "email"
  expect tree missing "sign-in-button-spinner"
  expect tree has "sign-in-error"
  tap "scenario"
  clock settle
  tap "scenario-wrong-code"
  clock settle
  type "email" "driver@example.com"
  type "password" "secret"
  tap "sign-in-button"
  clock data
  clock settle
  tap "method-0"
  clock data
  clock settle
  type "code" "123456"
  tap "verify-button"
  clock data
  expect enabled "verify-button"
  expect enabled "code"
  expect tree missing "verify-button-spinner"
  expect tree has "sign-in-error"

// The demo signs in through the same steps, against an in-memory Lexus that cannot fail a read, so
// these check that the reads happen: a sign-in ends as a pull does, reading the status and the
// climate settings again once the car has been asked to report (`statusRev`, `climateRev`), and a
// climate change saved before then shows until that read lands.
test "a sign-in reads the climate settings again after it asks the car to report" on macos
  clock settle
  tap "try-demo"
  clock data
  clock settle
  clock data
  clock settle
  clock +5000
  clock data
  clock settle
  clock +5000
  clock data
  clock settle
  expect state primeOnSignIn == false
  expect state statusRev == 2
  expect state climateRev == 1
  expect state climateRead.ok == true
  expect state climate.on == true

test "a climate change saved before the sign-in's re-read shows until that read lands" on macos
  clock settle
  tap "try-demo"
  clock data
  clock settle
  clock data
  clock settle
  expect state primeOnSignIn == true
  expect state climateRev == 0
  expect state climateRead.ok == true
  tap "climate-switch"
  clock data
  clock settle
  expect state climateWrittenRev == 0
  expect state climate.on == false
  expect state climateRead.on == true
  clock +5000
  clock data
  clock settle
  clock +5000
  clock data
  clock settle
  expect state primeOnSignIn == false
  expect state climateRev == 1
  expect state climateRead.on == false
  expect state climate.on == false
  expect state climateWritten == none
