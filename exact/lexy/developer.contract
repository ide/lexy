use SafeScroll from "./model.contract"
// Settings → Developer Tools, as the Expo app has them
// (src/screens/settings-screen.ios.tsx DEV_ITEMS): this build's updates, the
// data states forced on demand, the sign-in flow walked against a mock, and
// the project on EAS. The rows that open them are settings.contract's.
use Card from "./model.contract"
use MapsApp from "./model.contract"
use mapsName from "./model.contract"
use exactTime from "./model.contract"
use SectionHeader, SettingsColumn, FormColumn from "./settings.contract"
use SectionFooter from "./settings.contract"
use LockScreen from "./sign-in.contract"
use exactVersion from "./exact-version.contract"

// This device's own Observe metrics (Exact's modules/observe keeps them for 7
// days before and after sending; app.ts reads them through the native module).
shape ObservedMetric
  session: string
  time: number
  category: string
  name: string
  value: number
  route: string
  sent: bool
  trace: string
  // The launch's phases (Observe's exact.phase.*) and each item that held
  // TTI with its span, ms from process start (exact.tti.items).
  phases: string
  items: string
  // Batches that still changed the screen after nothing was loading.
  changes: string
  // TTR and TTI again from process start (the kernel's), on the launch's TTI.
  fromStart: string
  // A screen's render step by step: route change, commit, frame.
  steps: string

shape ObservedSummary
  name: string
  count: number
  median: number

// Clear's answer: what is recorded so far is hidden from Performance.
shape ObservedCleared
  ok: bool
  clearedAt: number

shape Observed
  ok: bool
  session: string
  // The newest launch with its startup marks (the one running may not have
  // reported them yet: TTI waits for the first settled frame).
  launch: string
  // That launch's marks: launch, TTR, then TTI.
  latest: ObservedMetric[]
  metrics: ObservedMetric[]
  summary: ObservedSummary[]

// The pill: what was measured. TTR is the first frame; TTI the first frame
// with nothing loading. A screen's TTR is cold for a new screen, warm for one
// shown before (back, a tab seen before).
fn metricPill(name: string): string = name == "coldLaunchTime" or name == "warmLaunchTime" ? "LAUNCH" : (name == "cold_ttr" ? "COLD TTR" : (name == "warm_ttr" ? "WARM TTR" : (name == "timeToFirstRender" or name == "ttr" ? "TTR" : (name == "timeToInteractive" or name == "tti" ? "TTI" : (name == "download_time" or name == "downloadTime" ? "UPDATE" : name)))))
// Beside the pill, in monospace: the route, or which kind of launch.
fn metricWhere(name: string, route: string): string = name == "coldLaunchTime" ? "cold" : (name == "warmLaunchTime" ? "warm" : (route == "" ? "launch" : route))
fn milliseconds(seconds: number): string = `${floor(seconds * 1000 + 0.5)} ms`

fn metricReport(m: ObservedMetric, utcOffset: number): string = [exactTime(m.time * 1000, utcOffset), milliseconds(m.value), m.fromStart, m.phases == "" ? "" : `Phases: ${m.phases}`, m.items == "" ? "" : `Held by (ms from process start): ${m.items}`, m.changes == "" ? "" : `Still changing: ${m.changes}`, m.trace == "" ? "" : `Waited on: ${m.trace}`].filter(line => line != "").join("\n")

// What the binary knows about its own delivery (Exact LLP 1030 D7), answered
// by the runner from the update store.
shape Delivery
  stream: string
  seq: number
  embeddedSeq: number
  staged: bool
  sunset: string
  interpreted: string[]
  compatibilityId: string

// data-state.ts DATA_STATE_OPTIONS, in display order.
fn dataStateTitle(kind: string): string = kind == "live" ? "Live" : (kind == "loading" ? "Loading skeleton" : (kind == "offline-cached" ? "Offline — cached data" : (kind == "offline-empty" ? "Offline — no cache" : (kind == "error-cached" ? "Fetch error — cached data" : (kind == "error-empty" ? "Fetch error — no cache" : "No vehicle on account")))))
fn dataStateDetail(kind: string): string = kind == "live" ? "Use the real Lexus data — no override." : (kind == "loading" ? "Hold the first-load skeleton." : (kind == "offline-cached" ? "Show the last-seen dashboard behind the offline banner." : (kind == "offline-empty" ? "Offline before anything was ever loaded." : (kind == "error-cached" ? "Show the last-seen dashboard behind the refresh-failed banner." : (kind == "error-empty" ? "Force the full-screen “Vehicle data unavailable” error." : "Force the “No vehicle found” empty state.")))))

// preview-lexus-backend.ts PREVIEW_SCENARIOS.
fn scenarioTitle(id: string): string = id == "success-multi" ? "Success · Email or SMS" : (id == "success-single" ? "Success · Single Method" : (id == "wrong-password" ? "Error · Wrong Password" : (id == "wrong-code" ? "Error · Invalid Code" : "Error · Network Failure")))
fn scenarioDetail(id: string): string = id == "success-multi" ? "Two verification methods offered — the full happy path." : (id == "success-single" ? "One method only — the flow skips the picker straight to the code." : (id == "wrong-password" ? "Lexus rejects the credentials." : (id == "wrong-code" ? "Lexus rejects the verification code." : "Requests never reach Lexus.")))
fn scenarioSymbol(id: string): string = id == "success-multi" ? "checkmark.seal.fill" : (id == "success-single" ? "checkmark.seal" : (id == "wrong-password" ? "xmark.octagon.fill" : (id == "wrong-code" ? "xmark.octagon" : "wifi.slash")))

// A label and its value on one grouped row; the value can be copied.
component FactRow
  props
    label: string
    value: string
    id: string
  view
    row padding=16 justify-content="space-between" align-items="center" gap=16
      text label font-size=17 flex-shrink=0
      text value testId=id font-size=17 color="-exact-secondary-label" flex-shrink=1 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis" user-select="text"

component Divider
  view
    box height=0.5 margin-left=16 background-color="-exact-separator"

// A choice among several: the title over what it does, checked when chosen.
component ChoiceRow
  props
    title: string
    detail: string
    chosen: bool
    press: action
    id: string
  view
    button text-align="left" press=press testId=id aria-selected=chosen display="flex"
      row gap=12 padding=16 align-items="center" width="100%" box-sizing="border-box"
        column flex=1 min-width=0 gap=2
          text title font-size=17 color="-exact-label"
          text detail font-size=13 color="-exact-secondary-label"
        box width=20 height=20
          if chosen
            image "symbol:icon.checkmark" font-size=17 font-weight=600 color="AccentColor" object-fit="scale-down" width=20 height=20

// One content tree: stack on a phone, independently scroll each pane when expanded
component DeveloperPanes
  props
    expanded: bool
    id: string
  slot
  view
    column id="screen-scroll" testId=`${id}-scroll` overflow-y=(expanded ? "visible" : "auto") overflow-x=(expanded ? "visible" : "hidden") flex=1 min-height=0 width="100%" box-sizing="border-box" padding-left=(expanded ? "0px" : "env(safe-area-inset-left)") padding-right=(expanded ? "0px" : "env(safe-area-inset-right)")
      column hatch="developer-panes" data-expanded=expanded testId=id display="flex" flex-direction=(expanded ? "row" : "column") height=(expanded ? "100%" : "auto") width="100%" padding-bottom=(expanded ? "0px" : "16px") box-sizing="border-box"
        children

component DeveloperPane
  props
    expanded: bool
    first: bool
    id: string
  slot
  view
    column id=(first ? "developer-first-scroll" : "developer-second-scroll") testId=id flex=(expanded ? "1 1 0%" : "none") min-width=0 min-height=0 box-sizing="border-box" height=(expanded ? "100%" : "auto") overflow-y=(expanded ? "auto" : "visible") overflow-x=(expanded ? "hidden" : "visible")
      column gap=24 padding-left=(expanded and first ? "calc(env(safe-area-inset-left) + 16px)" : "16px") padding-right=(expanded and not first ? "calc(env(safe-area-inset-right) + 16px)" : "16px") padding-top=(expanded or first ? "16px" : "24px") padding-bottom=(expanded ? "16px" : "0px") box-sizing="border-box" width="100%"
        children

// update-diagnostics-screen.ios.tsx, for Exact's update store: what is
// running, what it shipped with, and whether a newer bundle waits.
component UpdatesScreen
  props
    wide: bool
    fold: string
    delivery: Delivery
    version: string
    checked: bool
    check: action
    apply: action
  derive expanded = fold == "across" or (wide and fold != "down")
  view
    DeveloperPanes(expanded=expanded, id="updates-panes")
      DeveloperPane(expanded=expanded, first=true, id="updates-details")
        column
          SectionHeader(title="Running")
          column class=Card
            FactRow(label="Version", value=version, id="updates-version")
            Divider()
            FactRow(label="Source", value=(delivery.seq > delivery.embeddedSeq ? "Downloaded update" : "Embedded in the build"), id="updates-source")
            Divider()
            FactRow(label="Sequence", value=`${delivery.seq}`, id="updates-seq")
            Divider()
            FactRow(label="Embedded sequence", value=`${delivery.embeddedSeq}`, id="updates-embedded-seq")
          SectionFooter(words=`Built with Exact ${exactVersion()}.`)
        column
          SectionHeader(title="Stream")
          column class=Card
            FactRow(label="Stream", value=delivery.stream, id="updates-stream")
            Divider()
            FactRow(label="Compatibility", value=(delivery.compatibilityId != "" ? delivery.compatibilityId : "—"), id="updates-compat")
            Divider()
            FactRow(label="Interpreted", value=(delivery.interpreted.length == 0 ? "None" : delivery.interpreted.join(", ")), id="updates-interpreted")
          SectionFooter(words="Updates must match this build’s native code.")
        if delivery.sunset != ""
          column gap=8 padding=16 border-radius=14 background-color="-exact-secondary-grouped-background" testId="updates-sunset"
            text "This build is being retired" font-size=15 font-weight=600 color="-exact-system-orange"
            text delivery.sunset font-size=13 color="-exact-secondary-label"
      DeveloperPane(expanded=expanded, first=false, id="updates-actions")
        column
          SectionHeader(title="Actions")
          // Rows of a card, each a native button with its symbol, as Copy Log
          // is, whose title and symbol UIKit fades together as it highlights;
          // Apply waits for a download
          column class=Card
            button text-align="left" press=check testId="updates-check" padding=16 display="flex"
              image "symbol:icon.arrow_triangle_2_circlepath"
              text "Check for Update" font-size=17 color="AccentColor"
            Divider()
            button text-align="left" press=apply disabled=(not delivery.staged) testId="updates-apply" padding=16 display="flex"
              image "symbol:icon.arrow.down.circle.fill"
              text "Apply Downloaded Update" font-size=17 color=(delivery.staged ? "AccentColor" : "-exact-tertiary-label")
          SectionFooter(words=(checked and not delivery.staged ? "Checked for updates. Downloads appear here when ready." : "Updates download in the background and apply at the next launch. You can also apply a downloaded update now."))

// data-state-screen.ios.tsx: one override at a time, Live by default and
// after every launch (it lives in memory only).
component DataStateScreen
  props
    current: string
    choose: action
    apps: MapsApp
    provider: string
    clearMaps: action
  view
    scroll id="screen-scroll" testId="data-state-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%" class=SafeScroll
      SettingsColumn(id="data-state-column")
        column
          SectionHeader(title="Data State")
          column class=Card
            ChoiceRow(title=dataStateTitle("live"), detail=dataStateDetail("live"), chosen=(current == "live"), press=choose("live"), id="data-state-live")
            Divider()
            ChoiceRow(title=dataStateTitle("loading"), detail=dataStateDetail("loading"), chosen=(current == "loading"), press=choose("loading"), id="data-state-loading")
            Divider()
            ChoiceRow(title=dataStateTitle("offline-cached"), detail=dataStateDetail("offline-cached"), chosen=(current == "offline-cached"), press=choose("offline-cached"), id="data-state-offline-cached")
            Divider()
            ChoiceRow(title=dataStateTitle("offline-empty"), detail=dataStateDetail("offline-empty"), chosen=(current == "offline-empty"), press=choose("offline-empty"), id="data-state-offline-empty")
            Divider()
            ChoiceRow(title=dataStateTitle("error-cached"), detail=dataStateDetail("error-cached"), chosen=(current == "error-cached"), press=choose("error-cached"), id="data-state-error-cached")
            Divider()
            ChoiceRow(title=dataStateTitle("error-empty"), detail=dataStateDetail("error-empty"), chosen=(current == "error-empty"), press=choose("error-empty"), id="data-state-error-empty")
            Divider()
            ChoiceRow(title=dataStateTitle("no-vehicle"), detail=dataStateDetail("no-vehicle"), chosen=(current == "no-vehicle"), press=choose("no-vehicle"), id="data-state-no-vehicle")
          SectionFooter(words="The override applies to the Status and Specs tabs, and resets to Live when the app relaunches.")
        column
          SectionHeader(title="Persisted State")
          column class=Card
            button text-align="left" press=clearMaps disabled=(provider == "") testId="clear-maps" padding=16 display="flex"
              column gap=2 align-items="flex-start"
                text "Clear Maps provider" font-size=17 color=(provider == "" ? "-exact-tertiary-label" : "-exact-system-red")
                text (provider == "" ? "No saved provider" : `Currently ${mapsName(provider)}`) font-size=13 color="-exact-secondary-label"
          SectionFooter(words="Forgetting it makes the next map hand-off pick the only app installed, or ask again.")

// login-preview-screen.ios.tsx: the real sign-in screen and step machine
// against a mock tree; the session in the Keychain is never touched.
component LoginScenarioChooser
  props
    chooseScenario: action
  view
    column id="scenario-chooser" popover="auto" role="alertdialog" aria-label="Preview Scenario" position="absolute"
      button press=chooseScenario("success-multi") popovertarget="scenario-chooser" popovertargetaction="hide" testId="scenario-success-multi"
        text scenarioTitle("success-multi")
      button press=chooseScenario("success-single") popovertarget="scenario-chooser" popovertargetaction="hide" testId="scenario-success-single"
        text scenarioTitle("success-single")
      button press=chooseScenario("wrong-password") popovertarget="scenario-chooser" popovertargetaction="hide" testId="scenario-wrong-password"
        text scenarioTitle("wrong-password")
      button press=chooseScenario("wrong-code") popovertarget="scenario-chooser" popovertargetaction="hide" testId="scenario-wrong-code"
        text scenarioTitle("wrong-code")
      button press=chooseScenario("network-error") popovertarget="scenario-chooser" popovertargetaction="hide" testId="scenario-network-error"
        text scenarioTitle("network-error")

component LoginPreviewScreen
  props
    fold: string
    compact: bool
    scenario: string
    done: bool
    runAgain: action
    step: string
    email: string
    password: string
    code: string
    error: string
    busy: bool
    spinner: string
    info: string
    choices: string[]
    prompt: string
    method: string
    setEmail: action
    setPassword: action
    setCode: action
    signIn: action
    choose: action
    verify: action
    resend: action
    getLexusApp: action
    nextField: action
  view
    if not done or step != "credentials"
      LockScreen(compact=compact, developer=false, step=step, email=email, password=password, code=code, error=error, busy=busy, spinner=spinner, info=info, choices=choices, prompt=prompt, setEmail=setEmail, setPassword=setPassword, setCode=setCode, signIn=signIn, choose=choose, verify=verify, resend=resend, tryDemo=runAgain, getLexusApp=getLexusApp, nextField=nextField, method=method, embedded=true, fold=fold, banner=scenarioTitle(scenario), bannerSymbol=scenarioSymbol(scenario))
    if done and step == "credentials"
      scroll id="sign-in-scroll" testId="preview-result" flex=1 min-height=0 overflow-x="hidden" class=SafeScroll
        FormColumn(fold=fold, id="preview-result-column")
          column testId="preview-done" align-items="center" gap=12 padding=16
            image "symbol:icon.checkmark.seal.fill" font-size=56 color="-exact-system-green"
            text "You’re Signed In" role="heading" aria-level=2 text-align="center"
            text "That was the real sign-in flow against a mock Lexus. No real sign-in happened, and your session is as it was." font-size=15 color="-exact-secondary-label" text-align="center"
            text `${scenarioTitle(scenario)}: ${scenarioDetail(scenario)}` font-size=13 color="-exact-tertiary-label" text-align="center"
            button press=runAgain testId="run-again" appearance="auto" buttonStyle="prominent-glass" accent-color="AccentColor" height=50 border-radius=25 padding-left=32 padding-right=32 margin-top=12 display="flex" align-items="center" justify-content="center"
              text "Run Again" font-size=17 font-weight=600 color="#ffffff"

// eas-screen.ios.tsx: the project's pages on expo.dev, in Safari, where the
// dashboard's session lives.
component EasScreen
  props
    open: action
  view
    scroll id="screen-scroll" testId="eas-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%" class=SafeScroll
      SettingsColumn(id="eas-column")
        column
          SectionHeader(title="Dashboard")
          column class=Card
            button text-align="left" press=open("https://expo.dev/accounts/ide/projects/lexy") testId="eas-home" display="flex"
              EasRow(symbol="house.fill", title="Project Home", subtitle="The project overview and its recent activity.")
            box height=0.5 margin-left=60 background-color="-exact-separator"
            button text-align="left" press=open("https://expo.dev/accounts/ide/projects/lexy/observe") testId="eas-observe" display="flex"
              EasRow(symbol="waveform.path.ecg", title="Observe", subtitle="Launch, render, and navigation metrics from real devices.")
            box height=0.5 margin-left=60 background-color="-exact-separator"
            button text-align="left" press=open("https://expo.dev/accounts/ide/projects/lexy/workflows") testId="eas-workflows" display="flex"
              EasRow(symbol="flowchart.fill", title="Workflows", subtitle="The runs that build this Exact app.")
            box height=0.5 margin-left=60 background-color="-exact-separator"
            button text-align="left" press=open("https://expo.dev/accounts/ide/projects/lexy/builds") testId="eas-builds" display="flex"
              EasRow(symbol="hammer.fill", title="Builds", subtitle="Native builds, their logs, and install links.")
          SectionFooter(words="Opens expo.dev in Safari for @ide/lexy. You need to be signed in on the dashboard to see anything.")

// A row that leaves the app: an external-link glyph, not a push chevron.
component EasRow
  props
    symbol: string
    title: string
    subtitle: string
  view
    row gap=16 padding=16 align-items="center" width="100%" box-sizing="border-box"
      image `symbol:icon.${symbol}` font-size=22 color="AccentColor" object-fit="scale-down" width=28 height=26
      column flex=1 min-width=0 gap=2
        text title font-size=17 font-weight=600 color="-exact-label"
        text subtitle font-size=13 font-weight=500 color="-exact-secondary-label"
      image "symbol:icon.arrow.up.right.square" font-size=15 color="-exact-secondary-label" object-fit="scale-down" width=18 height=20

// A metric: its pill and route over when it was recorded, its value at the end.
component MetricRow
  props
    name: string
    route: string
    detail: string
    value: string
    id: string
  view
    row padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 justify-content="space-between" align-items="center" gap=12
      column flex=1 min-width=0 gap=4
        row align-items="center" gap=8
          text metricPill(name) font-size=11 font-weight=700 color=(metricPill(name) == "TTI" ? "-exact-system-green" : (metricPill(name) == "WARM TTR" ? "-exact-system-orange" : (metricPill(name).includes("TTR") ? "-exact-system-blue" : "-exact-secondary-label"))) background-color="-exact-tertiary-fill" border-radius=6 padding-left=6 padding-right=6 padding-top=4 padding-bottom=4 text-box="trim-both cap alphabetic" flex-shrink=0
          text metricWhere(name, route) font-family="ui-monospace" font-size=15 flex-shrink=1 min-width=0 overflow="hidden" white-space="nowrap" text-overflow="ellipsis"
        text detail font-size=13 color="-exact-secondary-label"
      text value testId=id font-size=17 color="-exact-secondary-label" flex-shrink=0 font-variant-numeric="tabular-nums"

// Flatten the sections into rows so only the visible metrics construct views.
shape PerformanceRow
  kind: string
  key: string
  id: string
  heading: string
  name: string
  route: string
  detail: string
  at: number
  value: string
  lines: string[]
  report: string
  last: bool
  footer: string

fn performanceMetric(m: ObservedMetric, id: string, heading: string, last: bool, launch: bool, utcOffset: number): PerformanceRow = PerformanceRow(
  kind="metric", key=`${m.category}-${m.session}-${m.route}-${m.name}-${m.time}`, id=id, heading=heading, name=m.name, route=m.route,
  detail="Unknown time", at=m.time * 1000, value=milliseconds(m.value),
  lines=(launch ? [m.fromStart, m.phases == "" ? "" : `Phases: ${m.phases}`, m.items == "" ? "" : `Held by (ms from process start): ${m.items}`, m.changes == "" ? "" : `Still changing: ${m.changes}`, m.trace == "" ? "" : `Waited on: ${m.trace}`] : [m.steps]).filter(line => line != ""),
  report=(launch and m.name == "timeToInteractive" ? metricReport(m, utcOffset) : ""),
  last=last, footer=""
)

component PerformanceScreen
  props
    scrollMeasurement: bool
    setScrollMeasurement: action
    wide: bool
    fold: string
    observed: Observed
    loading: bool
    utcOffset: number
  state selectedReport = ""
  action aimMetric(report: string)
    selectedReport = report
  action copyMetric
    copyText(selectedReport)
  derive expanded = fold == "across" or (wide and fold != "down")
  derive navigation = observed.metrics.filter(m => m.session == observed.session and m.category == "navigation")
  derive launches = observed.latest.map((m, i) => performanceMetric(m, `perf-launch-${m.name}`, i == 0 ? (observed.launch == observed.session ? "This Launch" : "Last Launch") : "", i == observed.latest.length - 1, true, utcOffset))
  derive screens = navigation.map((m, i) => performanceMetric(m, `perf-nav-${i}`, i == 0 ? "Screens" : "", i == navigation.length - 1, false, utcOffset))
  derive sent = observed.metrics.filter(m => m.sent).length
  derive medians = observed.summary.map((s, i) => PerformanceRow(kind="metric", key=`median-${s.name}`, id=`perf-median-${s.name}`, heading=(i == 0 ? "Median" : ""), name=s.name, route="", at=0, detail=(s.count == 1 ? "1 launch" : `${s.count} launches`), value=milliseconds(s.median), lines=[], report="", last=(i == observed.summary.length - 1), footer=(i == observed.summary.length - 1 ? `${sent} of ${observed.metrics.length} sent to Observe.` : "")))
  derive message = not observed.ok ? (loading ? "Loading performance data…" : "Performance data is unavailable.") : (launches.length == 0 and screens.length == 0 and medians.length == 0 ? "Nothing recorded yet. Open a screen or relaunch the app." : "")
  derive leading = [performanceNote("measurement", "")].concat(message != "" ? [performanceNote("message", message)] : []).concat(observed.ok ? launches : [])
  derive trailing = observed.ok ? medians.concat(screens) : []
  view
    column hatch="developer-panes" data-expanded=expanded testId="performance-panes" display="flex" flex-direction=(expanded ? "row" : "column") flex=1 min-height=0 width="100%" height="100%"
      PerformanceList(rows=(expanded ? leading : leading.concat(trailing)), expanded=expanded, first=true, shown=true, utcOffset=utcOffset, id="performance-recent", aimMetric=aimMetric, scrollMeasurement=scrollMeasurement, setScrollMeasurement=setScrollMeasurement)
      PerformanceList(rows=trailing, expanded=expanded, first=false, shown=expanded, utcOffset=utcOffset, id="performance-medians", aimMetric=aimMetric, scrollMeasurement=scrollMeasurement, setScrollMeasurement=setScrollMeasurement)
    column id="metric-menu" popover="auto" role="menu"
      button press=copyMetric popovertarget="metric-menu" popovertargetaction="hide" testId="copy-metric"
        text "Copy"

fn performanceNote(kind: string, words: string): PerformanceRow = PerformanceRow(kind=kind, key=kind, id=kind, heading="", name=words, route="", detail="", at=0, value="", lines=[], report="", last=true, footer="")

component PerformanceList
  props
    shown: bool
    utcOffset: number
    rows: PerformanceRow[]
    expanded: bool
    first: bool
    id: string
    aimMetric: action
    scrollMeasurement: bool
    setScrollMeasurement: action
  view
    list id=(expanded ? (first ? "developer-first-scroll" : "developer-second-scroll") : "screen-scroll") testId=`${id}-list` display="block" visibility=(shown ? "visible" : "hidden") appearance="none" virtualized=true estimated-item-height=80 flex=(shown ? "1 1 0%" : "0 0 0px") min-width=0 min-height=0 height=(shown ? "100%" : "0px") width="100%" overflow-y="auto" overflow-x="hidden" box-sizing="border-box" padding-top=(shown ? 16 : 0) padding-bottom=(shown ? 16 : 0)
      for r, i in rows key=r.key
        column padding-left=(not expanded or first ? "calc(env(safe-area-inset-left) + 16px)" : "16px") padding-right=(not expanded or not first ? "calc(env(safe-area-inset-right) + 16px)" : "16px") box-sizing="border-box" width="100%" padding-top=(r.heading != "" and i > 0 ? 24 : 0)
          if r.kind == "measurement"
            row class=Card padding=16 gap=12 align-items="center" testId="scroll-measurement-row"
              text "Measure Scroll Performance" font-size=17 flex=1 min-width=0
              input type="checkbox" switch checked=scrollMeasurement change=setScrollMeasurement aria-label="Measure Scroll Performance" testId="scroll-measurement" accent-color="auto"
          else if r.kind == "message"
            column testId=`${id}-message`
              SectionFooter(words=r.name)
          else
            if r.heading != ""
              SectionHeader(title=r.heading)
            column testId=(r.id.startsWith("perf-launch-") ? `perf-launch-row-${r.name}` : `${r.id}-row`) class=Card border-radius=0 border-top-left-radius=(r.heading != "" ? 18 : 0) border-top-right-radius=(r.heading != "" ? 18 : 0) border-bottom-left-radius=(r.last ? 18 : 0) border-bottom-right-radius=(r.last ? 18 : 0) user-select=(r.report != "" ? "none" : "text") contextmenu=aimMetric(r.report) contextPopover=(r.report != "" ? "metric-menu" : "")
              if r.heading == ""
                Divider()
              MetricRow(name=r.name, route=r.route, detail=(r.at > 0 ? exactTime(r.at, utcOffset) : r.detail), value=r.value, id=r.id)
              if r.lines.length > 0
                column padding-left=16 padding-right=16 padding-bottom=12 gap=8
                  for line in r.lines key=line
                    text line font-size=13 color="-exact-secondary-label"
            if r.footer != ""
              SectionFooter(words=r.footer)

// One session log entry from app.ts: when, what, and why
shape SessionLogEvent
  at: number
  kind: string
  detail: string

// The session log, newest first, and what it says since the last sign-in
shape SessionLog
  ok: bool
  signedInAt: number
  refreshes: number
  lastRefreshAt: number
  events: SessionLogEvent[]

fn sessionLogText(log: SessionLog, utcOffset: number): string = log.events.map((e, i) => `${exactTime(e.at, utcOffset)} [${e.at} ms]  ${e.kind}: ${e.detail}`).join("\n")

// Session: the sign-in session now, and the log app.ts keeps of its refreshes,
// failures and sign-outs, so a sign-out can be explained after it. Copy Log
// hands on all of it.
component SessionScreen
  props
    log: SessionLog
    loading: bool
    signedIn: bool
    expiresAt: number
    utcOffset: number
  action copyLog
    copyText(sessionLogText(log, utcOffset))
  view
    scroll id="screen-scroll" testId="session-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%" class=SafeScroll
      SettingsColumn(id="session-column")
        column
          SectionHeader(title="Now")
          column class=Card
            FactRow(label="Signed in", value=(signedIn ? "Yes" : "No"), id="session-signed-in")
            Divider()
            FactRow(label="Access token expires", value=(signedIn ? exactTime(expiresAt, utcOffset) : "Not signed in"), id="session-expires")
            Divider()
            FactRow(label="Last sign-in", value=(log.signedInAt > 0 ? exactTime(log.signedInAt, utcOffset) : "Not logged"), id="session-signed-in-at")
            Divider()
            FactRow(label="Refreshes since", value=`${log.refreshes}`, id="session-refreshes")
            Divider()
            FactRow(label="Last refresh", value=(log.lastRefreshAt > 0 ? exactTime(log.lastRefreshAt, utcOffset) : "None"), id="session-last-refresh")
        column
          SectionHeader(title="Log")
          if not loading and log.events.length == 0
            SectionFooter(words=(log.ok ? "Nothing logged yet." : "The session log is unavailable."))
          if log.events.length > 0
            column gap=20
              column class=Card
                button press=copyLog testId="copy-session-log" text-align="left" padding=16 display="flex"
                  image "symbol:icon.doc.on.clipboard"
                  text "Copy Log" font-size=17 color="AccentColor"
              column class=Card
                for e, i in log.events key=`${e.at}-${i}`
                  column user-select="text" testId=`session-event-${i}`
                    if i > 0
                      Divider()
                    column padding=16 gap=2
                      text e.kind font-size=17
                      text e.detail font-size=13 color="-exact-secondary-label"
                      text exactTime(e.at, utcOffset) font-size=13 color="-exact-secondary-label"
          SectionFooter(words="Lexy keeps the last 200 session events and the last 100 diagnostics on this device, through sign-outs. A refresh token shows only as the first six hex digits of its SHA-256.")
