// Sign-in, vehicle state, commands, refresh, and navigation; app.ts handles I/O
use LockScreen from "./sign-in.contract"
use appVersion from "./exact-version.contract"
use StatusScreen from "./status.contract"
use SpecsScreen from "./specs.contract"
use SettingsScreen from "./settings.contract"
use MapSheet from "./map.contract"
use RenameScreen from "./settings.contract"
use Time, accent, renameFailure, routeTitle from "./model.contract"
use Account from "./model.contract"
use AuthNode from "./model.contract"
use Done from "./model.contract"
use Garage from "./model.contract"
use Status from "./model.contract"
use Tires from "./model.contract"
use Engine from "./model.contract"
use Spec from "./model.contract"
use Services from "./model.contract"
use CommandResult from "./model.contract"
use Primed from "./model.contract"
use Climate from "./model.contract"
use Address from "./model.contract"
use MapsApp from "./model.contract"
use DeveloperMode from "./model.contract"
use Page from "./model.contract"
use Viewport, foldOf from "./model.contract"
use mapsResolved from "./model.contract"
use webDirections from "./model.contract"
use Opened from "./model.contract"
use stepOf from "./model.contract"
use failureText from "./model.contract"
use otpCallback from "./model.contract"
use vehicleName from "./model.contract"
use any from "./model.contract"
use orEpoch from "./model.contract"
use UpdatesScreen from "./developer.contract"
use DataStateScreen from "./developer.contract"
use LoginPreviewScreen from "./developer.contract"
use EasScreen from "./developer.contract"
use PerformanceScreen, Observed, ObservedCleared from "./developer.contract"
use Delivery from "./developer.contract"
use signInError from "./model.contract"

routes nav
  tab status "/"
    map "/map"
  tab specs "/specs"
  tab settings "/settings"
    rename "/settings/name"
    updates "/settings/updates"
    dataState "/settings/data-state"
    login "/settings/login"
    eas "/settings/eas"
    performance "/settings/performance"
    // `lexy://developer` (app.json `protocol_handlers`), and on the web the
    // page's own `/developer`: turns developer mode on
    unlock "/developer"


component Lexy
  resource time = exactTime() as shape Time
  resource page = exactPage() as shape Page
  resource viewport = exactViewport() as shape Viewport
  derive fold = foldOf(viewport)
  derive wide = viewport.width >= 700 or fold == "across"
  state sessionRev = 0
  state sessionAt = 0
  state retried = false
  // Clear the expired-session notice when sign-in starts
  state sessionNoticeSeen = false
  resource account = session() with sessionRev, orEpoch(sessionAt, time.epochAtZero) as shape Account
  // Show the dashboard skeleton until the session resolves to avoid a sign-in flash
  derive shell = not entering and (account.signedIn or (account.status == 0 and account.error == ""))
  // Keep sign-in busy until account, garage, and status have settled
  state entering = false
  derive entered = not pending(account) and (not account.signedIn or (not pending(garage) and not pending(status)))
  task enter when entering and entered
    after(1, finishEntering)

  // --- Clock -----------------------------------------------------------------
  // Contract's performanceNow() counts from the runner's zero; the epoch is time's.
  state clock = 0
  task ticker mount
    every(5000, tick)
  // Observe visibility directly: iOS can suspend before the next tick
  task returned when page.visibilityState == "visible"
    after(1, onVisible)
  // The hero's breath: a timer only while it pulses (LLP 1092 D7).
  task pulse when pulseOn
    every(1000, pulseStep)
  task boot mount
    after(1, start)
  task climateWrite when climateUnwritten and not pending(climateSaved)
    after(1, writeClimate)

  // --- Sign-in ----------------------------------------------------------------
  state email = ""
  state password = ""
  state code = ""
  state signStep = "credentials"
  state signError = ""
  // A fresh code is on its way (resend), then that it was sent.
  state resending = false
  state signInfo = ""
  state nodeRaw = ""
  state nodeTypes = []
  state choices = []
  // Keep the server's choice prompt for methods with extra instructions
  state choicePrompt = ""
  state lastChoice = -1
  // The method's label: Resend matches by it, as the tree may reorder.
  state lastChoiceLabel = ""
  // Keep resend and method-change errors on the code screen
  state restartStage = ""
  mutation started as shape AuthNode then afterStart
  mutation named as shape AuthNode then afterName
  mutation passed as shape AuthNode then afterPassword
  mutation chose as shape AuthNode then afterChoice
  mutation verified as shape AuthNode then afterCode
  mutation finished as shape Done refreshes account then afterFinish
  mutation demo as shape Done refreshes account then afterDemo
  // Clear the persisted demo flag before sending real credentials
  mutation real as shape Done refreshes account then afterReal
  mutation left as shape Done refreshes account then afterSignOut
  // The demo's server errors (Settings → Simulate Server Errors).
  state demoFailing = false
  mutation demoFailures as shape Done
  derive signingIn = entering or pending(started) or pending(named) or pending(passed) or pending(chose) or pending(verified) or pending(finished) or pending(demo) or pending(real)

  // --- Vehicle data -------------------------------------------------------------
  state garageRev = 0
  state garageAt = 0
  state statusRev = 0
  state statusAt = 0
  state engineRev = 0
  state engineAt = 0
  state lastPrimeAt = 0
  // The last tick's wall time: a gap means the app was away (resume-refresh.ts).
  state lastTick = 0
  // The page was hidden at the last tick (exactPage's visibilityState).
  state wasHidden = false
  state primeOnLaunch = false
  // A sign-in ends as a pull does, once its car is known: the car is asked to
  // report and the status re-read, which a plain read after sign-in can miss.
  state primeOnSignIn = false
  // Back from the background, the refresh ladder waits for a fresh session:
  // a token refreshed while the reads are out asks every one of them again.
  state resumeDue = false
  // A refresh the app started on its own (launch, resume): the only kind
  // announced on screen (use-vehicle-auto-refresh.ts useIsAutoRefreshing).
  state autoRefresh = false
  // An app-started refresh still running (`updating`), and whether it has
  // run a second and a half (`waited`, sent as it starts, answers then): the
  // Status hero pulses only after that, so a quick refresh (the demo's
  // take a second) never shows it, and then for at least 600 ms (`held`),
  // so one that ends just past it never flickers it. Waits app.ts keeps, not a timer
  // here: a runner timer fires every beat it missed in the background.
  derive updating = autoRefresh and (pending(status) or pending(garage) or pending(primed))
  state updatingSlow = false
  mutation waited as shape Done then afterWait
  mutation held as shape Done
  // Finish the current pulse at full opacity after refresh, including gaps between
  // requests
  state pulseOn = false
  state pulseDim = false
  // Show the pull spinner only for requests started by that pull
  state pulling = false
  // Keep refresh inputs in `with` so cached answers retain stable identities
  resource garage = garage(account.signedIn) with account.expiresAt, garageRev, orEpoch(garageAt, time.epochAtZero) as shape Garage
  derive car = garage.car
  // Keep the accepted name until a profile read catches up
  state savedName = ""
  derive carName = savedName != "" ? savedName : vehicleName(car.nickName, car.modelName)
  // Key cached reads by VIN: the full car record can exceed 8 KB and changes with
  // profile updates
  resource status = status(car.vin) with car,statusRev, orEpoch(statusAt, time.epochAtZero) as shape Status
  resource tires = tires(car.vin) with car, statusRev, orEpoch(statusAt, time.epochAtZero) as shape Tires
  resource engine = engine(car.vin) with car, engineRev, orEpoch(engineAt, time.epochAtZero) as shape Engine
  resource spec = spec(car.vin) with car, orEpoch(garageAt, time.epochAtZero) as shape Spec
  state climateRev = 0
  resource climateRead = climate(car.vin) with car, climateRev, orEpoch(garageAt, time.epochAtZero) as shape Climate
  // Keep the last accepted climate change until the next read; roll back a failed write
  mutation climateSaved as shape Climate then afterClimateSave
  // The last change the car accepted, newer than the last read until a pull.
  state climateWritten = none
  derive climate = match climateWritten { case some(c) => c, case none => climateRead }
  // climate-card.ios.tsx: a rejected change rolls back (the re-read) and
  // says so.
  state climateError = ""
  // Keep the native switch's selection while the write is pending
  state climateWanted = false
  // Hold the selected defrost state until its write settles
  state defrostFront = false
  state defrostRear = false
  state defrostHeld = false
  state climateTouched = false
  // Serialize climate writes and send the latest displayed values next
  state climateUnwritten = false
  // Keep climate controls editable while saving
  derive shownClimateOn = climateTouched ? climateWanted : climate.on
  derive shownFront = defrostHeld ? defrostFront : climate.frontEnabled
  derive shownRear = defrostHeld ? defrostRear : climate.rearEnabled
  derive shownTemperature = tempHeld ? tempDraft : climate.temperature
  // Write a changed temperature once, on release; hold it until the car reports it
  state tempDraft = 0
  state tempHeld = false
  // A release was sent: once it and its read-back land, the car's reading
  // shows, whatever it says.
  state tempSaving = false
  // The parked street line, and the maps app the user picked.
  resource address = address(status.latitude, status.longitude) as shape Address
  // Re-probed whenever the map or Settings opens: apps come and go.
  state mapsRev = 0
  // The app last asked to open the location, for its failure's alert.
  state mapsTried = ""
  resource mapsApp = mapsApp() with mapsRev as shape MapsApp
  mutation mapsChosen as shape MapsApp refreshes mapsApp
  // Developer Tools and Try Demo show only in developer mode, on this device
  // (in this browser, on the web)
  resource developer = developerMode() as shape DeveloperMode
  // Where the mode is kept, as its footer says: in this browser on the web, or
  // in this app once it is opened from the home screen, whose storage is its
  // own; natively, on this device by the module's name.
  derive developerPlace = developer.origin != "" ? (viewport.displayMode == "standalone" ? "in this app" : "in this browser") : `on this ${developer.device != "" ? developer.device : "device"}`
  mutation developerSet as shape DeveloperMode refreshes developer
  task unlock when top(nav).name == "unlock"
    after(1, unlockDeveloper)
  mutation opened as shape Opened then afterOpen
  derive openError = match opened { case some(o) => o.error, case none => "" }
  // A haptic (src/utils/haptics.ts) where Lexy plays one.
  mutation felt as shape Opened
  state moreOpen = false
  state closuresOpen = false
  state hazardsOn = false
  resource services = services(car.vin) with car, orEpoch(garageAt, time.epochAtZero) as shape Services

  // --- Commands and their reconciliation ------------------------------------------
  // A command's acceptance is not its completion: after a lock or unlock the
  // status is re-read every tick until the doors agree, priming the car once
  // halfway, and the pending state is dropped if they never do (Lexy's
  // lock-reconcile.ts). Engine start/stop re-reads engine status four times,
  // 20 s apart (engine-status.ts).
  state lockTarget = ""
  state lockPolls = 0
  // A command that reverses one the car has not yet confirmed (Lock, then
  // Unlock before any report): the reading the app holds predates both, so
  // agreeing with it confirms nothing. Only a report newer than the one held
  // when the second command was accepted settles it.
  state lockChained = false
  // What showed before the last command was sent, put back if it is refused.
  state lockPrev = ""
  state enginePrev = ""
  state lockBaseline = 0
  state engineTarget = ""
  state enginePolls = 0
  state notice = ""
  state noticeAt = 0
  // A command that failed, as Lexy's "Command failed" alert says it.
  state commandError = ""
  mutation sent as shape CommandResult then afterCommand
  mutation primed as shape Primed then afterPrime
  derive doors = status.sections.filter(s => s.category != "Other" and s.category != "Trip Details" and s.section.includes("Door"))
  derive unlockedDoors = doors.filter(d => d.values.filter(v => v == "Unlocked").length > 0).length
  derive lockedDoors = doors.filter(d => d.values.filter(v => v == "Locked").length > 0).length
  derive doorLock = unlockedDoors > 0 ? "unlocked" : (lockedDoors > 0 ? "locked" : "unknown")
  derive lockSettled = lockTarget == doorLock and (not lockChained or status.occurredMs > lockBaseline)
  derive lockPending = lockTarget != "" and not lockSettled
  derive engineRunning = engine.status == "1"
  derive enginePending = engineTarget != "" and engineTarget != (engineRunning ? "running" : "stopped")

  // --- Developer Tools ---------------------------------------------------------------
  // This binary's delivery, and whether Check was pressed here.
  resource delivery = exactDelivery() as shape Delivery
  // This device's Observe metrics, read when Performance opens and again
  // each time (none asked before it first does).
  state observedRev = 0
  resource observed = observed(observedRev > 0 ? 200 : 0) with observedRev as shape Observed
  mutation observedCleared as shape ObservedCleared refreshes observed
  state updateChecked = false
  // Data State: the override the vehicle screens are shown, Live at launch.
  state dataState = "live"
  resource forcedGarage = debugGarage(dataState, garage) as shape Garage
  derive shownGarage = dataState == "live" ? garage : forcedGarage
  derive shownOnline = (dataState == "offline-cached" or dataState == "offline-empty") ? false : (dataState == "live" or dataState == "loading" ? page.onLine : true)
  derive forcedLoading = dataState == "loading" or dataState == "offline-empty"
  derive statusLoading = dataState == "live" ? (pending(garage) or pending(status) or not account.signedIn) : forcedLoading
  // The status answers with no car too (no VIN): that answer is not the car's.
  derive statusAnswered = status.ok or status.status != 0 or status.error != ""
  // The dashboard's first load, until both the car and its status are in: it
  // shows the skeleton and a blank title, so they arrive together.
  derive firstLoad = statusLoading and (shownGarage.car.vin == "" or not statusAnswered)
  // The Status hero (map, car, Last Parked) pulses gently while the app is
  // refreshing on its own and it has run a while. Nothing otherwise (a pull shows
  // its own spinner; a web page's load is the fetch the person asked for). Nothing before there is data, or signed out. Before
  // the first tick, the time is the launch's, so the first frame has it.
  derive heroPulsing = account.signedIn and shownGarage.car.vin != "" and updatingSlow and (updating or pending(held)) and not pulling and page.navigationType == ""
  // Login Flow: the scenario the sign-in machine plays against a mock tree
  // while its screen is open ("" is the real sign-in), and whether it ended
  // signed in.
  state previewScenario = ""
  state previewDone = false

  // --- Settings ---------------------------------------------------------------------
  state draftName = ""
  state renameError = ""
  mutation renamed as shape Done then afterRename

  action start
    // An action reads the state it started with, so this is the time
    // itself, not `clock` (still 0 here). The launch's asks need nothing
    // from here: an `…At` of 0 asks at the launch's own time (below).
    clock = time.epochAtZero + performanceNow()
    lastTick = time.epochAtZero + performanceNow()
    autoRefresh = account.signedIn and car.vin != ""
    updatingSlow = false
    if account.signedIn and car.vin != ""
      send waited = pause(1500)
    // resume-refresh.ts at launch: a kept status past fifteen minutes old
    // asks the car to report (the launch's own re-read covers the rest).
    // The first tick sends it, once the data module can.
    primeOnLaunch = account.signedIn and car.vin != "" and status.fetchedMs > 0 and time.epochAtZero + performanceNow() - status.fetchedMs >= 900000

  action afterWait
    updatingSlow = updating
    if updating
      send held = pause(600)
    if updating and not pulseOn
      pulseOn = true
      pulseDim = true
  // Dimmed: back up to opaque. Opaque: another breath while the refresh
  // runs, else the pulse ends here, where the boxes already stand.
  action pulseStep
    if pulseDim
      pulseDim = false
    else
      if heroPulsing
        pulseDim = true
      else
        pulseOn = false

  // An action reads the state it started with: `clock` below is the previous
  // tick's until this action commits, so the notice timeout reads the time
  // itself.
  action onVisible
    if lastTick > 0
      resumeDue = true
  action tick
    clock = time.epochAtZero + performanceNow()
    // A launch prime waits for a signed-in car; signed out, there is none.
    if primeOnLaunch and not account.signedIn and not pending(account)
      primeOnLaunch = false
    if savedName != "" and (car.nickName == savedName or car.vin == "")
      savedName = ""
    if autoRefresh and not (pending(status) or pending(primed) or pending(garage) or (primeOnLaunch and account.signedIn))
      autoRefresh = false
    if pulling and not (pending(primed) or pending(status) or pending(garage))
      pulling = false
    if climateTouched and not (climateUnwritten or pending(climateSaved) or pending(climateRead))
      climateTouched = false
    if defrostHeld and not (climateUnwritten or pending(climateSaved) or pending(climateRead))
      defrostHeld = false
    if tempHeld and not (climateUnwritten or pending(climateSaved) or pending(climateRead)) and (tempSaving or climate.temperature == tempDraft)
      tempHeld = false
      tempSaving = false
    // Refresh the session ahead of expiry, or once after the gateway
    // rejects a token it had not expired yet.
    if account.signedIn and not pending(account)
      // A refresh that failed (offline) is tried again after 15 s, not
      // every tick.
      if (time.epochAtZero + performanceNow() > account.expiresAt - 60000 and (account.error == "" or time.epochAtZero + performanceNow() - sessionAt > 15000)) or (garage.status == 401 and not retried)
        retried = garage.status == 401
        sessionRev = sessionRev + 1
        sessionAt = time.epochAtZero + performanceNow()
      if garage.ok
        retried = false
    if notice != "" and time.epochAtZero + performanceNow() - noticeAt > 6000
      notice = ""
    if lockTarget != "" and not pending(status) and not pending(sent)
      if lockSettled
        lockTarget = ""
      else
        // lock-reconcile.ts: quietly stood down; the pending label going
        // is the whole message.
        if lockPolls >= 10
          lockTarget = ""
        else
          lockPolls = lockPolls + 1
          statusRev = statusRev + 1
          statusAt = clock
    if engineTarget != "" and clock - engineAt >= 20000 and not pending(sent)
      if not enginePending or enginePolls >= 4
        engineTarget = ""
      else
        enginePolls = enginePolls + 1
        engineRev = engineRev + 1
        engineAt = clock
    if (primeOnLaunch) and account.signedIn and car.vin != ""
      primeOnLaunch = false
      autoRefresh = true
      updatingSlow = false
      lastPrimeAt = time.epochAtZero + performanceNow()
    // resume-refresh.ts: back from the background, data
    // under a minute old stays; older is re-read; past fifteen minutes the
    // car is asked to report first (at most every three minutes).
    if (resumeDue or (lastTick > 0 and time.epochAtZero + performanceNow() - lastTick > 15000 or wasHidden and page.visibilityState == "visible")) and not account.signedIn
      resumeDue = false
    if (resumeDue or (lastTick > 0 and time.epochAtZero + performanceNow() - lastTick > 15000 or wasHidden and page.visibilityState == "visible")) and account.signedIn and (pending(account) or time.epochAtZero + performanceNow() > account.expiresAt - 60000)
      resumeDue = true
    if (resumeDue or (lastTick > 0 and time.epochAtZero + performanceNow() - lastTick > 15000 or wasHidden and page.visibilityState == "visible")) and lockTarget == "" and account.signedIn and car.vin != "" and not pending(account) and not pending(status) and not pending(primed) and time.epochAtZero + performanceNow() <= account.expiresAt - 60000
      resumeDue = false
      if time.epochAtZero + performanceNow() - status.fetchedMs >= 900000 and time.epochAtZero + performanceNow() - lastPrimeAt > 180000
        lastPrimeAt = time.epochAtZero + performanceNow()
        autoRefresh = true
        updatingSlow = false
      else
        if time.epochAtZero + performanceNow() - status.fetchedMs >= 60000
          autoRefresh = true
          updatingSlow = false
          statusRev = statusRev + 1
          statusAt = time.epochAtZero + performanceNow()
    // Back from the background: maps apps may have come or gone.
    if lastTick > 0 and time.epochAtZero + performanceNow() - lastTick > 15000 or wasHidden and page.visibilityState == "visible"
      mapsRev = mapsRev + 1
    // Seen hidden at this tick: the next tick that sees the page again is
    // a return to the foreground, however the clock moved meanwhile (a
    // host that kept ticking in the background shows no gap).
    // One send of each, from the conditions above (LLP 1016 D5): asking
    // the car to report, and the wait before the hero pulses.
    let primeLock = lockTarget != "" and not pending(status) and not pending(sent) and not lockSettled and lockPolls == 5
    let primeLaunch = (primeOnLaunch) and account.signedIn and car.vin != ""
    let resumes = (resumeDue or (lastTick > 0 and time.epochAtZero + performanceNow() - lastTick > 15000 or wasHidden and page.visibilityState == "visible")) and lockTarget == "" and account.signedIn and car.vin != "" and not pending(account) and not pending(status) and not pending(primed) and time.epochAtZero + performanceNow() <= account.expiresAt - 60000
    let primeResume = resumes and time.epochAtZero + performanceNow() - status.fetchedMs >= 900000 and time.epochAtZero + performanceNow() - lastPrimeAt > 180000
    let rereads = resumes and time.epochAtZero + performanceNow() - status.fetchedMs >= 60000
    let primeSignIn = primeOnSignIn and car.vin != "" and not pending(garage) and not pending(primed)
    if primeSignIn
      primeOnSignIn = false
      lastPrimeAt = time.epochAtZero + performanceNow()
    if primeLock or primeLaunch or primeResume or primeSignIn
      send primed = prime(car, time.epochAtZero + performanceNow())
    if primeLaunch or rereads
      send waited = pause(1500)
    wasHidden = page.visibilityState == "hidden"
    lastTick = time.epochAtZero + performanceNow()

  // Sign-in: one press walks start → email → password, then lands on the
  // delivery-method choice or the code, as the tree decides.
  // Editing what was refused clears the refusal.
  // sign-in-screen.ios.tsx: Return on the email moves on to the password.
  action focusPassword
    focus("password")
  action setEmail(v: string)
    email = v
    signError = ""
  action setPassword(v: string)
    password = v
    signError = ""
  action setCode(v: string)
    code = v
    signError = ""
    signInfo = ""
  action signIn
    if not signingIn
      sessionNoticeSeen = true
      restartStage = ""
      resending = false
      send felt = feel("impact-light")
      if email.trim() == "" or password == ""
        signError = "Enter your email and password."
      else
        signError = ""
        lastChoice = -1
        if account.demo and previewScenario == ""
          send real = useDemo(false)
        else
          send started = authStart(previewScenario)
  action afterReal
    send started = authStart(previewScenario)
  action resend
    send felt = feel("impact-light")
    signError = ""
    code = ""
    resending = true
    restartStage = "resend"
    send started = authStart(previewScenario)
  action differentMethod
    send felt = feel("impact-light")
    signError = ""
    code = ""
    lastChoice = -1
    restartStage = "choice"
    send started = authStart(previewScenario)
  action startOver
    signStep = "credentials"
    signError = ""
    code = ""
    lastChoice = -1
  // sign-in-elements.ios.tsx NewToLexusCallout: the Lexus app's App Store page.
  action getLexusApp
    send felt = feel("impact-light")
    openURL("https://apps.apple.com/us/app/lexus/id1468484450")
  action tryDemo
    sessionNoticeSeen = true
    signError = ""
    send demo = useDemo(true)
  // The demo's password goes straight to the tree, never into the field,
  // so iOS doesn't offer to save a made-up one.
  action afterDemo
    email = "driver@example.com"
    password = ""
    send started = authStart(previewScenario)
  action afterStart
    match started
      case some(n)
        if not n.ok
          signError = signInError((restartStage != "" ? restartStage : "credentials"), n.status, n.error)
          if restartStage == ""
            signStep = "credentials"
          restartStage = ""
          resending = false
        else
          if stepOf(n.tokenId, n.types, n.asksCode) == "username"
            send named = authAnswer(previewScenario, n.raw, "NameCallback", email.trim())
          else
            signError = "Lexus sent a response Lexy couldn't understand, so sign-in stopped. Lexus may be having a temporary problem, or may have changed how sign-in works. Try again in a moment, and check for a Lexy update if it keeps happening."
            restartStage = ""
            resending = false
      case none
        signError = ""
  action afterName
    match named
      case some(n)
        if n.ok and stepOf(n.tokenId, n.types, n.asksCode) == "password"
          send passed = authAnswer(previewScenario, n.raw, "PasswordCallback", (password == "" and account.demo ? "demo" : password))
        else
          // A tree that answers but won't ask for the password refused the email.
          signError = signInError((restartStage != "" ? restartStage : "credentials"), (n.ok ? 401 : n.status), n.error)
          restartStage = ""
          resending = false
      case none
        signError = ""
  action afterPassword
    match passed
      case some(n)
        if not n.ok
          signError = signInError((restartStage != "" ? restartStage : "credentials"), n.status, n.error)
          if restartStage == ""
            signStep = "credentials"
          restartStage = ""
          resending = false
        else
          signError = ""
          // A restart that ends here (no choice to re-pick) is over.
          if stepOf(n.tokenId, n.types, n.asksCode) != "choice"
            restartStage = ""
            resending = false
          if stepOf(n.tokenId, n.types, n.asksCode) == "complete"
            send finished = authFinish(previewScenario, n.tokenId, time.epochAtZero + performanceNow())
          if stepOf(n.tokenId, n.types, n.asksCode) == "otp"
            signStep = "otp"
            nodeRaw = n.raw
            nodeTypes = n.types
            signInfo = (resending ? "Lexus sent a new code." : "")
          if stepOf(n.tokenId, n.types, n.asksCode) == "choice"
            if n.choices.length == 0
              // A choice with nothing to choose is how the tree says "no such account".
              signError = signInError((restartStage != "" ? restartStage : "credentials"), 401, "")
              if restartStage == ""
                signStep = "credentials"
              restartStage = ""
              resending = false
            else
              // Resend picks the method used last time, by its label;
              // gone from the list, the user chooses again.
              if lastChoice >= 0 and any(n.choices, lastChoiceLabel)
                send chose = authChoose(previewScenario, n.raw, match first(n.choices.map((m, i) => m == lastChoiceLabel ? i : -1).filter(i => i >= 0)) { case some(i) => i, case none => 0 })
              else
                resending = false
                restartStage = ""
                signStep = "choice"
                nodeRaw = n.raw
                choices = n.choices
                choicePrompt = match first(n.prompts) { case some(t) => t, case none => "" }
      case none
        signError = ""
  action choose(index: number)
    send felt = feel("impact-light")
    signError = ""
    lastChoice = index
    lastChoiceLabel = choices.filter((m, i) => i == index).join("")
    send chose = authChoose(previewScenario, nodeRaw, index)
  action afterChoice
    match chose
      case some(n)
        if n.ok and stepOf(n.tokenId, n.types, n.asksCode) == "otp"
          signStep = "otp"
          nodeRaw = n.raw
          nodeTypes = n.types
          signError = ""
          signInfo = (resending ? "Lexus sent a new code." : "")
          resending = false
        else
          signError = signInError(resending ? "resend" : "choice", n.status, n.error)
          resending = false
        restartStage = ""
      case none
        signError = ""
  action verify
    if not signingIn
      send felt = feel("impact-light")
      if code.trim() == ""
        signError = "Enter the code Lexus sent you."
      else
        signError = ""
        send verified = authAnswer(previewScenario, nodeRaw, otpCallback(nodeTypes), code.trim())
  action afterCode
    match verified
      case some(n)
        if not n.ok
          signError = signInError("otp", n.status, n.error)
        else
          if n.tokenId != ""
            send finished = authFinish(previewScenario, n.tokenId, time.epochAtZero + performanceNow())
          else
            // Some trees ask twice; answer the next prompt the same way.
            nodeRaw = n.raw
            nodeTypes = n.types
            signError = "Enter the new code Lexus sent you."
      case none
        signError = ""
  action afterFinish
    match finished
      case some(f)
        // A Login Flow preview ends on its own panel; the app stays as it was.
        if f.ok and previewScenario != ""
          previewDone = true
          signStep = "credentials"
          password = ""
          code = ""
        if f.ok and previewScenario == ""
          sessionNoticeSeen = false
          entering = true
          garageRev = garageRev + 1
          garageAt = time.epochAtZero + performanceNow()
          statusRev = statusRev + 1
          statusAt = time.epochAtZero + performanceNow()
          engineAt = time.epochAtZero + performanceNow()
          primeOnSignIn = true
          nav = open(nav, "/")
        if not f.ok
          signError = signInError("otp", f.status, f.error)
          signStep = "credentials"
      case none
        signError = ""
  action setDemoFailing(on: bool)
    demoFailing = on
    send demoFailures = setDemoFailures(on)
  action unlockDeveloper
    send developerSet = setDeveloperMode(true)
    // Back to Settings beneath the link's route, its tab's only screen: a
    // replace would leave a second Settings on top, with a Back to the first.
    nav = go(nav, "/settings")
  action setDeveloper(on: bool)
    send developerSet = setDeveloperMode(on)
  action signOut
    send left = signOut()
  // The dashboard has what it opens on: the sign-in screen goes, its fields
  // cleared for the next sign-in.
  action finishEntering
    if entered
      entering = false
      signStep = "credentials"
      password = ""
      code = ""
  action afterSignOut
    entering = false
    climateWritten = none
    primeOnLaunch = false
    primeOnSignIn = false
    autoRefresh = false
    signStep = "credentials"
    email = ""
    password = ""
    code = ""
    signError = ""
    lockTarget = ""
    engineTarget = ""
    garageRev = garageRev + 1
    nav = open(nav, "/")

  // Status: a pull asks the car to report and then re-reads. Lexy's
  // 3-minute window between asks (refresh-status.ts: the car's battery and
  // radio) bounds only the refreshes Lexy starts itself; a pull or the
  // Refresh button is the person asking, and always asks. A pull re-reads
  // the profile and the climate settings too (a name set in the Lexus app
  // shows).
  action pullRefresh
    pulling = true
    if car.vin != ""
      lastPrimeAt = time.epochAtZero + performanceNow()
      send primed = prime(car, time.epochAtZero + performanceNow())
    else
      statusRev = statusRev + 1
      statusAt = time.epochAtZero + performanceNow()
    garageRev = garageRev + 1
    climateRev = climateRev + 1
    climateWritten = none
  // Re-read as of now: `clock` is the last tick's, up to 5 s old, which would
  // stamp the read before the report it asked for.
  action afterPrime
    statusRev = statusRev + 1
    statusAt = time.epochAtZero + performanceNow()
  action reloadGarage
    pulling = true
    garageRev = garageRev + 1
    garageAt = clock

  // The car answering is felt either way; a refused change shows the car's
  // own settings again at once (the re-read brings them), and a saved one
  // holds until the re-read agrees (the tick lets go).
  // Only the latest change's outcome is the person's: a write that a later
  // change followed sends that change next, its own failure unsaid. The
  // latest refused shows the car's own settings again, read anew, since an
  // earlier write may have landed.
  action afterClimateSave
    match climateSaved
      case some(r)
        if r.ok
          climateWritten = some(r)
        if not climateUnwritten
          climateError = (r.ok ? "" : "Lexus didn't accept the new climate settings, so they weren't saved, and your vehicle's current settings are shown again. Try the change again in a moment.")
          send felt = feel(r.ok ? "success" : "error")
          if not r.ok
            showModal("climate-failed")
            climateWritten = none
            climateRev = climateRev + 1
            defrostHeld = false
            climateTouched = false
            tempHeld = false
            tempSaving = false
      case none
        climateError = ""
        climateUnwritten = false
        defrostHeld = false
  // vehicle-controls.ios.tsx: a medium impact on sending, then success or
  // error when the car answers.
  // The pending word shows the moment the command is sent (Locking…,
  // Starting…): the app is trying to, and says so; a refused command puts
  // back what was showing.
  action run(command: string)
    notice = ""
    noticeAt = clock
    send felt = feel("impact-medium")
    if command == "door-lock" or command == "door-unlock"
      lockPrev = lockTarget
      lockTarget = (command == "door-lock" ? "locked" : "unlocked")
      lockPolls = 0
      // `lockPending` reads as it was before this action: a command the
      // car had not yet confirmed is still standing.
      lockChained = lockPending
      lockBaseline = status.occurredMs
    if command == "engine-start" or command == "engine-stop"
      enginePrev = engineTarget
      engineTarget = (command == "engine-start" ? "running" : "stopped")
      enginePolls = 0
      engineAt = time.epochAtZero + performanceNow()
    send sent = command(car, command, time.epochAtZero + performanceNow())
  action afterCommand
    match sent
      case some(c)
        noticeAt = clock
        send felt = feel((c.ok and c.returnCode == "000000") ? "success" : "error")
        if c.ok and c.returnCode == "000000"
          // Re-read as of now: `clock` is the last tick's, up to 5 s old.
          statusRev = statusRev + 1
          statusAt = time.epochAtZero + performanceNow()
          if c.command == "door-lock" or c.command == "door-unlock"
            lockPolls = 0
          if c.command == "hazard-on" or c.command == "hazard-off"
            hazardsOn = c.command == "hazard-on"
          if c.command == "engine-start" or c.command == "engine-stop"
            enginePolls = 0
            engineAt = time.epochAtZero + performanceNow()
        else
          if c.command == "door-lock" or c.command == "door-unlock"
            lockTarget = lockPrev
          if c.command == "engine-start" or c.command == "engine-stop"
            engineTarget = enginePrev
          commandError = (c.ok ? "Lexus sent the command, but your vehicle didn't carry it out. It may have weak cellular reception where it's parked. Try again in a minute." : failureText(c.status, c.error))
          showModal("command-failed")
      case none
        notice = ""
  action openMap
    opened = none
    mapsRev = mapsRev + 1
    send felt = feel("selection")
    nav = push(nav, "/map")
  // The saved or only app opens as it is; a pick from the chooser is
  // remembered (use-maps-provider.ts: never the lone app, so a second app
  // installed later asks). On the web, where no app opens, its site does.
  action openIn(provider: string)
    mapsTried = provider
    if developer.origin != ""
      openURL(webDirections(provider, status.latitude, status.longitude))
    else
      send opened = openMaps(provider, status.latitude, status.longitude, carName)
  // use-maps-provider.ts: a link the app didn't answer is an alert.
  action afterOpen
    if openError != ""
      showModal("open-failed")
  action pickAndOpen(provider: string)
    openIn(provider)
    send mapsChosen = setMapsApp(provider)
  action chooseMaps(provider: string)
    send mapsChosen = setMapsApp(provider)
  action manageSubscriptions
    send felt = feel("impact-light")
    // lexus-app.ts: the Lexus app's universal link, its App Store page
    // when it is not installed.
    openURL("https://ctlexusapp.com/shop")
  action toggleMore
    moreOpen = not moreOpen
  action toggleClosures
    closuresOpen = not closuresOpen
  action setClimateOn(on: bool)
    climateWanted = on
    climateTouched = true
    climateUnwritten = true
  action dragTemperature(value: number)
    tempDraft = value
    tempHeld = true
    tempSaving = false
  action setTemperature(value: number)
    tempDraft = value
    if value == climate.temperature
      tempHeld = false
    else
      tempHeld = true
      tempSaving = true
      climateUnwritten = true
  action writeClimate
    climateUnwritten = false
    send climateSaved = setClimate(car, climate.raw, shownClimateOn, shownTemperature, shownFront, shownRear, time.epochAtZero + performanceNow())
  action toggleDefrost(which: string)
    send felt = feel("selection")
    defrostFront = (which == "front" ? not shownFront : shownFront)
    defrostRear = (which == "rear" ? not shownRear : shownRear)
    defrostHeld = true
    climateUnwritten = true

  // Performance's Clear: hides what is recorded so far (Observe still sends it).
  action clearObserved()
    send observedCleared = clearObserved()

  // Developer Tools
  action openDevTool(url: string)
    if url == "/settings/performance"
      observedRev = observedRev + 1
    if url == "/settings/login"
      previewScenario = "success-multi"
      previewDone = false
      signStep = "credentials"
      email = ""
      password = ""
      code = ""
      signError = ""
      signInfo = ""
      lastChoice = -1
    nav = push(nav, url)
  action checkUpdate
    updateChecked = true
    deliveryCheck()
  action applyUpdate
    deliveryActivate()
  action chooseDataState(kind: string)
    dataState = kind
  action clearMaps
    send mapsChosen = setMapsApp("")
  action chooseScenario(id: string)
    previewScenario = id
    previewDone = false
    signStep = "credentials"
    code = ""
    signError = ""
    signInfo = ""
    lastChoice = -1
  action runPreviewAgain
    previewDone = false
    signStep = "credentials"
    password = ""
    code = ""
    signError = ""
    signInfo = ""
    lastChoice = -1
  // The Login Flow's back: the real sign-in owns the machine again.
  action leavePreview
    previewScenario = ""
    previewDone = false
    signStep = "credentials"
    email = ""
    password = ""
    code = ""
    signError = ""
    signInfo = ""
    lastChoice = -1
    nav = back(nav)
  action openExternal(url: string)
    openURL(url)

  // Navigation
  action selectTab(name: string)
    nav = select(nav, name)
    if name == "settings"
      mapsRev = mapsRev + 1
  // The platform's Back (its button, the swipe, a sheet pulled down)
  // leaving the Login Flow preview resets it, as its own back does.
  action back
    if top(nav).name == "login"
      previewScenario = ""
      previewDone = false
      signStep = "credentials"
      email = ""
      password = ""
      code = ""
      signError = ""
      signInfo = ""
      lastChoice = -1
    nav = back(nav)
  action followLink(url: string)
    nav = go(nav, url)
  action editName
    // vehicle-mapping.ts: no nickname reads as the model's name.
    draftName = carName
    renameError = ""
    nav = push(nav, "/settings/name")
  action setDraftName(v: string)
    draftName = v
    renameError = ""
  // vehicle-name-screen.ios.tsx: clearing keeps the field focused.
  action clearDraftName
    draftName = ""
    focus("name-input")
  // vehicle-name-screen.ios.tsx: only a real change, and not twice.
  action saveName
    if draftName.trim() != "" and draftName.trim() != carName and not pending(renamed)
      send renamed = rename(car, draftName.trim(), time.epochAtZero + performanceNow())
  action afterRename
    match renamed
      case some(r)
        if r.ok
          send felt = feel("success")
          savedName = draftName.trim()
          garageRev = garageRev + 1
          garageAt = clock
          nav = back(nav)
        else
          send felt = feel("error")
          renameError = renameFailure(r.status, r.error)
      case none
        renameError = ""

  view
    main testId="lexy" display="flex" flex-direction="column" navigationKey=(shell ? `${top(nav).id}` : "sign-in") navigationBack="back" navigate=followLink width="100%" height="100%" background-color="-exact-grouped-background" color="-exact-label" accent-color=accent()
      if not shell
        LockScreen(developer=developer.on, step=signStep, email=email, password=password, code=code, error=(signError != "" or sessionNoticeSeen or account.status != 401 or account.error == "" ? signError : "You've been signed out because Lexus no longer accepts the app's saved session. This happens after a password change, or when Lexus expires it on their end. Sign in again to reconnect your vehicle."), busy=signingIn, resending=resending, info=signInfo, choices=choices, prompt=choicePrompt, setEmail=setEmail, setPassword=setPassword, setCode=setCode, signIn=signIn, choose=choose, verify=verify, resend=resend, differentMethod=differentMethod, tryDemo=tryDemo, getLexusApp=getLexusApp, nextField=focusPassword, preview=false, fold=fold, banner="", bannerSymbol="", method=(lastChoice >= 0 ? choices.filter((m, i) => i == lastChoice).join("") : ""))
      else
        // Each tab keeps its own stack; route headers supply UIKit's title and bar
        // items
        column flex=1 min-height=0 position="relative"
          for t in nav.tabs key=t.name
            column role="tabpanel" id=`panel-${t.name}` position="absolute" top=0 right=0 bottom=0 left=0
              for e in t.stack key=e.id
                column navigationKey=`${e.id}` navigationScroll=(e.name == "login" or e.name == "map" ? "" : "screen-scroll") navigationPresentation=(e.name == "map" ? "modal" : "") navigationDetent=(e.name == "map" ? "medium large" : "") navigationInitialDetent=(e.name == "map" ? "large" : "") testId=`screen-${e.name}` position="absolute" top=0 right=0 bottom=0 left=0 background-color="-exact-grouped-background" display="flex" flex-direction="column"
                  header display="flex" flex-direction="row" align-items="center" gap=8 padding-left=16 padding-right=16 padding-top=(e.name == "map" ? "8px" : "env(safe-area-inset-top)") padding-bottom=8 flex-shrink=0
                    if e.name != "status" and e.name != "specs" and e.name != "settings" and e.name != "map"
                      button id="back" press=back testId="back" aria-label="Back" width=44 height=44
                    column flex=1 min-width=0
                      text (e.name == "status" ? (firstLoad and shownOnline ? " " : (shownGarage.car.vin == "" ? "My Vehicle" : (savedName != "" ? savedName : vehicleName(shownGarage.car.nickName, shownGarage.car.modelName)))) : routeTitle(e.name)) role="heading" aria-level=(e.name == "map" or e.name == "login" ? 2 : 1) font-size=(e.name == "map" or e.name == "login" ? "17px" : "-exact-title1") font-weight=700 color="-exact-label"
                    if e.name == "map"
                      button press=back testId="close-map" aria-label="Close" width=44 height=44 display="flex" align-items="center" justify-content="center"
                        image "symbol:icon.xmark"
                    if e.name == "performance"
                      button press=clearObserved testId="clear-performance" disabled=pending(observedCleared)
                        text "Clear" font-size=17
                    if e.name == "login"
                      button popovertarget="scenario-chooser" testId="scenario" aria-label="Preview Scenario" width=44 height=44 display="flex" align-items="center" justify-content="center"
                        image "symbol:icon.wrench.and.screwdriver"
                  if e.name == "status"
                    StatusScreen(garage=shownGarage, status=status, tires=tires, climate=climate, engineRunning=engineRunning, enginePending=enginePending, engineTarget=engineTarget, lockPending=lockPending, lockTarget=lockTarget, doorLock=doorLock, hazardsOn=hazardsOn, busy=pending(sent), refreshing=(pulling and (pending(primed) or pending(status) or pending(garage))), heroDim=pulseDim, loading=statusLoading, firstLoad=firstLoad, notice=notice, clock=clock, checkedAt=status.fetchedMs, moreOpen=moreOpen, closuresOpen=closuresOpen, online=shownOnline, utcOffset=time.utcOffset, climateLoading=(pending(climateRead) and car.vin != ""), climateWriting=(climateUnwritten or pending(climateSaved)), temperature=(tempHeld ? tempDraft : climate.temperature), dragTemperature=dragTemperature, climateWanted=(climateTouched ? climateWanted : climate.on), frontDefrost=(defrostHeld ? defrostFront : climate.frontEnabled), rearDefrost=(defrostHeld ? defrostRear : climate.rearEnabled), reload=pullRefresh, run=run, openMap=openMap, toggleMore=toggleMore, wide=wide, fold=fold, toggleClosures=toggleClosures, setClimateOn=setClimateOn, setTemperature=setTemperature, toggleDefrost=toggleDefrost, commandError=commandError, climateError=climateError, engineKnown=engine.ok)
                  if e.name == "map"
                    MapSheet(status=status, name=carName, address=address.line, clock=clock, provider=mapsResolved(mapsApp), apps=mapsApp, opening=pending(opened), error=openError, open=openIn, pick=pickAndOpen, tried=mapsTried, close=back)
                  if e.name == "specs"
                    SpecsScreen(garage=shownGarage, spec=spec, services=services, utcOffset=time.utcOffset, reload=reloadGarage, refreshing=(pulling and pending(garage)), loading=(dataState == "live" ? (pending(garage) or not account.signedIn) : forcedLoading), online=shownOnline, manage=manageSubscriptions, wide=wide, fold=fold)
                  if e.name == "settings"
                    SettingsScreen(developer=developer.on, developerOrigin=developer.origin, developerPlace=developerPlace, setDeveloper=setDeveloper, openDevTool=openDevTool, car=car, name=carName, demo=account.demo, demoFailing=demoFailing, setDemoFailing=setDemoFailing, provider=mapsApp.provider, apps=mapsApp, version=appVersion(), editName=editName, chooseMaps=chooseMaps, signOut=signOut, signingOut=pending(left), fold=fold)
                  if e.name == "updates"
                    UpdatesScreen(delivery=delivery, version=appVersion(), checked=updateChecked, check=checkUpdate, apply=applyUpdate)
                  if e.name == "dataState"
                    DataStateScreen(current=dataState, choose=chooseDataState, apps=mapsApp, provider=mapsApp.provider, clearMaps=clearMaps)
                  if e.name == "login"
                    LoginPreviewScreen(scenario=previewScenario, done=previewDone, chooseScenario=chooseScenario, runAgain=runPreviewAgain, step=signStep, email=email, password=password, code=code, error=signError, busy=signingIn, resending=resending, info=signInfo, choices=choices, prompt=choicePrompt, method=(lastChoice >= 0 ? choices.filter((m, i) => i == lastChoice).join("") : ""), setEmail=setEmail, setPassword=setPassword, setCode=setCode, signIn=signIn, choose=choose, verify=verify, resend=resend, differentMethod=differentMethod, getLexusApp=getLexusApp, nextField=focusPassword)
                  if e.name == "eas"
                    EasScreen(open=openExternal)
                  if e.name == "performance"
                    PerformanceScreen(observed=observed, utcOffset=time.utcOffset)
                  if e.name == "rename"
                    RenameScreen(name=draftName, saved=carName, saving=pending(renamed), error=renameError, setName=setDraftName, clear=clearDraftName, save=saveName, back=back)

        row role="tablist" aria-label="Tabs"
          for t in nav.tabs key=t.name
            button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=selectTab(t.name) testId=`tab-${t.name}` flex=1
              image (t.name == "status" ? "symbol:icon.car" : (t.name == "specs" ? "symbol:icon.list.bullet.rectangle" : "symbol:icon.gearshape"))
              text (t.name == "status" ? "Status" : (t.name == "specs" ? "Specs" : "Settings"))
