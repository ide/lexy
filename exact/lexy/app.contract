                      button id="back" press=back testId="back" aria-label="Back" disabled=((e.name == "loginChoice" or e.name == "loginCode") and signingIn) width=44 height=44
                    text (e.name == "status" ? statusTitle : routeTitle(e.name)) role="heading" aria-level=1 color=(e.name == "status" and firstLoad ? "transparent" : none)
                    if e.name == "map"
