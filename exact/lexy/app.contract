              column navigationKey=`${e.id}` data-screen=e.name navigationBar=(shell or e.name == "authChoice" or e.name == "authCode" ? "auto" : "none") navigationScroll=(not shell ? "sign-in-scroll" : ((e.name == "updates" or e.name == "performance") and (fold == "across" or (wide and fold != "down")) ? "developer-first-scroll" : (e.name == "map" ? "" : (e.name == "login" or e.name == "loginChoice" or e.name == "loginCode" ? "sign-in-scroll" : "screen-scroll")))) navigationPresentation=(e.name == "map" ? "modal" : "") navigationDetent=(e.name == "map" ? "medium large" : "") navigationInitialDetent=(e.name == "map" ? "large" : "") testId=`screen-${e.name}` position="absolute" top=0 right=0 bottom=0 left=0 background-color="-exact-grouped-background" display="flex" flex-direction="column"
