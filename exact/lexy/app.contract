                  if e.name == "authChoice" or e.name == "authCode"
                    header
                      button id="back" press=back aria-label="Back" testId="auth-back" disabled=signingIn width=44 height=44
                      text "Sign In" role="heading" aria-level=1
                  LockScreen(compact=(viewport.height < 600), developer=developer.on, step=(e.name == "authCode" ? "otp" : (e.name == "authChoice" ? "choice" : "credentials")), email=email, password=password, code=code, error=(signError != "" or sessionNoticeSeen or account.error == "" ? signError : "Lexus no longer accepts the saved session. Sign in again to reconnect your vehicle."), busy=signingIn, info=signInfo, choices=choices, prompt=choicePrompt, setEmail=setEmail, setPassword=setPassword, setCode=setCode, signIn=signIn, choose=choose, verify=verify, resend=resend, tryDemo=tryDemo, getLexusApp=getLexusApp, nextField=focusPassword, embedded=(e.name == "authChoice" or e.name == "authCode"), fold=fold, banner="", bannerSymbol="", method=(lastChoice >= 0 ? choices.filter((m, i) => i == lastChoice).join("") : ""))
                else
