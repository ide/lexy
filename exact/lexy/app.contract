                    LoginPreviewScreen(fold=fold, compact=(viewport.height < 600), scenario=previewScenario, done=previewDone, runAgain=runPreviewAgain, step=(e.name == "loginCode" ? "otp" : (e.name == "loginChoice" ? "choice" : "credentials")), email=email, password=password, code=code, error=signError, busy=signingIn, info=signInfo, choices=choices, prompt=choicePrompt, method=(lastChoice >= 0 ? choices.filter((m, i) => i == lastChoice).join("") : ""), setEmail=setEmail, setPassword=setPassword, setCode=setCode, signIn=signIn, choose=choose, verify=verify, resend=resend, getLexusApp=getLexusApp, nextField=focusPassword)
                  if e.name == "eas"
                    EasScreen(open=openExternal)
                  if e.name == "performance"
                    PerformanceScreen(wide=wide, fold=fold, observed=observed, utcOffset=time.utcOffset)
                  if e.name == "session"
                    SessionScreen(log=sessionLog, loading=pending(sessionLog), signedIn=account.signedIn, expiresAt=account.expiresAt, utcOffset=time.utcOffset)
                  if e.name == "rename"
                    RenameScreen(fold=fold, name=draftName, saved=carName, saving=pending(renamed), error=renameError, setName=setDraftName, clear=clearDraftName, save=saveName, back=back)

      row role="tablist" aria-label="Tabs" display=(shell ? "flex" : "none")
        for t in nav.tabs key=t.name
          button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=selectTab(t.name) testId=`tab-${t.name}` flex=1
            image (t.name == "status" ? "symbol:icon.car" : (t.name == "specs" ? "symbol:icon.list.bullet.rectangle" : "symbol:icon.gearshape"))
            text (t.name == "status" ? "Status" : (t.name == "specs" ? "Specs" : "Settings"))

      if previewScenario != ""
        LoginScenarioChooser(chooseScenario=chooseScenario)
