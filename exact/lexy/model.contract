// Data shapes and pure display rules; app.ts decodes the API replies

// Lexy's loading indicators (the skeletons' pulse, the fuel bar's)
// keep one rhythm wherever they show (LLP 1055.002).
timeline Activity

// The device's page facts (Exact's exactPage): online as navigator.onLine.
shape Page
  visibilityState: string
  onLine: bool
  canShare: bool
  // How the browser loaded the page (Navigation Timing's type: navigate,
  // reload, back_forward); "" in the native app. A page's load is the
  // fetch the person asked for, so it announces nothing.
  navigationType: string

// The viewport's fold (Exact's exactViewport, the web's device-posture
// and viewport segments: LLP 1078).
shape Viewport
  height: number
  displayMode: string
  width: number
  horizontalViewportSegments: number
  verticalViewportSegments: number

// Keep single-column forms readable on wide displays
fn readableWidth(): string = "672px"

// Distinguish side-by-side segments ("across") from stacked segments ("down")
fn foldOf(v: Viewport): string = v.horizontalViewportSegments == 2 ? "across" : (v.verticalViewportSegments == 2 ? "down" : "")

shape Time
  epochAtZero: number
  utcOffset: number

// Refresh tokens through one session source so concurrent reads share the refresh
shape Account
  signedIn: bool
  demo: bool
  expiresAt: number
  status: number
  error: string

// One step of Lexus's ForgeRock sign-in tree. `raw` is the node verbatim, for
// answering; the rest is it decoded, for deciding what the step is.
shape AuthNode
  attempt: number
  ok: bool
  status: number
  error: string
  raw: string
  tokenId: string
  types: string[]
  prompts: string[]
  // The prompts name a code (lexus-auth.ts's test, matched in the source).
  asksCode: bool
  choices: string[]

shape AuthDone
  attempt: number
  ok: bool
  status: number
  error: string

shape Done
  ok: bool
  status: number
  error: string

// A vehicle from discovery, plus the remote-capability flags that are on.
shape Car
  vin: string
  brand: string
  generation: string
  region: string
  asiCode: string
  hwType: string
  nickName: string
  modelName: string
  modelYear: string
  description: string
  color: string
  image: string
  fuelType: string
  grade: string
  modelCode: string
  capabilities: string[]

shape Garage
  ok: bool
  status: number
  error: string
  car: Car
  carCount: number

// One section of the status snapshot's vehicleStatus tree ("Driver Side" /
// "Rear Door" / ["Closed", "Locked"]).
shape Section
  category: string
  section: string
  values: string[]
  // Time of this section's oldest displayed reading
  at: number

shape Status
  ok: bool
  status: number
  error: string
  occurredMs: number
  // Request time used to age cached data
  fetchedMs: number
  fuel: number
  range: number
  rangeUnit: string
  odometer: number
  odometerUnit: string
  caution: number
  latitude: number
  longitude: number
  tripA: number
  tripB: number
  sections: Section[]
  // The oldest doors-and-windows reading older than this snapshot, or 0.
  closuresStaleMs: number

shape Tire
  position: string
  value: number
  low: bool

shape Tires
  ok: bool
  status: string
  unit: string
  tires: Tire[]

shape Engine
  fetchedMs: number
  ok: bool
  status: string
  startedMs: number
  timer: number

shape SpecItem
  name: string
  value: string

shape Spec
  ok: bool
  items: SpecItem[]

shape Service
  bucket: string
  name: string
  status: string
  endMs: number

shape Services
  ok: bool
  items: Service[]

shape CommandResult
  ok: bool
  status: number
  error: string
  command: string
  returnCode: string
  at: number

// Remote-start climate (src/data/climate-settings.ts); `raw` is the wire object
// a change is written back into.
shape Climate
  ok: bool
  raw: string
  on: bool
  temperature: number
  unit: string
  min: number
  max: number
  step: number
  front: bool
  frontEnabled: bool
  rear: bool
  rearEnabled: bool

shape Address
  line: string

// Whether this device (on the web, this browser) shows Developer Tools and
// Try Demo: on after a `lexy://developer` link, off from Developer Tools' own
// switch.
shape DeveloperMode
  on: bool
  // The page's origin on the web, whose `/developer` is that link there; ""
  // in the native app.
  origin: string
  // What the app calls the device it runs on ("iPhone", "iPad", "Mac"), from
  // Lexy's module; "iPhone" from an older build's module, which has no
  // `device`; "" on the web, and where there is no module.
  device: string

// The saved maps app (empty when unset, or when it was deleted) and which of
// the three the device has (on the web, all three, as their sites).
shape MapsApp
  provider: string
  apple: bool
  google: bool
  waze: bool

shape Opened
  ok: bool
  error: string

shape Primed
  ok: bool
  status: number
  error: string
  at: number

// --- Sign-in (src/auth/lexus-auth.ts classifyAuthenticationNode) ---------------

fn any(values: string[], value: string): bool = values.filter(v => v == value).length > 0

// Whether the prompts name a code is decided in the source, with Lexy's own
// case-insensitive test (/\botp\b|one[ -]?time password|verification code/i):
// Contract has no regex or case folding, and a hand-listed set of casings
// missed ForgeRock's "One Time Password", so choosing email or SMS read the
// code step as a password step and failed.
fn stepOf(tokenId: string, types: string[], asksCode: bool): string = tokenId != "" ? "complete" : (any(types, "NameCallback") ? "username" : (asksCode ? "otp" : (any(types, "PasswordCallback") ? "password" : (any(types, "TextInputCallback") ? "otp" : "choice"))))

fn otpCallback(types: string[]): string = any(types, "TextInputCallback") ? "TextInputCallback" : "PasswordCallback"

// src/auth/sign-in-error.ts: what happened, why, and what to do next, by
// the step that failed (credentials, choice, otp, resend).
fn retryAction(stage: string): string = (
  stage == "choice" ? "choose your verification method again" :
  stage == "otp" ? "tap Verify again" :
  stage == "resend" ? "request a code again" :
  "tap Sign In again"
)
fn rejectedText(stage: string): string = (
  stage == "otp" ? "Lexus didn't accept that code. It may have expired or already been used. Tap Resend Code and enter the new code." :
  stage == "choice" ? "Lexus couldn't send a code by that method. Try another method, or update your contact details in the Lexus app." :
  stage == "resend" ? "Lexus refused another code. Too many may have been requested. Wait a few minutes, then tap Resend Code." :
  stage == "session" ? "Lexus couldn't finish signing you in. Tap Sign In to try again." :
  "Lexus didn't accept that email and password. Check both fields; passwords are case-sensitive. If it still fails, reset your password or check for an account lock in the Lexus app."
)
fn signInError(stage: string, status: number): string = (
  status == 0 ? `Couldn't reach Lexus. Check Wi-Fi or cellular, then ${retryAction(stage)}.` :
  status == 429 ? `Lexus is limiting sign-in attempts. Wait a few minutes, then ${retryAction(stage)}.` :
  status >= 500 ? `The Lexus sign-in service is having trouble. Wait a moment, then ${retryAction(stage)}.` :
  status >= 400 ? rejectedText(stage) :
  "Lexus sent an unexpected sign-in response. Try Sign In again. If this keeps happening, check for a Lexy update."
)

// load-error.ts classifyFailure / describeFailure: what kind of failure a
// read was, then a short summary (the "Couldn't refresh" banner) or the
// cause and what to do (the full-screen error).
fn failureKind(status: number, error: string): string = status == 401 and error.includes("expired") ? "session" : (status == 401 or status == 403 ? "permission" : (status >= 500 ? "server" : (status >= 400 ? "client" : (status == 0 and (error.includes("etwork") or error.includes("offline") or error.includes("onnection") or error.includes("nternet") or error.includes("timed out") or error.includes("Couldn’t reach")) ? "network" : "unknown"))))
fn failureSummary(status: number, error: string): string = summaryOf(failureKind(status, error))
fn summaryOf(kind: string): string = (
  kind == "permission" ? "Lexus didn't let Lexy read your vehicle." :
  kind == "server" ? "The Lexus service had a problem on its end." :
  kind == "client" ? "Lexus didn't accept Lexy's request." :
  kind == "network" ? "Lexy couldn't connect to Lexus." :
  kind == "session" ? "Your Lexus sign-in expired." :
  "Something unexpected went wrong."
)
fn failureAdvice(status: number, error: string): string = adviceOf(failureKind(status, error))
fn adviceOf(kind: string): string = (
  kind == "permission" ? "Lexus didn't let Lexy read your vehicle's data. Your saved sign-in may no longer have access, for example if the vehicle was removed from your Lexus account. Sign out and sign back in; if the vehicle still doesn't appear, check that it's listed in the Lexus app." :
  kind == "server" ? "The Lexus service had a problem on its end, not something you did. It usually recovers within a few minutes. Try again shortly." :
  kind == "client" ? "Lexus didn't accept Lexy's request. Lexus may have changed how its service works. Try again, and check for a Lexy update if it keeps happening." :
  kind == "network" ? "Lexy couldn't connect to Lexus. Your device may be offline or on a weak connection. Check Wi-Fi or cellular data, then try again." :
  kind == "session" ? "Your Lexus sign-in expired. Lexus ends sign-ins after a while, and when your password changes. Sign in again to see your vehicle." :
  "Something unexpected went wrong while loading your vehicle, and Lexy couldn't tell why. Try again; if it keeps happening, restart Lexy."
)
fn failureText(status: number, error: string): string = status == 0 ? "Lexy couldn't reach Lexus. Your device may be offline, or the connection dropped. Check Wi-Fi or cellular data, then try again." : (status >= 500 ? "The Lexus service had a problem on its end, not something you did. Try again in a few minutes." : `Lexus didn't accept the request. Its service may be busy, or your sign-in may need refreshing. Try again; if it keeps happening, sign out and sign back in. (Lexus error ${status}${error != "" ? `: ${error}` : ""})`)
// A rename Lexus refuses (400) is the name it won't store; anything else is the usual failure
fn renameFailure(status: number, error: string): string = status == 400 ? "Lexus didn't accept that name and didn't say why. Try a shorter name using only letters, numbers and spaces." : failureText(status, error)

// --- Vehicle --------------------------------------------------------------------

fn vehicleName(nick: string, model: string): string = nick != "" ? nick : (model != "" ? model : "My Vehicle")

fn routeTitle(route: string): string = (
  route == "specs" ? "Specs" :
  route == "settings" ? "Settings" :
  route == "rename" ? "Vehicle Name" :
  route == "map" ? "Last Parked" :
  route == "updates" ? "Updates" :
  route == "dataState" ? "Data State" :
  route == "login" or route == "loginCode" ? "Login Flow" :
  route == "eas" ? "EAS" :
  route == "performance" ? "Performance" :
  ""
)

fn can(capabilities: string[], flag: string): bool = any(capabilities, flag)

// src/data/vehicle-mapping.ts FUEL_TYPES and HEAD_UNITS.
fn fuelName(code: string): string = code == "G" ? "Gasoline" : (code == "H" ? "Hybrid" : (code == "E" ? "Electric" : ((code == "P" or code == "L") ? "Plug-in Hybrid" : (code == "F" ? "Fuel Cell" : (code == "" ? "Gasoline" : code)))))
fn headUnit(generation: string): string = (
  generation == "21MM" ? "Lexus Multimedia (21MM)" :
  generation == "24MM" ? "Lexus Interface (24MM)" :
  generation
)

// --- Closures (src/data/closures.ts, closure-display.ts) -------------------------

fn isCorner(s: Section): bool = s.category != "Other" and s.category != "Trip Details" and (s.section.includes("Door") or s.section.includes("Window"))
fn cornerOf(s: Section): string = `${s.section.includes("Rear") ? "rear" : "front"}-${s.category.includes("Passenger") ? "passenger" : "driver"}`
fn partOf(s: Section): string = s.section.includes("Door") ? "door" : "window"
fn closureName(s: Section): string = isCorner(s) ? `${s.section.includes("Rear") ? "Rear" : "Front"} ${s.category.includes("Passenger") ? "passenger" : "driver"} ${partOf(s)}` : s.section
// An opening's name inside a sentence ("Windows and trunk closed").
fn lowerName(name: string): string = name.includes("Moon") ? "moonroof" : (name.includes("Trunk") ? "trunk" : (name.includes("Hood") ? "hood" : (name.includes("Hatch") ? "hatch" : name)))
fn isOpen(s: Section): bool = any(s.values, "Open")
fn isUnlocked(s: Section): bool = any(s.values, "Unlocked")
// A section says something when it reports a position, a lock, or both; a
// sparse snapshot after a drive often reports only the lock.
fn reports(s: Section): bool = any(s.values, "Open") or any(s.values, "Closed") or any(s.values, "Locked") or any(s.values, "Unlocked")

// --- Formatting -------------------------------------------------------------------

fn round(n: number): number = floor(n + 0.5)
// A read's time: when the app last asked, else the epoch (the launch's).
fn orEpoch(at: number, epoch: number): number = at == 0 ? epoch : at
fn pad3(r: number): string = r < 10 ? `00${r}` : (r < 100 ? `0${r}` : `${r}`)
// 12,482 — Contract's formatNumber only has "compact".
fn grouped(n: number): string = round(n) < 1000 ? `${round(n)}` : (round(n) < 1000000 ? `${floor(round(n) / 1000)},${pad3(round(n) % 1000)}` : `${floor(round(n) / 1000000)},${pad3(floor(round(n) / 1000) % 1000)},${pad3(round(n) % 1000)}`)
// time.ts absoluteLocalTime: "Oct 1, 2026 at 9:41 PM" (offset in minutes).
fn clockTime(ms: number, offset: number): string = `${floor(((ms + offset * 60000) % 86400000) / 3600000) % 12 == 0 ? 12 : floor(((ms + offset * 60000) % 86400000) / 3600000) % 12}:${floor((((ms + offset * 60000) % 3600000) / 60000)) < 10 ? "0" : ""}${floor((((ms + offset * 60000) % 3600000) / 60000))} ${floor(((ms + offset * 60000) % 86400000) / 3600000) < 12 ? "AM" : "PM"}`
fn exactTime(ms: number, offset: number): string = ms <= 0 ? "Unknown time" : `${formatDate(ms, offset, "medium")} at ${clockTime(ms, offset)}`
// toLocaleString with at most one decimal (odometer-card.tsx): "1,272.1", "980".
fn tenths(n: number): string = floor(n * 10 + 0.5) % 10 == 0 ? grouped(floor(n * 10 + 0.5) / 10) : `${grouped(floor(floor(n * 10 + 0.5) / 10))}.${floor(n * 10 + 0.5) % 10}`
fn distanceUnit(wire: string): string = (wire.includes("K") or wire.includes("k")) ? "km" : "mi"
fn ago(now: number, then: number, utcOffset: number): string = then <= 0 ? "never" : (now - then < 60000 ? "just now" : (now - then < 3600000 ? `${floor((now - then) / 60000)} min ago` : (now - then < 86400000 ? `${floor((now - then) / 3600000)} hr ago` : formatDate(then, utcOffset, "medium"))))
fn tireLabel(position: string): string = position == "flTirePressure" ? "Front left" : (position == "frTirePressure" ? "Front right" : (position == "rlTirePressure" ? "Rear left" : "Rear right"))

// --- Lexy's wording (src/data/time.ts, fuel.ts, remote-capabilities.ts) ----------

fn plural(n: number, unit: string): string = n == 1 ? `1 ${unit}` : `${n} ${unit}s`
// "just now", "40 seconds ago", "5 minutes ago", "2 hours 5 minutes ago", "3 days 4 hours ago"
fn relative(now: number, then: number): string = then <= 0 ? "unknown" : (now - then < 5000 ? "just now" : (now - then < 60000 ? `${plural(floor((now - then) / 1000), "second")} ago` : (now - then < 3600000 ? `${plural(floor((now - then) / 60000), "minute")} ago` : (now - then < 86400000 ? (floor((now - then) / 60000) % 60 == 0 ? `${plural(floor((now - then) / 3600000), "hour")} ago` : `${plural(floor((now - then) / 3600000), "hour")} ${plural(floor((now - then) / 60000) % 60, "minute")} ago`) : (floor((now - then) / 3600000) % 24 == 0 ? `${plural(floor((now - then) / 86400000), "day")} ago` : `${plural(floor((now - then) / 86400000), "day")} ${plural(floor((now - then) / 3600000) % 24, "hour")} ago`)))))

// fuel.ts levels: full at 100, high above 25, medium above 15, low above 5.
fn fuelTint(p: number): string = p > 25 ? "-exact-system-green" : (p > 15 ? "-exact-system-yellow" : (p > 5 ? "-exact-system-orange" : "-exact-system-red"))
fn fuelText(p: number): string = p >= 100 ? "-exact-system-green" : (p > 25 ? "-exact-label" : fuelTint(p))

// One extra control's name for "More controls"' subtitle, in Lexy's order.
fn extraName(flag: string): string = (
  flag == "trunkLockUnlockCapable" ? "trunk" :
  flag == "lightsCapable" ? "headlights" :
  flag == "hazardCapable" ? "hazards" :
  flag == "hornCapable" ? "horn" :
  flag == "buzzerCapable" ? "buzzer" :
  ""
)

fn mapsCount(m: MapsApp): number = (m.apple ? 1 : 0) + (m.google ? 1 : 0) + (m.waze ? 1 : 0)
// The app Open in uses without asking: the saved one, else the only one
// installed (not saved, so installing another asks again); empty to ask.
fn mapsResolved(m: MapsApp): string = m.provider != "" ? m.provider : (mapsCount(m) == 1 ? (m.apple ? "apple" : (m.google ? "google" : "waze")) : "")
fn mapsName(provider: string): string = (
  provider == "google" ? "Google Maps" :
  provider == "waze" ? "Waze" :
  provider == "apple" ? "Apple Maps" :
  "Maps"
)
// On the web, where no app opens, each maps app's own site with directions
// to the car.
fn webDirections(provider: string, latitude: number, longitude: number): string = provider == "google" ? `https://www.google.com/maps/dir/?api=1&destination=${latitude},${longitude}` : (provider == "waze" ? `https://www.waze.com/ul?ll=${latitude},${longitude}&navigate=yes` : `https://maps.apple.com/directions?destination=${latitude},${longitude}`)

fn capitalized(name: string): string = (
  name == "trunk" ? "Trunk" :
  name == "headlights" ? "Headlights" :
  name == "hazards" ? "Hazards" :
  name == "horn" ? "Horn" :
  name == "buzzer" ? "Buzzer" :
  name == "moonroof" ? "Moonroof" :
  name == "windows" ? "Windows" :
  name
)

// --- Palette ------------------------------------------------------------------------

// A system colour at 15%, for a symbol's badge or a banner's wash: written
// out until relative colour over a role (rgb(from …)) exists.
// Lexy's accent: the tach's red, in Display P3 (the app icon's #F0232C,
// more vivid), lighter in dark mode. The root sets it as `accent-color`.
fn accent(): string = "light-dark(color(display-p3 0.91 0.11 0.14), color(display-p3 1 0.27 0.28))"
// A role's wash: its colour at 15%. The accent's is written out, as Contract
// has no `color-mix()` yet.
fn wash(role: string): string = (
  role == "-exact-system-green" ? "light-dark(#34c75926, #30d15826)" :
  role == "-exact-system-orange" ? "light-dark(#ff950026, #ff9f0a26)" :
  role == "-exact-system-blue" ? "light-dark(#007aff26, #0a84ff26)" :
  role == "AccentColor" ? "light-dark(color(display-p3 0.91 0.11 0.14 / 0.15), color(display-p3 1 0.27 0.28 / 0.2))" :
  "light-dark(#3c3c4326, #ebebf526)"
)
// A card clips what it holds to its corners, as UIKit's inset grouped
// section does: a row's hover wash or a wide image stays inside it.
style Card
  background-color="-exact-secondary-grouped-background" border-radius=18 overflow="clip"
style SectionTitle
  font="-exact-headline" color="-exact-secondary-label" padding-left=16
style Small
  font-size=14 font-weight=500
style SmallBold
  font-size=14 font-weight=700
// status-banner.tsx: a tinted row of a symbol and words (the tint's wash is
// the node's own background-color).
style Banner
  gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 border-radius=14 align-items="center"
