// Settings, developer tools, and the vehicle-name form
use SafeScroll from "./model.contract"
use Car, trailingSegmentInset from "./model.contract"
use Card from "./model.contract"
use vehicleName from "./model.contract"
use mapsName from "./model.contract"
use exactVersion from "./exact-version.contract"
use MapsApp from "./model.contract"
use mapsCount from "./model.contract"
use mapsResolved from "./model.contract"
use MapsChooser from "./map.contract"
use SectionTitle from "./model.contract"

// Fill the width on a wide display and keep it on a fold, as a UIKit
// inset-grouped list does
component SettingsColumn
  props
    id: string
  slot
  view
    column testId=id box-sizing="border-box" padding=16 gap=24
      children

// Fill the width on a wide display, and keep a form clear of the hinge on a
// fold, as the sign-in form is: trailing on a book fold, lower on a laptop fold
component FormColumn
  props
    fold: string
    id: string
  slot
  view
    column testId=id box-sizing="border-box" width=(fold == "across" ? "auto" : "100%") margin-left=(fold == "across" ? trailingSegmentInset() : "0px") padding-top=(fold == "down" ? "calc(env(viewport-segment-top 0 1) - env(safe-area-inset-top) + 16px)" : "16px") padding-left=16 padding-right=16 padding-bottom=16 gap=24
      children

component SectionHeader
  props
    title: string
  view
    text title role="heading" aria-level=2 class=SectionTitle padding-bottom=4

component SectionFooter
  props
    words: string
  view
    text words font-size=13 color="-exact-secondary-label" padding-top=8 padding-left=16 padding-right=16

component SettingsRowFace
  props
    symbol: string
    title: string
    subtitle: string
    opensScreen: bool
  view
    row gap=16 padding=16 align-items="center" width="100%" box-sizing="border-box"
      image `symbol:icon.${symbol}` font-size=22 color="AccentColor" object-fit="scale-down" width=28 height=26
      column flex=1 min-width=0 gap=2
        text title font-size=17 font-weight=600 color="-exact-label"
        text subtitle font-size=13 font-weight=500 color="-exact-secondary-label"
      if opensScreen
        image "symbol:icon.chevron.right" font-size=14 font-weight=600 color="-exact-secondary-label" object-fit="scale-down" width=12 height=20

// Show developer tools first when developer mode is enabled
component DeveloperTools
  props
    open: action
    setDeveloper: action
    // The page's origin on the web, "" in the native app (DeveloperMode's),
    // and where the mode is kept: "on this iPhone", "in this browser".
    origin: string
    place: string
  view
    column
      SectionHeader(title="Developer Tools")
      column class=Card
        button text-align="left" press=open("/settings/updates") testId="dev-updates" display="flex"
          SettingsRowFace(symbol="square_stack_3d_up_fill", title="Updates", subtitle="This build’s update stream, and checking for a new one.", opensScreen=true)
        box height=0.5 margin-left=60 background-color="-exact-separator"
        button text-align="left" press=open("/settings/data-state") testId="dev-data-state" display="flex"
          SettingsRowFace(symbol="cylinder_split_1x2_fill", title="Data State", subtitle="Force loading, offline, error, and empty states.", opensScreen=true)
        box height=0.5 margin-left=60 background-color="-exact-separator"
        button text-align="left" press=open("/settings/login") testId="dev-login" display="flex"
          SettingsRowFace(symbol="person.badge.key.fill", title="Login Flow", subtitle="Walk the sign-in screens without signing out.", opensScreen=true)
        box height=0.5 margin-left=60 background-color="-exact-separator"
        button text-align="left" press=open("/settings/session") testId="dev-session" display="flex"
          SettingsRowFace(symbol="clock.arrow.circlepath", title="Session", subtitle="What the sign-in session did: refreshes, failures and sign-outs.", opensScreen=true)
        box height=0.5 margin-left=60 background-color="-exact-separator"
        button text-align="left" press=open("/settings/performance") testId="dev-performance" display="flex"
          SettingsRowFace(symbol="gauge_with_dots_needle_67percent", title="Performance", subtitle="This device’s launch and screen times, as Observe records them.", opensScreen=true)
        box height=0.5 margin-left=60 background-color="-exact-separator"
        button text-align="left" press=open("/settings/eas") testId="dev-eas" display="flex"
          SettingsRowFace(symbol="cloud.fill", title="Expo Services", subtitle="Open this project’s Expo dashboard.", opensScreen=true)
        box height=0.5 margin-left=16 background-color="-exact-separator"
        row padding=16 gap=12 align-items="center"
          text "Developer Mode" font-size=17 flex=1 min-width=0
          input type="checkbox" switch checked=true change=setDeveloper aria-label="Developer Mode" testId="developer-mode" accent-color="auto"
      if origin == ""
        SectionFooter(words=`Turning this off hides Developer Tools and Try Demo ${place}. Open lexy://developer to turn it back on.`)
      else
        // SectionFooter's, with the page's own developer link.
        text font-size=13 color="-exact-secondary-label" padding-top=8 padding-left=16 padding-right=16
          text `Turning this off hides Developer Tools and Try Demo ${place}. Open `
          text `${origin}/settings?developer=on` href="/settings?developer=on" testId="developer-link"
          text " to turn it back on."

component SettingsScreen
  props
    developer: bool
    developerOrigin: string
    developerPlace: string
    setDeveloper: action
    openDevTool: action
    car: Car
    name: string
    demo: bool
    demoFailing: bool
    setDemoFailing: action
    provider: string
    apps: MapsApp
    version: string
    editName: action
    chooseMaps: action
    signOut: action
    signingOut: bool
    fold: string
  view
    scroll id="screen-scroll" testId="settings-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%" class=SafeScroll
      SettingsColumn(id="settings-column")
        if developer
          DeveloperTools(open=openDevTool, setDeveloper=setDeveloper, origin=developerOrigin, place=developerPlace)
        column
          SectionHeader(title="Maps")
          column class=Card
            // The same chooser as the map's, of the installed apps only
            // (settings-screen.ios.tsx's promptChoice).
            button text-align="left" popovertarget=(mapsCount(apps) == 0 ? "" : "settings-maps-chooser") commandfor=(mapsCount(apps) == 0 ? "settings-no-maps" : "") command="show-modal" testId="maps-app" display="flex"
              SettingsRowFace(symbol="map.fill", title="Maps App", subtitle=(provider != "" ? mapsName(provider) : (mapsCount(apps) == 0 ? "Unavailable" : (mapsCount(apps) == 1 ? mapsName(mapsResolved(apps)) : "Not set"))), opensScreen=false)
            MapsChooser(prefix="settings-", apps=apps, choose=chooseMaps)
          SectionFooter(words="The app used to open your vehicle’s location for directions.")
        column
          SectionHeader(title="Vehicle")
          column class=Card
            button text-align="left" press=editName disabled=(car.vin == "") testId="edit-name" display="flex"
              SettingsRowFace(symbol="car.fill", title="Name", subtitle=(car.vin == "" ? "…" : name), opensScreen=true)
        column
          SectionHeader(title="Lexus Account")
          column class=Card
            // Start the label at the leading edge on a book fold, where a
            // centred label crosses the hinge
            button commandfor="sign-out-confirmation" command="show-modal" disabled=signingOut testId="sign-out" appearance="auto" buttonStyle="plain" padding=16 display="flex" flex-direction="row" align-items="center" justify-content="center" text-align=(fold == "across" ? "start" : "center") gap=8
              image "symbol:icon.rectangle.portrait.and.arrow.right" font-size=17 -exact-tint-color="-exact-system-red"
              text "Sign Out" font-size=17 font-weight=600 color="-exact-system-red"
          dialog id="sign-out-confirmation" role="alertdialog" aria-label="Sign Out?"
            text "You’ll need to sign in again to access your vehicle."
            button destructive=true press=signOut commandfor="sign-out-confirmation" command="close" testId="confirm-sign-out"
              text "Sign Out"
            button commandfor="sign-out-confirmation" command="close" testId="cancel-sign-out"
              text "Cancel"
          if demo
            SectionFooter(words="Signed in to the demo Lexus.")
        if demo
          column
            SectionHeader(title="Demo")
            column class=Card
              row padding-left=16 padding-right=16 min-height=52 justify-content="space-between" align-items="center" gap=12
                text "Simulate Server Errors" font-size=17 flex-shrink=1
                input type="checkbox" switch checked=demoFailing change=setDemoFailing aria-label="Simulate Server Errors" testId="demo-failures" accent-color="auto"
            SectionFooter(words="Commands, climate changes and renames fail as a server error does, so you can see how the app recovers.")
        column
          SectionHeader(title="About")
          column class=Card
            row padding=16 justify-content="space-between" align-items="center"
              text "Version" font-size=17
              text version testId="version" font-size=17 color="-exact-secondary-label" user-select="text"
            // A grouped list's divider, inset to the text.
            box height=0.5 margin-left=16 background-color="-exact-separator"
            row padding=16 justify-content="space-between" align-items="center" gap=16
              text "Built with" font-size=17
              text `Exact ${exactVersion()}` testId="built-with" font-size=17 color="-exact-secondary-label" text-align="right" flex-shrink=1 user-select="text"

component RenameScreen
  props
    fold: string
    name: string
    saved: string
    saving: bool
    error: string
    setName: action
    clear: action
    save: action
    back: action
  derive changed = name.trim() != "" and name.trim() != saved
  view
    scroll id="screen-scroll" testId="rename" keyboardDismissMode="interactive" overflow-x="hidden" flex=1 min-height=0 width="100%" background-color="-exact-grouped-background" class=SafeScroll
      FormColumn(fold=fold, id="rename-column")
        // section.tsx: the footer 8 under its field, 16 to what follows.
        column gap=8
          row class=Card min-height=44 padding-left=16 padding-right=8 align-items="center"
            input appearance="none" id="name-input" value=name input=setName submit=save enterkeyhint="done" autofocus=true autocapitalize="words" autocorrect="off" placeholder="My Vehicle" testId="name-input" flex=1 min-width=0 height=44 font-size=17 color="-exact-label"
            if name != ""
              button press=clear testId="clear-name" appearance="auto" buttonStyle="plain" aria-label="Clear" width=32 height=32 display="flex" align-items="center" justify-content="center"
                image "symbol:icon.xmark.circle.fill" font-size=17 -exact-tint-color="-exact-tertiary-label"
          text "Your car’s name, saved to the Lexus app." font-size=13 color="-exact-secondary-label" padding-left=16 padding-right=16
        if error != ""
          row gap=8 padding=16 border-radius=14 background-color="-exact-secondary-grouped-background" align-items="center" testId="rename-error"
            image "symbol:icon.exclamationmark.triangle.fill" font-size=18 color="-exact-system-orange" object-fit="scale-down" width=24 height=22
            text error font-size=13 font-weight=500 flex=1
        button press=save disabled=(not changed or saving) testId="save-name" appearance="auto" buttonStyle="prominent-glass" accent-color="AccentColor" height=50 border-radius=25 display="flex" align-items="center" justify-content="center"
          text "Save" font-size=17 font-weight=600 color="#ffffff"
