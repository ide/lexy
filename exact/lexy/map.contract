// The Last Parked sheet (src/screens/status-map-screen.ios.tsx): the street
// the car is on, when it was there, the map, and a way into a maps app.
use Status from "./model.contract"
use Small from "./model.contract"
use mapsName from "./model.contract"
use MapsApp from "./model.contract"
use mapsCount from "./model.contract"

// maps-provider-prompt.ios.tsx: the installed maps apps as a chooser
// anchored to its invoker, and the alert for when there are none. `prefix`
// keeps the map sheet's and Settings' ids apart.
component MapsChooser
  props
    prefix: string
    apps: MapsApp
    choose: action
  view
    // Out of flow, as the popover and the dialog are: the invoker's
    // container keeps its layout.
    column position="absolute"
      column id=`${prefix}maps-chooser` popover="auto" role="alertdialog" aria-label="Open location in" position="absolute"
        if apps.apple
          button press=choose("apple") popovertarget=`${prefix}maps-chooser` popovertargetaction="hide" testId=`${prefix}maps-apple`
            text "Apple Maps"
        if apps.google
          button press=choose("google") popovertarget=`${prefix}maps-chooser` popovertargetaction="hide" testId=`${prefix}maps-google`
            text "Google Maps"
        if apps.waze
          button press=choose("waze") popovertarget=`${prefix}maps-chooser` popovertargetaction="hide" testId=`${prefix}maps-waze`
            text "Waze"
      dialog id=`${prefix}no-maps` role="alertdialog" aria-label="No maps app installed"
        text "Install Apple Maps, Google Maps, or Waze from the App Store to open your vehicle's location for directions."
        button commandfor=`${prefix}no-maps` command="close" testId=`${prefix}no-maps-ok`
          text "OK"

component MapSheet
  props
    status: Status
    name: string
    address: string
    provider: string
    apps: MapsApp
    opening: bool
    error: string
    open: action
    pick: action
    tried: string
    close: action
  // The car's own stamp, clamped to the read that brought it, as on Status.
  derive locatedMs = status.fetchedMs > 0 ? min(status.occurredMs, status.fetchedMs) : status.occurredMs
  view
    column testId="map-sheet" flex=1 min-height=0 background-color="-exact-grouped-background"
      if status.latitude == 0 and status.longitude == 0
        column flex=1 align-items="center" justify-content="center"
          text "Location unavailable" font-size=16 font-weight=500 color="-exact-secondary-label"
          text "Lexus hasn't shared where your vehicle is parked yet. It usually appears after the vehicle has been driven and turned off." font-size=13 color="-exact-secondary-label" text-align="center" padding-left=32 padding-right=32
      else
        column gap=2 padding-left=16 padding-right=16 padding-top=4 padding-bottom=8 flex-shrink=0
          text (address != "" ? address : " ") testId="map-address" font-size=17 line-height="22px" font-weight=600
          if locatedMs > 0
            text class=Small color="-exact-secondary-label"
              text "Location as of "
              time datetime=locatedMs format="relative"
          else
            text "Location as of unknown" class=Small color="-exact-secondary-label"
        column flex=1 min-height=0 margin-left=16 margin-right=16 border-radius=18 overflow="hidden" background-color="-exact-tertiary-fill"
          lexy-map testId="map" width="100%" height="100%" latitude=status.latitude longitude=status.longitude map-zoom=16 pin="true" places="true" interactive="true" marker-title=name
        column padding-left=16 padding-right=16 padding-top=16 gap=8 flex-shrink=0
          // use-maps-provider.ts: a link the app didn't answer is an alert.
          dialog id="open-failed" role="alertdialog" aria-label=`Couldn't open ${mapsName(tried)}`
            text error testId="open-failed-message"
            button commandfor="open-failed" command="close" testId="open-failed-ok"
              text "OK"
          // The saved (or only) app opens directly; with several the chooser
          // asks, listing only the installed ones; with none an alert says so
          // (src/hooks/use-maps-provider.ts, maps-provider-prompt.ios.tsx).
          if provider != ""
            button press=open(provider) disabled=opening testId="open-maps" appearance="auto" buttonStyle="prominent-glass" accent-color="AccentColor" height=50 border-radius=25 display="flex" align-items="center" justify-content="center"
              text `Open in ${mapsName(provider)}` font-size=17 font-weight=600 color="#ffffff"
          else
            button popovertarget=(mapsCount(apps) == 0 ? "" : "maps-chooser") commandfor=(mapsCount(apps) == 0 ? "no-maps" : "") command="show-modal" disabled=opening testId="open-maps" appearance="auto" buttonStyle=(mapsCount(apps) == 0 ? "gray" : "filled") accent-color=(mapsCount(apps) == 0 ? "-exact-tertiary-fill" : "AccentColor") height=50 border-radius=25 display="flex" align-items="center" justify-content="center"
              text "Open in Maps" font-size=17 font-weight=600 color=(mapsCount(apps) == 0 ? "AccentColor" : "#ffffff")
            MapsChooser(prefix="", apps=apps, choose=pick)
