// Vehicle specifications, remote capabilities, and connected services
use Garage from "./model.contract"
use Spec from "./model.contract"
use Services from "./model.contract"
use Card from "./model.contract"
use SectionTitle from "./model.contract"
use Small from "./model.contract"
use SmallBold from "./model.contract"
use fuelName from "./model.contract"
use headUnit from "./model.contract"
use failureSummary from "./model.contract"
use failureAdvice from "./model.contract"
use VehicleState from "./status.contract"
use WarningBanner from "./status.contract"
use Activity from "./model.contract"

fn specValue(spec: Spec, name: string, fallback: string): string = match first(spec.items.filter(i => i.name == name and i.value != "")) { case some(i) => i.value, case none => fallback }

// Redactable's pulse (pulsing-text.tsx: 0.4 to 1 over 800 ms).
keyframes skeletonPulse
  from opacity=0.4
  to opacity=1

component InfoRow
  props
    label: string
    value: string
    last: bool
    waiting: bool
  view
    row justify-content="space-between" align-items="center" gap=16 padding-top=16 padding-bottom=16 border-bottom-width=(last ? 0 : 0.5) border-bottom-style="solid" border-color="-exact-separator" testId=`row-${label}`
      text label class=Small color="-exact-secondary-label"
      if waiting
        box width=100 height=17 border-radius=6 background-color="-exact-tertiary-fill"
      else
        text (value != "" ? value : "—") class=Small color="-exact-label" text-align="right" flex-shrink=1 font-variant-numeric="tabular-nums" user-select=(value != "" ? "text" : "auto")

component Capability
  props
    symbol: string
    label: string
  view
    row flex-grow=1 flex-basis="40%" gap=8 align-items="center"
      image `symbol:icon.${symbol}` font-size=20 color="AccentColor" object-fit="scale-down" width=20 height=20
      text label class=Small color="-exact-label"

component SpecsScreen
  props
    garage: Garage
    spec: Spec
    services: Services
    utcOffset: number
    reload: action
    refreshing: bool
    loading: bool
    online: bool
    specLoading: bool
    servicesLoading: bool
    manage: action
    // Wide: the vehicle on the left, capabilities and services on the right.
    wide: bool
    fold: string
  derive car = garage.car
  view
    scroll id="screen-scroll" testId="specs-scroll" -exact-scroll-edge-effect="soft" overflow-x="hidden" flex=1 min-height=0 width="100%" refresh=reload refreshing=refreshing
      column box-sizing="border-box" min-height="100%"
        if not online
          column margin-left=16 margin-right=16 margin-top=16
            WarningBanner(id="specs-offline", symbol="wifi.slash", framed=false, title="You're offline", message=(car.vin != "" ? "Showing the latest data we saved." : "Reconnect to see your vehicle."))
        // use-vehicle-screen.tsx: "Couldn't refresh" over data already shown.
        if online and car.vin != "" and not garage.ok and not loading and garage.status != 401
          column margin-left=16 margin-right=16 margin-top=16
            WarningBanner(id="specs-garage-error", symbol="exclamationmark.triangle.fill", framed=false, title="Couldn’t refresh", message=`${failureSummary(garage.status, garage.error)} Showing the latest data we saved. Pull down to try again.`)
        if car.vin == "" and not loading and garage.ok and garage.carCount == 0
          // 16 above, as Status' padded column and its gap give its state,
          // so the two screens' states stand in the same place.
          column flex-grow=1 margin-top=16
            VehicleState(symbol="car_2", title="No vehicle found", message="There's no vehicle associated with this Lexus account. Add your vehicle in the Lexus app, then check again here.", label="Check again", press=reload, id="specs-no-vehicle")
        if car.vin == "" and not loading and not garage.ok and garage.status != 401
          // 16 above, as Status' padded column and its gap give its state,
          // so the two screens' states stand in the same place.
          column flex-grow=1 margin-top=16
            VehicleState(symbol="exclamationmark.triangle", title="Vehicle data unavailable", message=failureAdvice(garage.status, garage.error), label="Try again", press=reload, id="specs-error")
        if car.vin != "" or loading
          // Its last card keeps its own room below it, as Status' footer does.
          column box-sizing="border-box" padding-top=16 padding-bottom=16 padding-left=(fold == "across" ? "0px" : "16px") padding-right=(fold == "across" ? "0px" : "16px") gap=16 margin-bottom=16 display=(wide ? "grid" : "flex") flex-direction="column" grid-template-columns=(wide ? (fold == "across" ? "minmax(0, 1fr)" : "minmax(0, 1fr) minmax(0, 1fr)") : "none") align-items=(wide ? "start" : "stretch") testId=(car.vin == "" ? "specs-skeleton" : "specs-body")
            column gap=8 testId="specs-vehicle" grid-column=(wide ? "1" : "auto") grid-row=(wide ? "1" : "auto") margin-left=(fold == "across" ? "16px" : "0px") width=(fold == "across" ? "calc(env(viewport-segment-width 0 0) - env(safe-area-inset-left) - 32px)" : "auto") box-sizing="border-box"
              text "Vehicle" role="heading" aria-level=2 class=SectionTitle
              column class=Card padding-left=16 padding-right=16 animation=(car.vin == "" and online ? "skeletonPulse 800ms ease-in-out infinite alternate" : "none") animation-timeline=Activity
                InfoRow(label="VIN", value=car.vin, last=false, waiting=car.vin == "")
                InfoRow(label="Model Code", value=car.modelCode, last=false, waiting=car.vin == "")
                InfoRow(label="Exterior", value=car.color, last=false, waiting=car.vin == "")
                InfoRow(label="Trim", value=specValue(spec, "Grade", car.grade), last=false, waiting=(car.vin == "" or (specLoading and spec.items.length == 0 and car.grade == "")))
                InfoRow(label="Region", value=car.region, last=false, waiting=car.vin == "")
                InfoRow(label="Telematics", value=car.generation, last=false, waiting=car.vin == "")
                InfoRow(label="Head Unit", value=headUnit(car.generation), last=false, waiting=car.vin == "")
                InfoRow(label="Fuel Type", value=fuelName(car.fuelType), last=false, waiting=car.vin == "")
                InfoRow(label="Transmission", value=specValue(spec, "Transmission", "—"), last=false, waiting=(car.vin == "" or (specLoading and spec.items.length == 0)))
                InfoRow(label="Drivetrain", value=specValue(spec, "Drive Type", "—"), last=false, waiting=(car.vin == "" or (specLoading and spec.items.length == 0)))
                InfoRow(label="Built", value=specValue(spec, "Order Date", "—"), last=false, waiting=(car.vin == "" or (specLoading and spec.items.length == 0)))
                InfoRow(label="In Service", value=specValue(spec, "Date of First Use", "—"), last=true, waiting=(car.vin == "" or (specLoading and spec.items.length == 0)))
            column testId="specs-right" gap=16 grid-column=(wide ? (fold == "across" ? "1" : "2") : "auto") grid-row=(wide ? "1" : "auto") margin-left=(fold == "across" ? "calc(env(viewport-segment-left 1 0) - env(safe-area-inset-left) + 16px)" : "0px") margin-right=(fold == "across" ? "16px" : "0px")
              // src/data/vehicle-mapping.ts lists the same four for every car.
              column gap=8
                text "Remote Capabilities" role="heading" aria-level=2 class=SectionTitle
                row class=Card flex-wrap="wrap" padding=16 gap=16
                  Capability(symbol="lock.fill", label="Lock & unlock")
                  Capability(symbol="power", label="Engine start")
                  Capability(symbol="thermometer.medium", label="Climate")
                  Capability(symbol="location.fill", label="Location")
              if (car.vin == "" and loading) or (servicesLoading and services.items.length == 0)
                column gap=8 testId="services-skeleton" animation=(online ? "skeletonPulse 800ms ease-in-out infinite alternate" : "none") animation-timeline=Activity
                  text "Connected Services" role="heading" aria-level=2 class=SectionTitle
                  column class=Card padding-left=16 padding-right=16
                    for i in range(3) key=i
                      InfoRow(label="", value="", last=(i == 2), waiting=true)
              if car.vin != "" and services.items.length > 0
                column gap=8
                  text "Connected Services" role="heading" aria-level=2 class=SectionTitle
                  column class=Card padding-left=16 padding-right=16
                    for s, i in services.items key=`${s.bucket}-${s.name}`
                      row justify-content="space-between" align-items="center" gap=16 padding-top=16 padding-bottom=16 border-bottom-width=0.5 border-bottom-style="solid" border-color="-exact-separator" testId=`service-${i}`
                        column flex-shrink=1
                          text s.name class=Small color="-exact-label" user-select="text"
                          text (s.endMs > 0 ? `${s.bucket == "trial" ? "Trial expires" : "Expires"} ${formatDate(s.endMs, utcOffset, "month-year")}` : (s.bucket == "trial" ? "Trial" : "")) class=Small color="-exact-secondary-label"
                        text s.status class=SmallBold color=(s.status == "Active" ? "-exact-system-green" : "-exact-secondary-label")
                    button press=manage testId="manage-subscriptions" appearance="auto" buttonStyle="plain" padding-top=22 padding-bottom=22 display="flex" align-items="center"
                      text "Manage your subscriptions in the Lexus app" font-size=14 color="AccentColor" text-align="center"
