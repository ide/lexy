// Lexus sign-in: credentials, delivery method, and verification code
use readableWidth from "./model.contract"

// sign-in-copy.ts classifyDeliveryMethod: a method label's channel.
fn channel(method: string): string = (method.includes("mail") or method.includes("Mail") or method.includes("E-mail")) ? "email" : ((method.includes("SMS") or method.includes("sms") or method.includes("Text") or method.includes("text") or method.includes("hone") or method.includes("obile") or method.includes("all")) ? "sms" : "unknown")
fn heroSymbol(step: string, method: string): string = step == "choice" ? "lock.shield.fill" : (step == "otp" ? (channel(method) == "email" ? "envelope.fill" : (channel(method) == "sms" ? "message.fill" : "number")) : "key.fill")
fn heroTitle(step: string, method: string): string = step == "choice" ? "Verify It's You" : (step == "otp" ? (channel(method) == "email" ? "Check Your Email" : (channel(method) == "sms" ? "Check Your Messages" : "Enter Your Code")) : "Welcome to Lexy")
// Hide server message keys; show prompts that read as prose
fn readable(p: string): bool = p != "" and p.includes(" ")
fn heroSubtitle(step: string, method: string, prompt: string): string = step == "choice" ? (readable(prompt) ? prompt : "Choose how you'd like to receive your verification code.") : (step == "otp" ? (channel(method) == "email" ? "Lexus will send you a verification code by email." : (channel(method) == "sms" ? "Lexus will send you a verification code by text message." : "Enter the verification code you received.")) : "Sign in with your Lexus account to see and control your vehicle.")
fn choiceSymbol(method: string): string = channel(method) == "email" ? "envelope" : (channel(method) == "sms" ? "message" : "shield.lefthalf.filled")

// Draw the mark inline for first paint, using semantic colors for light and dark modes
component LexyMark
  props
    size: number
  view
    svg testId="lexy-mark" aria-label="Lexy" role="img" width=size height=size viewBox="148 163 744 744"
      defs
        linearGradient id="mark-metal" gradientUnits="userSpaceOnUse" x1=0 y1=163 x2=0 y2=906
          stop offset=0 stop-color="-exact-label" stop-opacity=0.9
          stop offset=0.55 stop-color="-exact-label" stop-opacity=0.55
          stop offset=0.95 stop-color="-exact-label" stop-opacity=0.2
        linearGradient id="mark-redline" gradientUnits="userSpaceOnUse" x1=878 y1=540 x2=750 y2=809
          stop offset=0 stop-color="-exact-system-red" stop-opacity=0.7
          stop offset=1 stop-color="-exact-system-red" stop-opacity=0.12
        linearGradient id="mark-glyph" gradientUnits="userSpaceOnUse" x1=0 y1=364 x2=0 y2=690
          stop offset=0 stop-color="-exact-label"
          stop offset=1 stop-color="-exact-label" stop-opacity=0.78
      path d="M 436.58 896.58 A 371.30 371.30 0 1 1 705.19 212.92 L 692.33 235.29 A 345.50 345.50 0 1 0 442.38 871.44 Z" fill="url(#mark-metal)"
      path d="M 706.31 213.57 A 371.30 371.30 0 0 1 891.39 531.56 L 865.59 531.78 A 345.50 345.50 0 0 0 693.37 235.89 Z" fill="-exact-system-red"
      path d="M 891.36 539.98 A 371.30 371.30 0 0 1 758.77 819.23 L 742.18 799.47 A 345.50 345.50 0 0 0 865.57 539.62 Z" fill="url(#mark-redline)"
      path d="M 505.19 370.66 A 14.00 14.00 0 0 1 517.45 363.99 L 592.07 365.79 A 5.00 5.00 0 0 1 596.18 373.46 L 440.06 620.08 A 12.00 12.00 0 0 0 450.20 638.50 L 742.55 638.50 A 4.00 4.00 0 0 1 745.22 645.48 L 697.02 688.72 A 5.00 5.00 0 0 1 693.69 690.00 L 394.90 690.00 A 48.00 48.00 0 0 1 354.00 616.88 Z" fill="url(#mark-glyph)"

// A step's controls arrive with sign-in-screen.ios.tsx's spring (0.35 s).
keyframes stepIn
  from opacity=0 translate="0px 8px"

// Keep the fill while busy; actions ignore repeat presses
component PrimaryButton
  props
    label: string
    disabled: bool
    press: action
    id: string
  view
    button press=press disabled=disabled testId=id appearance="auto" buttonStyle="filled" accent-color="AccentColor" height=50 border-radius=25 display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size=17 font-weight=600

component SecondaryButton
  props
    label: string
    disabled: bool
    press: action
    id: string
  view
    button press=press disabled=disabled testId=id appearance="auto" buttonStyle="gray" height=50 border-radius=25 display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size=17 font-weight=600 color="AccentColor"

component Notice
  props
    id: string
    symbol: string
    tint: string
    message: string
  view
    row testId=id gap=8 padding=16 border-radius=14 background-color="-exact-secondary-grouped-background" align-items="center"
      image `symbol:icon.${symbol}` font-size=18 -exact-tint-color=tint
      text message font-size=13 font-weight=500 color="-exact-label" flex=1 min-width=0

component LockScreen
  props
    step: string
    email: string
    password: string
    code: string
    error: string
    busy: bool
    resending: bool
    info: string
    choices: string[]
    prompt: string
    method: string
    setEmail: action
    setPassword: action
    setCode: action
    signIn: action
    choose: action
    verify: action
    resend: action
    differentMethod: action
    tryDemo: action
    // Developer mode (lexy://developer): only then is Try Demo offered
    developer: bool
    getLexusApp: action
    nextField: action
    // Settings → Developer Tools → Login Flow: under a navigation bar, and
    // with no way into the demo (it would sign the real app in).
    preview: bool
    fold: string
    // The preview's scenario, named above the form; "" shows nothing.
    banner: string
    bannerSymbol: string
  view
    scroll id="sign-in-scroll" testId="sign-in" keyboardDismissMode="interactive" overflow-x="hidden" width="100%" height="100%"
      // Keep the form in one segment: trailing on a book fold, lower on a laptop fold
      column box-sizing="border-box" width=(fold == "across" ? "auto" : "100%") max-width=(fold == "across" ? "none" : readableWidth()) margin-left=(fold == "across" ? "calc(env(viewport-segment-left 1 0) - env(safe-area-inset-left))" : "auto") margin-right=(fold == "across" ? "0px" : "auto") padding-top=(preview ? "24px" : (fold == "down" ? "calc(env(viewport-segment-top 0 1) + 16px)" : "calc(env(safe-area-inset-top) + 64px)")) padding-left=16 padding-right=16 padding-bottom="calc(env(safe-area-inset-bottom) + 16px)" gap=24
        if banner != ""
          row testId="preview-banner" align-self="center" gap=6 padding-left=12 padding-right=12 height=30 border-radius=15 background-color="-exact-secondary-grouped-background" align-items="center"
            image `symbol:sf/${bannerSymbol}` font-size=13 -exact-tint-color="-exact-system-blue"
            text `Preview · ${banner}` font-size=13 font-weight=600 color="-exact-secondary-label"
        // Hero: the step's symbol, title and what to do.
        column align-items="center" gap=8
          if step == "credentials"
            LexyMark(size=76)
          if step != "credentials"
            image `symbol:icon.${heroSymbol(step, method)}` font-size=44 -exact-tint-color="-exact-system-blue" margin-bottom=4
          text heroTitle(step, method) testId="sign-in-title" font-size=28 font-weight=700 text-align="center"
          text heroSubtitle(step, method, prompt) testId="sign-in-subtitle" font-size=15 color="-exact-secondary-label" text-align="center" padding-left=8 padding-right=8
        // The first step is there on the first frame, as a native form is;
        // the later steps arrive with stepIn.
        if step == "credentials"
          column gap=16
            // The group is the fields' look, so each is a bare box
            // (appearance="none": no default field border).
            column border-radius=16 background-color="-exact-secondary-grouped-background" overflow="hidden"
              input appearance="none" value=email input=setEmail type="email" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false" autofocus=true autocomplete="username" disabled=busy submit=nextField enterkeyhint="next" placeholder="Email" testId="email" box-sizing="border-box" width="100%" padding=16 font-size=17 color="-exact-label"
              box height=0.5 margin-left=16 background-color="-exact-separator"
              input appearance="none" value=password input=setPassword submit=signIn type="password" id="password" autocomplete="current-password" enterkeyhint="go" disabled=busy placeholder="Password" testId="password" box-sizing="border-box" width="100%" padding=16 font-size=17 color="-exact-label"
            PrimaryButton(label=(busy ? "Signing In…" : "Sign In"), disabled=(email.trim() == "" or password == ""), press=signIn, id="sign-in-button")
        if step == "choice"
          // One row of equal-width choices (ChoiceButton: bordered, large).
          row gap=8 animation="stepIn 350ms ease-out"
            for m, i in choices key=m
              button press=choose(i) disabled=busy testId=`method-${i}` appearance="auto" buttonStyle="tinted" accent-color="AccentColor" flex=1 min-width=0 height=50 border-radius=25 display="flex" flex-direction="row" align-items="center" justify-content="center" gap=8
                image `symbol:icon.${choiceSymbol(m)}` font-size=17 -exact-tint-color="AccentColor"
                text m font-size=17 font-weight=600 color="AccentColor" line-clamp=1
        if step == "otp"
          column gap=16 animation="stepIn 350ms ease-out"
            input appearance="none" value=code input=setCode submit=verify inputmode="numeric" autocomplete="one-time-code" autocorrect="off" autofocus=true enterkeyhint="done" disabled=busy placeholder="Verification Code" testId="code" box-sizing="border-box" width="100%" padding=16 border-radius=16 background-color="-exact-secondary-grouped-background" font-size=17 color="-exact-label"
            PrimaryButton(label=(busy and not resending ? "Verifying…" : "Verify"), disabled=(code.trim() == ""), press=verify, id="verify-button")
            column gap=8
              SecondaryButton(label="Resend Code", disabled=busy, press=resend, id="resend")
              if choices.length > 1
                SecondaryButton(label="Use a Different Method", disabled=busy, press=differentMethod, id="different-method")
        if error != ""
          Notice(id="sign-in-error", symbol="exclamationmark.triangle.fill", tint="-exact-system-orange", message=error)
        if error == "" and info != ""
          Notice(id="sign-in-info", symbol="checkmark.circle.fill", tint="-exact-system-green", message=info)
        if step == "credentials"
          // NewToLexusCallout: the account comes from Lexus's own app.
          column testId="new-to-lexus" align-items="flex-start" gap=8 padding=16 border-radius=14 background-color="-exact-secondary-grouped-background"
            text "New to Lexus?" font-size=13 font-weight=600 color="-exact-label"
            text "Create an account and add your vehicle in the Lexus app, then come back here to sign in." font-size=13 color="-exact-secondary-label"
            // Only the link is a control (sign-in-elements.ios.tsx).
            button press=getLexusApp testId="get-lexus-app" appearance="auto" buttonStyle="plain"
              text "Get the Lexus App" font-size=13 font-weight=600 color="AccentColor"
        text "Your password and verification code go directly to Lexus. Lexy never stores them or collects your information." font-size=13 font-weight=500 color="-exact-secondary-label" text-align="center" padding-top=8 padding-left=8 padding-right=8
      // Not in Lexy: an in-memory Lexus, for trying the app without an
      // account. One tap signs in. In the corner, where the keyboard never
      // covers it, and last, so it is above the form. Shown on the first step
      // whatever the stored demo flag says: a flag left in the Keychain (it
      // outlives a reinstall) hid it on a signed-out launch.
      if developer and step == "credentials" and not preview
        button press=tryDemo disabled=busy testId="try-demo" appearance="auto" buttonStyle="plain" position="absolute" top="calc(env(safe-area-inset-top) + 4px)" right=8 height=44 padding-left=8 padding-right=8 display="flex" align-items="center" justify-content="center"
          text "Try Demo" font-size=17 color="AccentColor"
