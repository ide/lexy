// The Status tab (src/screens/status-screen.ios.tsx and src/features/vehicle):
// the car over its parked map, fuel, remote controls, remote-start climate,
// doors and windows, odometer, tires, and when it last synced.
use Garage from "./model.contract"
use Status from "./model.contract"
use Tires from "./model.contract"
use Section from "./model.contract"
use Climate from "./model.contract"
use Card from "./model.contract"
use CardTitle from "./model.contract"
use Small from "./model.contract"
use SmallBold from "./model.contract"
use vehicleName from "./model.contract"
use can from "./model.contract"
use isCorner from "./model.contract"
use cornerOf from "./model.contract"
use partOf from "./model.contract"
use closureName from "./model.contract"
use isOpen from "./model.contract"
use lowerName from "./model.contract"
use isUnlocked from "./model.contract"
use reports from "./model.contract"
use any from "./model.contract"
use round from "./model.contract"
use grouped from "./model.contract"
use tenths from "./model.contract"
use exactTime from "./model.contract"
use distanceUnit from "./model.contract"
use relative from "./model.contract"
use tireLabel from "./model.contract"
use failureSummary from "./model.contract"
use failureAdvice from "./model.contract"
use fuelTint from "./model.contract"
use fuelText from "./model.contract"
use extraName from "./model.contract"
use capitalized from "./model.contract"
use c from "./model.contract"
use wash from "./model.contract"
use Activity from "./model.contract"

// One remote control (vehicle-controls.ios.tsx): a filled button over a symbol
// and its name, and the confirmation it asks for: a modal dialog of title,
// message, one action and a cancel, which iOS presents as its alert.
// climate-card.ios.tsx: an active defrost chip is the blue wash over the
// chip's grey, on the card (composited, one colour).
fn defrostOnColor(): string = "light-dark(#d0e2f7, #27394f)"

// A pending lock or engine word pulses (pulsing-text.tsx: 0.4 to 1 over
// 800 ms, back and forth), and two pending at once pulse together: each
// joins the phase the other is in (LLP 1055.002).
timeline Pending

keyframes pending
  from opacity=0.4
  to opacity=1

// refreshing-note.tsx: the system spinner's eight steps.
keyframes spin
  from rotate="0deg"
  to rotate="360deg"

// refreshing-note.tsx: a refresh the user didn't ask for, floating over the
// content under the navigation bar (nothing moves to make room), fading
// and settling in. Bare secondary words beside a spinner read as status,
// not a control; it never takes touches.
component RefreshingNote
  props
    visible: bool
  view
    row testId="refreshing-note" position="absolute" top="calc(env(safe-area-inset-top) + 8px)" left=0 right=0 justify-content="center" align-items="center" gap=8 pointer-events="none" opacity=(visible ? 1 : 0) translate=(visible ? "0px 0px" : "0px -6px") transition="opacity 220ms ease, translate 220ms ease"
      image "symbol:sf/progress.indicator" font-size=15 tint-color="secondary-label" animation=(visible ? "spin 1s steps(8) infinite" : "none") animation-timeline=Activity object-fit="scale-down" width=18 height=18
      // A live region: VoiceOver hears the words arrive (nothing moves
      // focus to them); empty while hidden, so each refresh is announced.
      text (visible ? "Refreshing…" : "") class=Small color="secondary-label" aria-live="polite" min-width=80

component ControlButton
  props
    command: string
    label: string
    symbol: string
    tint: string
    title: string
    message: string
    action: string
    destructive: bool
    disabled: bool
    glass: bool
    // vehicle-controls.ios.tsx sizes some symbols down (iconSize).
    iconSize: number
    run: action
  view
    column flex=1 min-width=0
      button commandfor=`confirm-${command}` command="show-modal" disabled=disabled testId=`command-${command}` aria-label=label -exact-apple-button-style="filled" accent-color=c(glass ? "card" : "subtle") height=76 border-radius=18 display="flex" flex-direction="column" align-items="center" justify-content="center" gap=4
        image `symbol:sf/${symbol}` font-size=iconSize tint-color=c(tint)
        text label font-size=13 font-weight=600 color="label" line-clamp=1
      // A centred alert, as Lexy's (alert-host.tsx): the same place for
      // every control.
      dialog id=`confirm-${command}` closedby="any"
        text title
        text message
        button destructive=destructive press=run(command) commandfor=`confirm-${command}` command="close" testId=`confirm-${command}`
          text action
        button commandfor=`confirm-${command}` command="close" testId=`cancel-${command}`
          text "Cancel"

// vehicle-state.ios.tsx StateScreen: a whole screen saying why there is
// nothing to show, and the one thing to do about it.
component VehicleState
  props
    symbol: string
    title: string
    message: string
    label: string
    press: action
    id: string
  view
    column align-items="center" gap=16 padding-top=64 padding-left=24 padding-right=24 testId=id
      image `symbol:sf/${symbol}` font-size=44 tint-color="secondary-label"
      text title font-size=34 font-weight=700 text-align="center"
      text message font-size=17 color="secondary-label" text-align="center"
      button press=press testId=`${id}-retry` -exact-apple-button-style="filled" accent-color="system-blue" height=50 border-radius=25 padding-left=16 padding-right=16 display="flex" align-items="center" justify-content="center"
        text label font-size=17 color="#ffffff"

// A status line in a corner of Doors & Windows: symbol, then words.
component StatusLine
  props
    symbol: string
    pointsize: number
    tint: string
    words: string
  view
    row gap=4 align-items="center"
      image `symbol:sf/${symbol}` font-size=pointsize tint-color=c(tint) object-fit="scale-down" width=22 height=20
      text words font-size=15 color="label"

// A corner of the car: its door and window (closures-summary.ios.tsx).
component Corner
  props
    title: string
    driver: bool
    door: option<Section>
    window: option<Section>
    lockPending: bool
    lockTarget: string
  view
    column flex=1 min-width=0 gap=8 testId=`corner-${title}`
      text title font-size=14 font-weight=700 color="secondary-label"
      match door
        case some(d)
          when isOpen(d)
            StatusLine(symbol="lock.open.fill", pointsize=15, tint="orange", words="Door open")
          else
            when lockPending
              StatusLine(symbol=(lockTarget == "locked" ? "lock.fill" : "lock.open.fill"), pointsize=15, tint=(lockTarget == "locked" ? "green" : "orange"), words=(lockTarget == "locked" ? "Locking…" : "Unlocking…"))
            else
              when isUnlocked(d)
                StatusLine(symbol="lock.open.fill", pointsize=15, tint="orange", words="Door unlocked")
              else
                when any(d.values, "Locked")
                  StatusLine(symbol="lock.fill", pointsize=15, tint="green", words="Door locked")
                else
                  StatusLine(symbol="checkmark.circle.fill", pointsize=15, tint="green", words="Door closed")
        case none
          box
      match window
        case some(w)
          StatusLine(symbol=(driver ? "car.window.right" : "car.window.left"), pointsize=12, tint=(isOpen(w) ? "orange" : "green"), words=(isOpen(w) ? "Window open" : "Window closed"))
        case none
          box

component StatusScreen
  props
    garage: Garage
    status: Status
    tires: Tires
    climate: Climate
    engineRunning: bool
    enginePending: bool
    engineTarget: string
    lockPending: bool
    lockTarget: string
    doorLock: string
    hazardsOn: bool
    busy: bool
    refreshing: bool
    loading: bool
    notice: string
    clock: number
    checkedAt: number
    moreOpen: bool
    closuresOpen: bool
    // A save, or the re-read after it, is in flight: the controls hold still.
    climateSaving: bool
    climateLoading: bool
    utcOffset: number
    online: bool
    // A read the app started itself (status-screen.ios.tsx's footer); a
    // pull shows its own spinner instead.
    updating: bool
    commandError: string
    dismissError: action
    climateError: string
    dismissClimateError: action
    engineKnown: bool
    climateWanted: bool
    // Each defrost as shown: the tapped value while it saves.
    frontDefrost: bool
    rearDefrost: bool
    reload: action
    run: action
    openMap: action
    toggleMore: action
    toggleClosures: action
    setClimateOn: action
    setTemperature: action
    // The setpoint shown: the one under the finger, else the car's.
    temperature: number
    dragTemperature: action
    toggleDefrost: action
  derive car = garage.car
  derive rows = filter(status.sections, s => s.category != "Trip Details" and reports(s))
  derive corners = filter(rows, s => isCorner(s))
  derive openings = filter(rows, s => not isCorner(s))
  derive doorRows = filter(corners, s => partOf(s) == "door")
  derive openRows = filter(rows, s => isOpen(s))
  derive unlockedRows = filter(rows, s => isUnlocked(s) and not isOpen(s))
  derive issues = length(openRows) + length(unlockedRows)
  derive allLocked = length(doorRows) > 0 and length(filter(doorRows, d => any(d.values, "Locked"))) == length(doorRows)
  // closure-summary.ts: the verdict the card leads with.
  derive single = match first(openRows) { case some(s) => `${closureName(s)} open`, case none => match first(unlockedRows) { case some(s) => `${closureName(s)} unlocked`, case none => "" } }
  derive headline = lockPending ? (lockTarget == "locked" ? "Locking…" : "Unlocking…") : (issues == 0 ? (allLocked ? "All secure" : "All closed") : (issues == 1 ? single : (length(openRows) == 0 ? `${length(unlockedRows)} doors unlocked` : (length(unlockedRows) == 0 ? `${length(openRows)} open` : `${length(openRows)} open, ${length(unlockedRows)} unlocked`))))
  // closure-summary.ts settledGroups/restSubline: the subline names only
  // what was read and is settled — doors, then windows and each opening.
  derive settledDoors = filter(doorRows, d => not isOpen(d) and not isUnlocked(d))
  derive doorsPart = length(settledDoors) == 0 ? "" : (length(filter(settledDoors, d => any(d.values, "Locked"))) == length(settledDoors) ? "Doors locked" : "Doors closed")
  derive settledWindows = filter(corners, s => partOf(s) == "window" and not isOpen(s))
  derive settledOpenings = filter(openings, o => not isOpen(o) and not isUnlocked(o))
  derive restCount = (length(settledWindows) > 0 ? 1 : 0) + length(settledOpenings)
  derive o1 = match first(settledOpenings) { case some(o) => o.section, case none => "" }
  derive o2 = join(map(filter(settledOpenings, (o, i) => i == 1), o => lowerName(o.section)), "")
  derive restText = restCount == 0 ? "" : (restCount >= 3 ? "Everything else closed" : (length(settledWindows) > 0 ? (restCount == 1 ? "Windows closed" : `Windows and ${lowerName(o1)} closed`) : (restCount == 1 ? `${o1} closed` : `${o1} and ${o2} closed`)))
  derive subline = lockPending ? restText : (issues == 0 ? (doorsPart != "" and restText != "" ? `${doorsPart} · ${restText}` : `${doorsPart}${restText}`) : ((doorsPart != "" ? 1 : 0) + restCount == 0 ? "" : (doorsPart == "Doors locked" ? "Everything else closed and locked" : "Everything else closed")))
  // The one exception's own symbol: a door, a window, an opening.
  derive singleSymbol = match first(openRows) { case some(s) => (isCorner(s) ? (partOf(s) == "door" ? "lock.open.fill" : (includes(s.category, "Passenger") ? "car.window.left" : "car.window.right")) : (includes(s.section, "Moon") ? "moon.fill" : (includes(s.section, "Hood") ? "engine.combustion.fill" : "car.side.rear.crop.trunk.partition.fill"))), case none => "lock.open.fill" }
  derive verdictTint = lockPending ? "secondary" : (issues == 0 ? "green" : "orange")
  derive verdictSymbol = lockPending ? (lockTarget == "locked" ? "lock.fill" : "lock.open.fill") : (issues == 0 ? (allLocked ? "checkmark.shield.fill" : "checkmark.circle.fill") : (issues == 1 ? singleSymbol : (length(openRows) == 0 ? "lock.open.fill" : "exclamationmark.triangle.fill")))
  derive fuel = round(status.fuel)
  derive electric = car.fuelType == "E"
  derive unit = distanceUnit(status.rangeUnit)
  derive odoUnit = distanceUnit(status.odometerUnit)
  derive extras = filter(map(car.capabilities, f => extraName(f)), n => n != "")
  // describeExtraControls: "Trunk, headlights, hazards, horn, and buzzer".
  derive extrasText = length(extras) == 0 ? "" : (length(extras) == 1 ? capitalized(join(extras, "")) : `${join(map(filter(extras, (n, i) => i < length(extras) - 1), (n, i) => i == 0 ? capitalized(n) : n), ", ")}${length(extras) > 2 ? "," : ""} and ${join(filter(extras, (n, i) => i == length(extras) - 1), "")}`)
  derive canLock = can(car.capabilities, "doorLockUnlockCapable")
  derive canEngine = can(car.capabilities, "remoteEngineStartStop")
  view
    column flex=1 min-height=0 width="100%"
      scroll testId="status-scroll" scroll-edge-effect="soft" overflow-x="hidden" flex=1 min-height=0 width="100%" refresh=reload refreshing=refreshing
        column box-sizing="border-box" padding-bottom=8
          column box-sizing="border-box" padding-top=16 padding-left=16 padding-right=16 gap=16
            // Banners (src/components/ui/status-banner.tsx)
            // use-vehicle-screen.tsx / status-banner.tsx: offline, amber.
            when not online
              row testId="offline" gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 border-radius=14 background-color=wash("orange") align-items="center"
                image "symbol:sf/wifi.slash" font-size=17 tint-color="system-orange"
                column gap=2 flex=1
                  text "You're offline" class=SmallBold color="system-orange"
                  text (car.vin != "" ? "Showing the latest data we saved." : "Reconnect to see your vehicle.") class=Small color="system-orange" opacity=0.85
            // use-vehicle-screen.tsx: "Couldn't refresh" over data already shown.
            when online and car.vin != "" and not loading and ((not garage.ok and garage.status != 401) or (status.ok and status.error != "" and status.status != 401))
              row testId="garage-error" gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 border-radius=14 background-color=wash("orange") align-items="center"
                image "symbol:sf/exclamationmark.triangle.fill" font-size=17 tint-color="system-orange" object-fit="scale-down" width=22 height=22
                column gap=2 flex=1
                  text "Couldn’t refresh" class=SmallBold color="system-orange"
                  text `${(not garage.ok ? failureSummary(garage.status, garage.error) : failureSummary(status.status, status.error))} Showing the latest data we saved.` class=Small color="system-orange" opacity=0.85
            when car.vin == "" and not loading and garage.ok and length(garage.cars) == 0
              VehicleState(symbol="car.2", title="No vehicle found", message="There's no vehicle associated with this Lexus account. Add your vehicle in the Lexus app, then check again here.", label="Check again", press=reload, id="no-vehicle")
            when car.vin == "" and not loading and not garage.ok and garage.status != 401
              VehicleState(symbol="exclamationmark.triangle", title="Vehicle data unavailable", message=failureAdvice(garage.status, garage.error), label="Try again", press=reload, id="vehicle-error")
            // vehicle-controls.ios.tsx: a failed command is an alert.
            dialog id="climate-failed" closedby="any" open=(climateError != "")
              text "Couldn't save climate settings"
              text climateError
              button press=dismissClimateError commandfor="climate-failed" command="close" testId="climate-failed-ok"
                text "OK"
            dialog id="command-failed" closedby="any" open=(commandError != "")
              text "Command failed"
              text commandError
              button press=dismissError commandfor="command-failed" command="close" testId="command-failed-ok"
                text "OK"
            when notice != ""
              row testId="notice" gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 border-radius=14 background-color=wash("blue") align-items="center"
                image "symbol:sf/checkmark.circle.fill" font-size=17 tint-color="system-blue" object-fit="scale-down" width=22 height=22
                text notice class=SmallBold color="system-blue" flex=1
            // Until the first garage arrives: the cards' shapes, redacted, as
            // Lexy's skeleton (Redactable), never placeholder words.
            when car.vin == "" and loading
              // The big shapes where they will be: the hero's 265 (8 + 185 + 8 +
              // 48 + 16) with Last Parked, the fuel card, the controls' title
              // and row, More controls.
              // Redactable: the group pulses while loading, holds still offline.
              column gap=16 testId="skeleton" animation=(online ? "pending 800ms ease-in-out infinite alternate" : "none") animation-timeline=Activity
                column class=Card height=265 padding-right=16 padding-bottom=16 box-sizing="border-box" justify-content="flex-end" align-items="flex-end"
                  box width=148 height=48 border-radius=24 background-color="tertiary-fill"
                column class=Card padding=16 gap=12
                  row justify-content="space-between"
                    box width=72 height=16 border-radius=6 background-color="tertiary-fill"
                    box width=110 height=16 border-radius=6 background-color="tertiary-fill"
                  box height=8 border-radius=4 background-color="tertiary-fill"
                column gap=8
                  box width=140 height=17 border-radius=6 margin-left=8 background-color="tertiary-fill"
                  row gap=8
                    box flex=1 height=76 border-radius=18 background-color="secondary-grouped-background"
                    box flex=1 height=76 border-radius=18 background-color="secondary-grouped-background"
                    box flex=1 height=76 border-radius=18 background-color="secondary-grouped-background"
                column class=Card height=80
            when car.vin != ""
              // Hero card (hero-card.ios.tsx): the car over its parked map.
              column class=Card testId="hero" overflow="hidden" align-items="center" gap=8 padding-top=8 padding-bottom=16 padding-left=16 padding-right=16 position="relative"
                when status.ok and (status.latitude != 0 or status.longitude != 0)
                  // The map fades itself in, so the dimming is its box's.
                  column position="absolute" top=0 right=0 bottom=0 left=0 opacity=0.48
                    lexy-map width="100%" height="100%" latitude=status.latitude longitude=status.longitude zoom=16 pin="false" places="false" interactive="false"
                // The veil, the car and the button row let a touch through to
                // the map below them, whose Legal link MapKit requires to work.
                box position="absolute" top=0 right=0 bottom=0 left=0 background-color="light-dark(#ffffff38, #1c1c1e38)" pointer-events="none"
                // hero-card.ios.tsx: the render at 110% width (700×631), centred and
                // clipped to a 185pt frame, which trims its empty margins.
                row width="100%" height=185 overflow="hidden" align-items="center" justify-content="center" pointer-events="none"
                  when car.image != ""
                    image car.image aria-label=car.description width="110%" aspect-ratio="700 / 631" flex-shrink=0 object-fit="contain"
                row width="100%" justify-content="flex-end" pointer-events="none"
                  button press=openMap pointer-events="auto" testId="last-parked" -exact-apple-button-style="glass" width=148 height=48 border-radius=24 display="flex" flex-direction="row" align-items="center" justify-content="center" gap=4
                    image "symbol:sf/map.fill" font-size=15 tint-color="system-blue" object-fit="scale-down" width=20 height=18
                    text "Last Parked" font-size=15 font-weight=600 color="label"
              // Fuel (fuel-bar.tsx)
              column class=Card testId="fuel" padding=16 gap=8
                row justify-content="space-between" align-items="center"
                  row gap=4 align-items="center"
                    image `symbol:sf/${(electric ? "bolt.fill" : "fuelpump.fill")}` font-size=17 tint-color=c(fuelTint(fuel)) object-fit="scale-down" width=17 height=17
                    text (electric ? "Charge" : "Fuel") class=SmallBold color="secondary-label"
                  row
                    text (fuel >= 100 ? "Full" : `${fuel}%`) testId="fuel-value" class=SmallBold color=c(fuelText(fuel)) font-variant-numeric="tabular-nums"
                    text ` · ${grouped(status.range)} ${unit}` testId="range" class=SmallBold color="label" font-variant-numeric="tabular-nums"
                row gap=4
                  box flex=1 height=8 border-radius=4 background-color="tertiary-fill" overflow="hidden"
                    box height="100%" border-radius=4 width=`${min(100, max(0, fuel * 4))}%` background-color=c(fuelTint(fuel))
                  box flex=1 height=8 border-radius=4 background-color="tertiary-fill" overflow="hidden"
                    box height="100%" border-radius=4 width=`${min(100, max(0, (fuel - 25) * 4))}%` background-color=c(fuelTint(fuel))
                  box flex=1 height=8 border-radius=4 background-color="tertiary-fill" overflow="hidden"
                    box height="100%" border-radius=4 width=`${min(100, max(0, (fuel - 50) * 4))}%` background-color=c(fuelTint(fuel))
                  box flex=1 height=8 border-radius=4 background-color="tertiary-fill" overflow="hidden"
                    box height="100%" border-radius=4 width=`${min(100, max(0, (fuel - 75) * 4))}%` background-color=c(fuelTint(fuel))
              // Remote controls (vehicle-controls.ios.tsx)
              column gap=8 testId="controls"
                row justify-content="space-between" align-items="center" gap=16
                  text "REMOTE CONTROLS" class=CardTitle margin-top=4
                  row gap=8 margin-right=8 align-items="center"
                    // Always drawn: "Locked" only when every reporting door is.
                    when true
                      row gap=4 align-items="center" testId="lock-state"
                        image `symbol:sf/${((lockPending ? lockTarget == "locked" : doorLock == "locked") ? "lock.fill" : "lock.open.fill")}` font-size=13 tint-color=c(((lockPending ? lockTarget == "locked" : doorLock == "locked") ? "green" : "orange")) object-fit="scale-down" width=13 height=13
                        text (lockPending ? (lockTarget == "locked" ? "Locking" : "Unlocking") : (doorLock == "locked" ? "Locked" : "Unlocked")) class=SmallBold color=c((lockPending ? lockTarget == "locked" : doorLock == "locked") ? "green" : "orange") animation=(lockPending ? "pending 800ms ease-in-out infinite alternate" : "none") animation-timeline=Pending
                    // No reading yet, no indicator (vehicle-controls.ios.tsx).
                    when canEngine and (engineKnown or enginePending)
                      row gap=4 align-items="center" testId="engine-state"
                        image "symbol:sf/power" font-size=13 tint-color=c((engineRunning ? "green" : "secondary")) object-fit="scale-down" width=13 height=13
                        text (enginePending ? (engineTarget == "running" ? "Starting" : "Stopping") : (engineRunning ? "Started" : "Stopped")) class=SmallBold color=c(engineRunning ? "green" : "secondary") animation=(enginePending ? "pending 800ms ease-in-out infinite alternate" : "none") animation-timeline=Pending
                // vehicle-controls.ios.tsx: Lock, Unlock and Start/Stop, always.
                row gap=8
                  ControlButton(command="door-lock", label="Lock", symbol="lock.fill", tint="green", title="Lock your vehicle?", message="This locks all doors.", action="Lock", destructive=false, disabled=busy, glass=true, iconSize=20, run=run)
                  ControlButton(command="door-unlock", label="Unlock", symbol="lock.open.fill", tint="orange", title="Unlock your vehicle?", message="This unlocks the doors. Only do this when you’re near the vehicle.", action="Unlock", destructive=true, disabled=busy, glass=true, iconSize=20, run=run)
                  when engineRunning
                    ControlButton(command="engine-stop", label="Stop", symbol="power", tint="red", title="Stop the engine?", message="This ends the remote start.", action="Stop Engine", destructive=false, disabled=busy, glass=true, iconSize=20, run=run)
                  else
                    ControlButton(command="engine-start", label="Start", symbol="power", tint="blue", title="Remotely start the engine?", message="Never remotely start the engine in an enclosed space, or with a child or pet inside the vehicle.", action="Start Engine", destructive=true, disabled=busy, glass=true, iconSize=20, run=run)
                when length(extras) > 0
                  column class=Card margin-top=8 overflow="hidden" testId="more-controls"
                    button press=toggleMore testId="toggle-more" min-height=56 padding-top=12 padding-bottom=12 box-sizing="content-box" padding-left=16 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                      // expandable-card.tsx: the badge and words 12 apart, the chevron 8.
                      row flex=1 min-width=0 align-items="center" gap=12
                        box width=36 height=36 border-radius=18 background-color=wash("blue") display="flex" align-items="center" justify-content="center"
                          image "symbol:sf/slider.horizontal.3" font-size=16 tint-color="system-blue" object-fit="scale-down" width=22 height=20
                        column flex=1 min-width=0 gap=2
                          text "More controls" font-size=17 font-weight=600 color="label"
                          text extrasText font-size=13 color="secondary-label"
                      image "symbol:sf/chevron.right" font-size=14 font-weight=600 tint-color="secondary-label" object-fit="scale-down" width=16 height=20 rotate=(moreOpen ? 90 : 0) transition="rotate 300ms ease-in-out"
                    // expandable-card.tsx: the detail's height eases from 0 to its own
                    // over 300 ms (EXPAND_TIMING), clipped, with the chevron.
                    column box-sizing="border-box" overflow="hidden" height=(moreOpen ? "auto" : "0px") interpolate-size="allow-keywords" transition="height 300ms ease-in-out" inert=(not moreOpen) testId="more-detail"
                      row flex-wrap="wrap" gap=8 padding-left=16 padding-right=16 padding-bottom=16
                        when can(car.capabilities, "trunkLockUnlockCapable")
                          column width="calc(33.333% - 5.34px)"
                            ControlButton(command="trunk-lock", label="Lock Trunk", symbol="car.side.rear.crop.trunk.partition.fill", tint="green", title="Lock the trunk?", message="This locks the trunk.", action="Lock Trunk", destructive=false, disabled=busy, glass=false, iconSize=20, run=run)
                          column width="calc(33.333% - 5.34px)"
                            ControlButton(command="trunk-unlock", label="Unlock Trunk", symbol="car.side.rear.crop.trunk.partition", tint="orange", title="Unlock the trunk?", message="This unlocks the trunk. Only do this when you’re near the vehicle.", action="Unlock Trunk", destructive=true, disabled=busy, glass=false, iconSize=20, run=run)
                        when can(car.capabilities, "hazardCapable")
                          column width="calc(33.333% - 5.34px)"
                            when hazardsOn
                              ControlButton(command="hazard-off", label="Hazards Off", symbol="car.rear.hazardsign", tint="blue", title="Turn off the hazards?", message="This stops the hazard lights.", action="Turn Off", destructive=false, disabled=busy, glass=false, iconSize=20, run=run)
                            else
                              ControlButton(command="hazard-on", label="Hazard Lights", symbol="car.rear.hazardsign.fill", tint="red", title="Flash the hazards?", message="The hazard lights start flashing until you turn them off.", action="Turn On", destructive=false, disabled=busy, glass=false, iconSize=20, run=run)
                        when can(car.capabilities, "lightsCapable")
                          column width="calc(33.333% - 5.34px)"
                            ControlButton(command="headlight-on", label="Flash Lights", symbol="headlight.low.beam.fill", tint="cyan", title="Flash the headlights?", message="The headlights come on to help you find the vehicle.", action="Flash", destructive=false, disabled=busy, glass=false, iconSize=19, run=run)
                        when can(car.capabilities, "buzzerCapable")
                          column width="calc(33.333% - 5.34px)"
                            ControlButton(command="buzzer-warning", label="Play Beeps", symbol="bell.and.waves.left.and.right.fill", tint="yellow", title="Sound the buzzer?", message="The vehicle beeps ten times.", action="Play Beeps", destructive=false, disabled=busy, glass=false, iconSize=18, run=run)
                        when can(car.capabilities, "hornCapable")
                          column width="calc(33.333% - 5.34px)"
                            ControlButton(command="sound-horn", label="Honk Horn", symbol="horn.blast.fill", tint="orange", title="Sound the horn?", message="The vehicle will sound its horn. Be sure not to startle anyone.", action="Honk Horn", destructive=true, disabled=busy, glass=false, iconSize=17, run=run)
              // Remote-start climate (climate-card.ios.tsx). Every control
              // is disabled while a change is being written (and read back),
              // so a second change can't race the first; a disabled control
              // takes no press, so it plays no haptic either.
              // climate-card.ios.tsx: the header always shows; the switch
              // only with settings (a placeholder while they load).
              when true
                column class=Card testId="climate" padding=16 gap=16
                  column gap=4
                    row justify-content="space-between" align-items="center"
                      row gap=4 align-items="center"
                        image "symbol:sf/thermometer.medium" font-size=17 tint-color="system-blue" object-fit="scale-down" width=17 height=17
                        text "Remote Start Climate" class=SmallBold color="secondary-label"
                      when climate.ok
                        input type="checkbox" switch checked=(climateSaving ? climateWanted : climate.on) change=setClimateOn disabled=climateSaving aria-label="Remote start climate" testId="climate-switch" margin-right=8
                      when climateLoading and not climate.ok
                        box width=63 height=28 border-radius=14 margin-right=6 background-color="tertiary-fill"
                    text "Settings for when you start your vehicle remotely." class=Small color="secondary-label"
                  when climate.ok
                    column gap=16 opacity=(climate.on ? 1 : 0.4) transition="opacity 250ms ease"
                      // Hidden when the settings carry no range.
                      when climate.max > climate.min
                        row gap=16 align-items="center"
                          input type="range" min=climate.min max=climate.max step=climate.step value=temperature input=dragTemperature change=setTemperature disabled=(not climate.on or climateSaving) aria-label="Temperature" testId="climate-temperature" flex=1 height=28
                          text `${floor(temperature * 10 + 0.5) / 10}°${climate.unit}` class=SmallBold min-width=52 text-align="right" font-variant-numeric="tabular-nums"
                      when climate.front or climate.rear
                        row gap=8
                          when climate.front
                            button press=toggleDefrost("front") disabled=(not climate.on or climateSaving) testId="defrost-front" -exact-apple-button-style="plain" flex=1 padding-top=8 padding-bottom=8 border-radius=12 background-color=(frontDefrost ? defrostOnColor() : "quaternary-fill") display="flex" flex-direction="row" align-items="center" justify-content="center" gap=4
                              image "symbol:sf/windshield.front.and.heat.waves" font-size=17 tint-color=c((frontDefrost ? "blue" : "secondary")) object-fit="scale-down" width=22 height=20
                              text "Front Defrost" class=Small color=c(frontDefrost ? "blue" : "secondary")
                          when climate.rear
                            button press=toggleDefrost("rear") disabled=(not climate.on or climateSaving) testId="defrost-rear" -exact-apple-button-style="plain" flex=1 padding-top=8 padding-bottom=8 border-radius=12 background-color=(rearDefrost ? defrostOnColor() : "quaternary-fill") display="flex" flex-direction="row" align-items="center" justify-content="center" gap=4
                              image "symbol:sf/windshield.rear.and.heat.waves" font-size=17 tint-color=c((rearDefrost ? "blue" : "secondary")) object-fit="scale-down" width=22 height=20
                              text "Rear Defrost" class=Small color=c(rearDefrost ? "blue" : "secondary")
              // Doors & windows (closures-summary.ios.tsx)
              when length(rows) > 0
                column gap=8 testId="closures"
                  text "DOORS & WINDOWS" class=CardTitle margin-top=4
                  column class=Card overflow="hidden"
                    button press=toggleClosures testId="toggle-closures" min-height=44 padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                      // expandable-card.tsx: the badge and words 12 apart, the chevron 8.
                      row flex=1 min-width=0 align-items="center" gap=12
                        box width=36 height=36 border-radius=18 background-color=wash(verdictTint) display="flex" align-items="center" justify-content="center"
                          image `symbol:sf/${verdictSymbol}` font-size=18 tint-color=c(verdictTint) object-fit="scale-down" width=24 height=22
                        column flex=1 min-width=0 gap=2
                          text headline testId="closures-headline" font-size=17 font-weight=600 color="label" line-clamp=1
                          text subline font-size=13 color="secondary-label" line-clamp=1
                      image "symbol:sf/chevron.right" font-size=14 font-weight=600 tint-color="secondary-label" object-fit="scale-down" width=16 height=20 rotate=(closuresOpen ? 90 : 0) transition="rotate 300ms ease-in-out"
                    column box-sizing="border-box" overflow="hidden" height=(closuresOpen ? "auto" : "0px") interpolate-size="allow-keywords" transition="height 300ms ease-in-out" inert=(not closuresOpen) testId="closures-detail"
                      column gap=16 padding-top=2 padding-left=16 padding-right=16 padding-bottom=16
                        when length(filter(corners, s => includes(cornerOf(s), "front-"))) > 0
                          row gap=16 align-items="flex-start"
                            Corner(title="Front driver", driver=true, door=first(filter(corners, s => cornerOf(s) == "front-driver" and partOf(s) == "door")), window=first(filter(corners, s => cornerOf(s) == "front-driver" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                            Corner(title="Front passenger", driver=false, door=first(filter(corners, s => cornerOf(s) == "front-passenger" and partOf(s) == "door")), window=first(filter(corners, s => cornerOf(s) == "front-passenger" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                        when length(filter(corners, s => includes(cornerOf(s), "rear-"))) > 0
                          row gap=16 align-items="flex-start"
                            Corner(title="Rear driver", driver=true, door=first(filter(corners, s => cornerOf(s) == "rear-driver" and partOf(s) == "door")), window=first(filter(corners, s => cornerOf(s) == "rear-driver" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                            Corner(title="Rear passenger", driver=false, door=first(filter(corners, s => cornerOf(s) == "rear-passenger" and partOf(s) == "door")), window=first(filter(corners, s => cornerOf(s) == "rear-passenger" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                        when length(openings) > 0
                          column gap=8
                            // closures.ts OPENING_ORDER: moonroof, trunk, hood.
                            each o in filter(openings, o => includes(o.section, "Moon")) key=o.section
                              StatusLine(symbol="moon.fill", pointsize=13, tint=(isOpen(o) ? "orange" : "green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                            each o in filter(openings, o => includes(o.section, "Trunk")) key=o.section
                              StatusLine(symbol="car.side.rear.crop.trunk.partition.fill", pointsize=15, tint=(isOpen(o) ? "orange" : "green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                            each o in filter(openings, o => includes(o.section, "Hood")) key=o.section
                              StatusLine(symbol="engine.combustion.fill", pointsize=12, tint=(isOpen(o) ? "orange" : "green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                            each o in filter(openings, o => not includes(o.section, "Moon") and not includes(o.section, "Trunk") and not includes(o.section, "Hood")) key=o.section
                              StatusLine(symbol=(includes(o.section, "Moon") ? "moon.fill" : (includes(o.section, "Hood") ? "engine.combustion.fill" : "car.side.rear.crop.trunk.partition.fill")), pointsize=(includes(o.section, "Trunk") ? 15 : (includes(o.section, "Moon") ? 13 : 12)), tint=(isOpen(o) ? "orange" : "green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                  // closures-summary.ios.tsx StaleNote: some readings weren't in the
                  // latest snapshot (windows after a drive), so say how old.
                  when status.closuresStaleMs > 0
                    row testId="closures-stale" justify-content="center" align-items="center" gap=4
                      image "symbol:sf/clock.arrow.circlepath" font-size=12 tint-color="secondary-label" object-fit="scale-down" width=12 height=12
                      text `Some readings as of ${relative(clock, status.closuresStaleMs)}` font-size=13 line-height="18px" color="secondary-label"
              // Odometer (odometer-card.tsx)
              column gap=8 testId="odometer"
                text "ODOMETER" class=CardTitle margin-top=4
                row class=Card padding=16 align-items="center" gap=8
                  column flex=1 gap=4
                    row gap=4 align-items="center"
                      image "symbol:sf/gauge.with.dots.needle.67percent" font-size=17 tint-color="secondary-label" object-fit="scale-down" width=17 height=17
                      text "Total" class=SmallBold color="secondary-label"
                    row gap=3 align-items="flex-end"
                      text grouped(status.odometer) testId="odometer-value" font-size=17 line-height="22px" font-weight=600 font-variant-numeric="tabular-nums"
                      text odoUnit class=Small color="secondary-label"
                  row flex=2 gap=8 padding-top=8 padding-bottom=8 padding-left=16 padding-right=16 border-radius=12 background-color="quaternary-fill"
                    column flex=1 gap=4
                      text "Trip A" class=SmallBold color="secondary-label"
                      row gap=3 align-items="flex-end"
                        text tenths(status.tripA) font-size=17 line-height="22px" font-weight=600 font-variant-numeric="tabular-nums"
                        text odoUnit class=Small color="secondary-label"
                    column flex=1 gap=4
                      text "Trip B" class=SmallBold color="secondary-label"
                      row gap=3 align-items="flex-end"
                        text tenths(status.tripB) font-size=17 line-height="22px" font-weight=600 font-variant-numeric="tabular-nums"
                        text odoUnit class=Small color="secondary-label"
              // Tire pressure (tire-pressure-card.tsx)
              when tires.ok and length(tires.tires) > 0
                column gap=8 testId="tires"
                  text "TIRE PRESSURE" class=CardTitle margin-top=4
                  row class=Card padding=16 gap=32 align-self="flex-start"
                    column gap=16
                      each t in filter(tires.tires, t => t.position == "flTirePressure" or t.position == "rlTirePressure") key=t.position
                        column gap=2 testId=`tire-${t.position}`
                          text tireLabel(t.position) class=SmallBold color="secondary-label"
                          row align-items="baseline"
                            text `${t.value}` font-size=15 line-height="20px" font-weight=600 color=c(t.low ? "orange" : "label") font-variant-numeric="tabular-nums"
                            text ` ${tires.unit}` class=Small color="secondary-label"
                    column gap=16
                      each t in filter(tires.tires, t => t.position == "frTirePressure" or t.position == "rrTirePressure") key=t.position
                        column gap=2 testId=`tire-${t.position}`
                          text tireLabel(t.position) class=SmallBold color="secondary-label"
                          row align-items="baseline"
                            text `${t.value}` font-size=15 line-height="20px" font-weight=600 color=c(t.low ? "orange" : "label") font-variant-numeric="tabular-nums"
                            text ` ${tires.unit}` class=Small color="secondary-label"
              // When it last synced (status-screen.ios.tsx footer)
              // status-screen.ios.tsx FooterTimeRow: a tap shows the exact time
              // in a popover anchored to the sentence.
              column align-items="center" gap=2 padding-top=24 testId="synced"
                button popovertarget="synced-at" testId="synced-line" -exact-apple-button-style="plain"
                  text (status.ok ? `Vehicle last synced with Lexus ${relative(clock, (checkedAt > 0 ? min(status.occurredMs, checkedAt) : status.occurredMs))}.` : "Vehicle last synced with Lexus unknown.") font-size=13 color="secondary-label" text-align="center"
                column id="synced-at" popover="auto" position="absolute" padding=16
                  text exactTime((checkedAt > 0 ? min(status.occurredMs, checkedAt) : status.occurredMs), utcOffset) font-size=16
                button popovertarget="checked-at" testId="checked-line" -exact-apple-button-style="plain"
                  text (updating and not refreshing ? "Updating…" : `Lexy checked for data ${relative(clock, checkedAt)}.`) font-size=13 color="secondary-label" text-align="center"
                column id="checked-at" popover="auto" position="absolute" padding=16
                  text exactTime(checkedAt, utcOffset) font-size=16
      RefreshingNote(visible=(updating and not refreshing))
