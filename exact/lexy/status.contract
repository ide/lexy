                              for o in openings.filter(o => o.section.includes("Trunk")) key=o.section
                                StatusLine(symbol="car.side.rear.crop.trunk.partition.fill", pointsize=15, tint=(isOpen(o) ? "-exact-system-orange" : "-exact-system-green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                              for o in openings.filter(o => o.section.includes("Hood")) key=o.section
                                StatusLine(symbol="engine.combustion.fill", pointsize=12, tint=(isOpen(o) ? "-exact-system-orange" : "-exact-system-green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                              for o in openings.filter(o => not o.section.includes("Moon") and not o.section.includes("Trunk") and not o.section.includes("Hood")) key=o.section
                                StatusLine(symbol=(o.section.includes("Moon") ? "moon.fill" : (o.section.includes("Hood") ? "engine.combustion.fill" : "car.side.rear.crop.trunk.partition.fill")), pointsize=(o.section.includes("Trunk") ? 15 : (o.section.includes("Moon") ? 13 : 12)), tint=(isOpen(o) ? "-exact-system-orange" : "-exact-system-green"), words=`${o.section} ${isOpen(o) ? "open" : "closed"}`)
                    // closures-summary.ios.tsx StaleNote: some readings weren't in the
