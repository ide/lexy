                          if status.ok
                            text odoUnit class=Small color="-exact-secondary-label"
                // Tire pressure (tire-pressure-card.tsx)
                if tires.ok and tires.tires.length > 0
                  column gap=8 testId="tires" grid-column=(wide ? "1" : "auto") grid-row=(wide ? "5" : "auto") margin-left=(fold == "across" ? "16px" : "0px") width=(fold == "across" ? "calc(env(viewport-segment-width 0 0) - env(safe-area-inset-left) - 32px)" : "auto") box-sizing="border-box"
                    text "Tire Pressure" role="heading" aria-level=2 class=SectionTitle margin-top=4
