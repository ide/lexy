                              Corner(title="Front driver", driver=true, door=first(corners.filter(s => cornerOf(s) == "front-driver" and partOf(s) == "door")), window=first(corners.filter(s => cornerOf(s) == "front-driver" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                              Corner(title="Front passenger", driver=false, door=first(corners.filter(s => cornerOf(s) == "front-passenger" and partOf(s) == "door")), window=first(corners.filter(s => cornerOf(s) == "front-passenger" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                          if corners.filter(s => cornerOf(s).includes("rear-")).length > 0
