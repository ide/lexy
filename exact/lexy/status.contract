                              text `${floor(temperature * 10 + 0.5) / 10}°${climate.unit}` class=SmallBold min-width=52 text-align="right" font-variant-numeric="tabular-nums"
                          if climate.front or climate.rear
                            row gap=8
                              if climate.front
                                button press=toggleDefrost("front") testId="defrost-front" appearance="auto" buttonStyle=(frontDefrost ? "tinted" : "gray") -exact-control-size="small" flex=1 padding-top=8 padding-bottom=8 border-radius=12 display="flex" flex-direction="row" align-items="center" justify-content="center"
                                  image "symbol:icon.windshield.front.and.heat.waves" -exact-tint-color=(frontDefrost ? "AccentColor" : "-exact-secondary-label")
                                  text "Front Defrost" color=(frontDefrost ? "AccentColor" : "-exact-secondary-label")
                              if climate.rear
