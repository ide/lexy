// The Status tab (src/screens/status-screen.ios.tsx and src/features/vehicle):
// the car over its parked map, fuel, remote controls, remote-start climate,
// doors and windows, odometer, tires, and when it last synced.
use SafeScroll from "./model.contract"
use bannerGlide from "./model.contract"
use Garage from "./model.contract"
use Status from "./model.contract"
use Tires from "./model.contract"
use Section from "./model.contract"
use Climate from "./model.contract"
use Card from "./model.contract"
use Banner from "./model.contract"
use SectionTitle from "./model.contract"
use Small from "./model.contract"
use SmallBold from "./model.contract"
use can from "./model.contract"
use isCorner from "./model.contract"
use cornerOf from "./model.contract"
use partOf from "./model.contract"
use closureName from "./model.contract"
use isOpen from "./model.contract"
use lowerName from "./model.contract"
use isUnlocked from "./model.contract"
use reports from "./model.contract"
use any from "./model.contract"
use round from "./model.contract"
use grouped from "./model.contract"
use tenths from "./model.contract"
use exactTime from "./model.contract"
use distanceUnit from "./model.contract"
use tireLabel from "./model.contract"
use failureSummary from "./model.contract"
use failureAdvice from "./model.contract"
use failureDetail from "./model.contract"
use fuelTint from "./model.contract"
use fuelText from "./model.contract"
use extraName from "./model.contract"
use capitalized from "./model.contract"
use wash from "./model.contract"
use Activity from "./model.contract"

// One remote control (vehicle-controls.ios.tsx): a filled button over a symbol
// and its name, and the confirmation it asks for: a modal dialog of title,
// message, one action and a cancel, which iOS presents as its alert.
// climate-card.ios.tsx: an active defrost chip is the blue wash over the
// chip's grey, on the card (composited, one colour).

// Share the pulse phase across pending lock and engine labels
timeline Pending

keyframes pending
  from opacity=0.4
  to opacity=1

// A banner lies under what follows it, which glides down to uncover it as it
// fades in, and back over it as it fades out: a node that leaves keeps its
// place in paint order (LLP 1083 D4). Under Reduce Motion nothing glides. The
// exit is one literal, the same with or without Reduce Motion: the web's JS
// target takes no dynamic exit animation
keyframes bannerIn
  from opacity=0
keyframes bannerOut
  to opacity=0
fn bannerEnter(still: bool): string = still ? "bannerIn 200ms ease-out both" : "bannerIn 250ms ease-out both"

// The climate card breathes while a change is written to the car.
keyframes climateWriting
  from opacity=1
  to opacity=0.6

component ControlButton
  props
    command: string
    label: string
    symbol: string
    tint: string
    title: string
    message: string
    action: string
    destructive: bool
    disabled: bool
    glass: bool
    // vehicle-controls.ios.tsx sizes some symbols down (iconSize).
    iconSize: number
    run: action
  view
    column flex=1 min-width=0
      button commandfor=`confirm-${command}` command="show-modal" disabled=disabled testId=`command-${command}` aria-label=label appearance="auto" buttonStyle="filled" accent-color=(glass ? "-exact-secondary-grouped-background" : "-exact-quaternary-fill") height=76 border-radius=18 padding-left=6 padding-right=6 display="flex" flex-direction="column" align-items="center" justify-content="center"
        image `symbol:icon.${symbol}` font-size=iconSize -exact-tint-color=tint
        text label font-size=13 font-weight=600 color="-exact-label" line-clamp=1
      dialog id=`confirm-${command}` role="alertdialog" aria-label=title
        text message
        button destructive=destructive press=run(command) commandfor=`confirm-${command}` command="close" testId=`confirm-${command}`
          text action
        button commandfor=`confirm-${command}` command="close" testId=`cancel-${command}`
          text "Cancel"

// vehicle-state.ios.tsx StateScreen: a whole screen saying why there is
// nothing to show, and the one thing to do about it.
component VehicleState
  props
    symbol: string
    title: string
    message: string
    label: string
    press: action
    // A retry it started is out: the state stays, its button disabled
    busy: bool
    id: string
  view
    // In the scroller's flow, at its natural height with some padding: it
    // takes the room left under any banner and centres in it, and on a
    // phone too short for it the screen scrolls a little instead.
    // The text keeps one measure wherever the state sits (Status pads its
    // column, Specs does not), so it wraps the same on both.
    column flex-grow=1 justify-content="center" align-items="center" gap=16 padding-top=32 padding-bottom=32 testId=id
      image `symbol:icon.${symbol}` font-size=44 color="-exact-secondary-label"
      text title role="heading" aria-level=2 text-align="center" max-width=320
      text message font-size=17 color="-exact-secondary-label" text-align="center" max-width=320
      button press=press disabled=busy testId=`${id}-retry` appearance="auto" buttonStyle="prominent-glass" accent-color="AccentColor" height=50 border-radius=25 padding-left=16 padding-right=16 display="flex" align-items="center" justify-content="center"
        text label font-size=17

// status-banner.tsx's amber banner: a symbol, a bold line and a lighter one.
component WarningBanner
  props
    id: string
    symbol: string
    // The triangle sits in a 22-point frame; the wifi glyph at its own size.
    framed: bool
    title: string
    message: string
    // Reduce Motion: the banner only fades
    still: bool
    // The space above it, which comes and goes with it
    above: string
  view
    // It comes and goes with its `if`, so its own exit plays
    row testId=id margin-top=above class=Banner background-color=wash("-exact-system-orange") animation=bannerEnter(still) -exact-exit-animation="bannerOut 250ms ease-in both"
      if framed
        image `symbol:icon.${symbol}` font-size=17 color="-exact-system-orange" object-fit="scale-down" width=22 height=22
      else
        image `symbol:icon.${symbol}` font-size=17 color="-exact-system-orange"
      column gap=2 flex=1
        text title class=SmallBold color="-exact-system-orange"
        text message class=Small color="-exact-system-orange" opacity=0.85

// A status line in a corner of Doors & Windows: symbol, then words.
component StatusLine
  props
    symbol: string
    pointsize: number
    tint: string
    words: string
  view
    row gap=4 align-items="center"
      image `symbol:icon.${symbol}` font-size=pointsize color=tint object-fit="scale-down" width=22 height=20
      text words font-size=15 color="-exact-label"

// A corner of the car: its door and window (closures-summary.ios.tsx).
component Corner
  props
    title: string
    driver: bool
    door: option<Section>
    window: option<Section>
    lockPending: bool
    lockTarget: string
  view
    column flex=1 min-width=0 gap=8 testId=`corner-${title}`
      text title font-size=14 font-weight=700 color="-exact-secondary-label"
      match door
        case some(d)
          if isOpen(d)
            StatusLine(symbol="lock.open.fill", pointsize=15, tint="-exact-system-orange", words="Door open")
          else
            if lockPending
              StatusLine(symbol=(lockTarget == "locked" ? "lock.fill" : "lock.open.fill"), pointsize=15, tint=(lockTarget == "locked" ? "-exact-system-green" : "-exact-system-orange"), words=(lockTarget == "locked" ? "Locking…" : "Unlocking…"))
            else
              if isUnlocked(d)
                StatusLine(symbol="lock.open.fill", pointsize=15, tint="-exact-system-orange", words="Door unlocked")
              else
                if any(d.values, "Locked")
                  StatusLine(symbol="lock.fill", pointsize=15, tint="-exact-system-green", words="Door locked")
                else
                  StatusLine(symbol="checkmark.circle.fill", pointsize=15, tint="-exact-system-green", words="Door closed")
        case none
          box
      match window
        case some(w)
          StatusLine(symbol=(driver ? "car.window.right" : "car.window.left"), pointsize=12, tint=(isOpen(w) ? "-exact-system-orange" : "-exact-system-green"), words=(isOpen(w) ? "Window open" : "Window closed"))
        case none
          box

component StatusScreen
  props
    garage: Garage
    status: Status
    tires: Tires
    climate: Climate
    engineRunning: bool
    enginePending: bool
    engineTarget: string
    lockPending: bool
    lockTarget: string
    doorLock: string
    hazardsOn: bool
    busy: bool
    refreshing: bool
    // The hero's breath while a refresh runs (app.contract `pulseDim`):
    // the card eases to it as one group, down and back up, never jumping,
    // so the car never shows the map through it.
    heroDim: bool
    loading: bool
    retrying: bool
    // Developer mode: failures name their read, status and Lexus's words
    developer: bool
    // Reduce Motion: banners fade without moving, and nothing glides
    still: bool
    // Until both the car and its status are in: the skeleton, not the cards.
    firstLoad: bool
    notice: string
    checkedAt: number
    moreOpen: bool
    wide: bool
    fold: string
    closuresOpen: bool
    climateLoading: bool
    // A change on its way to the car: the card pulses until it lands.
    climateWriting: bool
    utcOffset: number
    online: bool
    commandError: string
    climateError: string
    engineKnown: bool
    climateWanted: bool
    // Each defrost as shown: the tapped value while it saves.
    frontDefrost: bool
    rearDefrost: bool
    reload: action
    run: action
    openMap: action
    toggleMore: action
    toggleClosures: action
    setClimateOn: action
    setTemperature: action
    // The setpoint shown: the one under the finger, else the car's.
    temperature: number
    dragTemperature: action
    toggleDefrost: action
  derive car = garage.car
  derive failureNote = developer ? ` ${(not garage.ok ? failureDetail("Vehicle list", garage.status, garage.error) : failureDetail("Status", status.status, status.error))}` : ""
  // The car's own stamp, clamped to the read that brought it.
  derive syncedMs = checkedAt > 0 ? min(status.occurredMs, checkedAt) : status.occurredMs
  derive engineWord = enginePending ? (engineTarget == "running" ? "Starting" : "Stopping") : (engineRunning ? "Started" : "Stopped")
  derive rows = status.sections.filter(s => s.category != "Trip Details" and reports(s))
  derive corners = rows.filter(s => isCorner(s))
  derive openings = rows.filter(s => not isCorner(s))
  derive doorRows = corners.filter(s => partOf(s) == "door")
  derive openRows = rows.filter(s => isOpen(s))
  derive lockState = lockPending ? lockTarget : doorLock
  derive lockWord = lockPending ? (lockTarget == "locked" ? "Locking" : "Unlocking") : (doorLock == "locked" ? "Locked" : (doorLock == "unlocked" ? "Unlocked" : "Unknown"))
  derive lockColor = lockState == "locked" ? "-exact-system-green" : (lockState == "unlocked" ? "-exact-system-orange" : "-exact-secondary-label")
  derive unlockedRows = rows.filter(s => isUnlocked(s) and not isOpen(s))
  derive issues = openRows.length + unlockedRows.length
  derive allLocked = doorRows.length > 0 and doorRows.filter(d => any(d.values, "Locked")).length == doorRows.length
  // closure-summary.ts: the verdict the card leads with.
  derive single = match first(openRows) { case some(s) => `${closureName(s)} open`, case none => match first(unlockedRows) { case some(s) => `${closureName(s)} unlocked`, case none => "" } }
  derive headline = lockPending ? (lockTarget == "locked" ? "Locking…" : "Unlocking…") : (issues == 0 ? (allLocked ? "All secure" : "All closed") : (issues == 1 ? single : (openRows.length == 0 ? `${unlockedRows.length} doors unlocked` : (unlockedRows.length == 0 ? `${openRows.length} open` : `${openRows.length} open, ${unlockedRows.length} unlocked`))))
  // closure-summary.ts settledGroups/restSubline: the subline names only
  // what was read and is settled — doors, then windows and each opening.
  derive settledDoors = doorRows.filter(d => not isOpen(d) and not isUnlocked(d))
  derive doorsPart = settledDoors.length == 0 ? "" : (settledDoors.filter(d => any(d.values, "Locked")).length == settledDoors.length ? "Doors locked" : "Doors closed")
  derive settledWindows = corners.filter(s => partOf(s) == "window" and not isOpen(s))
  derive settledOpenings = openings.filter(o => not isOpen(o) and not isUnlocked(o))
  derive restCount = (settledWindows.length > 0 ? 1 : 0) + settledOpenings.length
  derive o1 = match first(settledOpenings) { case some(o) => o.section, case none => "" }
  derive o2 = settledOpenings.filter((o, i) => i == 1).map(o => lowerName(o.section)).join("")
  derive restText = restCount == 0 ? "" : (restCount >= 3 ? "Everything else closed" : (settledWindows.length > 0 ? (restCount == 1 ? "Windows closed" : `Windows and ${lowerName(o1)} closed`) : (restCount == 1 ? `${o1} closed` : `${o1} and ${o2} closed`)))
  derive subline = lockPending ? restText : (issues == 0 ? (doorsPart != "" and restText != "" ? `${doorsPart} · ${restText}` : `${doorsPart}${restText}`) : ((doorsPart != "" ? 1 : 0) + restCount == 0 ? "" : (doorsPart == "Doors locked" ? "Everything else closed and locked" : "Everything else closed")))
  // The one exception's own symbol: a door, a window, an opening.
  derive singleSymbol = match first(openRows) { case some(s) => (isCorner(s) ? (partOf(s) == "door" ? "lock.open.fill" : (s.category.includes("Passenger") ? "car.window.left" : "car.window.right")) : (s.section.includes("Moon") ? "moon.fill" : (s.section.includes("Hood") ? "engine.combustion.fill" : "car.side.rear.crop.trunk.partition.fill"))), case none => "lock.open.fill" }
  derive verdictTint = lockPending ? "-exact-secondary-label" : (issues == 0 ? "-exact-system-green" : "-exact-system-orange")
  derive verdictSymbol = lockPending ? (lockTarget == "locked" ? "lock.fill" : "lock.open.fill") : (issues == 0 ? (allLocked ? "checkmark.shield.fill" : "checkmark.circle.fill") : (issues == 1 ? singleSymbol : (openRows.length == 0 ? "lock.open.fill" : "exclamationmark.triangle.fill")))
  derive fuel = round(status.fuel)
  // Not read yet is not empty: until the first reading, the fuel card
  // shows its shape and no number (loading and 0 % are different facts).
  derive fuelKnown = status.ok
  derive electric = car.fuelType == "E"
  derive unit = distanceUnit(status.rangeUnit)
  derive odoUnit = distanceUnit(status.odometerUnit)
  derive extras = car.capabilities.map(f => extraName(f)).filter(n => n != "")
  // describeExtraControls: "Trunk, headlights, hazards, horn, and buzzer".
  derive extrasText = extras.length == 0 ? "" : (extras.length == 1 ? capitalized(extras.join("")) : `${extras.filter((n, i) => i < extras.length - 1).map((n, i) => i == 0 ? capitalized(n) : n).join(", ")}${extras.length > 2 ? "," : ""} and ${extras.filter((n, i) => i == extras.length - 1).join("")}`)
  derive canEngine = can(car.capabilities, "remoteEngineStartStop")
  view
    scroll id="screen-scroll" testId="status-scroll" -exact-scroll-edge-effect="soft" overflow-x="hidden" flex=1 min-height=0 width="100%" refresh=reload refreshing=refreshing class=SafeScroll
      column box-sizing="border-box" min-height="100%"
        column box-sizing="border-box" padding-top=16 padding-left=16 padding-right=16 gap=16 flex-grow=(car.vin == "" and not loading ? 1 : 0)
          // Banners (src/components/ui/status-banner.tsx)
          // use-vehicle-screen.tsx / status-banner.tsx: offline, amber.
          if not online
            WarningBanner(id="offline", still=still, above="0px", symbol="wifi.slash", framed=false, title="You're offline", message=(car.vin != "" ? "Showing the latest data we saved." : "Reconnect to see your vehicle."))
          // use-vehicle-screen.tsx: "Couldn't refresh" over data already shown.
          if online and car.vin != "" and not loading and ((not garage.ok and garage.status != 401) or (status.error != "" and status.status != 401))
            WarningBanner(id="garage-error", still=still, above="0px", symbol="exclamationmark.triangle.fill", framed=true, title="Couldn’t refresh", message=`${(not garage.ok ? failureSummary(garage.status, garage.error) : failureSummary(status.status, status.error))}${(status.ok ? " Showing the latest data we saved." : "")} Pull down to try again.${failureNote}`)
          if car.vin == "" and not loading and garage.ok and garage.carCount == 0
            VehicleState(symbol="car_2", title="No vehicle found", message="There's no vehicle associated with this Lexus account. Add your vehicle in the Lexus app, then check again here.", label="Check again", press=reload, busy=retrying, id="no-vehicle")
          if car.vin == "" and not loading and not garage.ok
            VehicleState(symbol="exclamationmark.triangle", title="Vehicle data unavailable", message=`${failureAdvice(garage.status, garage.error)}${failureNote}`, label="Try again", press=reload, busy=retrying, id="vehicle-error")
          // vehicle-controls.ios.tsx: a failed command is an alert.
          dialog id="climate-failed" role="alertdialog" aria-label="Couldn't save climate settings"
            text climateError testId="climate-failed-message"
            button commandfor="climate-failed" command="close" testId="climate-failed-ok"
              text "OK"
          dialog id="command-failed" role="alertdialog" aria-label="Command didn't go through"
            text commandError testId="command-failed-message"
            button commandfor="command-failed" command="close" testId="command-failed-ok"
              text "OK"
          if notice != ""
            row testId="notice" class=Banner background-color=wash("-exact-system-blue") animation=bannerEnter(still) -exact-exit-animation="bannerOut 250ms ease-in both"
              image "symbol:icon.checkmark.circle.fill" font-size=17 color="-exact-system-blue" object-fit="scale-down" width=22 height=22
              text notice class=SmallBold color="-exact-system-blue" flex=1
          if firstLoad or car.vin != ""
            // Above the banners, which it covers as they come and go
            column testId=(firstLoad ? "skeleton" : "status-body") -exact-layout-transition=bannerGlide(still) z-index=1 gap=16 display=(wide ? "grid" : "flex") flex-direction="column" grid-template-columns=(wide ? (fold == "across" ? "minmax(0, 1fr)" : "minmax(0, 1fr) minmax(0, 1fr)") : "none") align-items=(wide ? "start" : "stretch") margin-left=(fold == "across" ? "-16px" : "0px") margin-right=(fold == "across" ? "-16px" : "0px") animation=(firstLoad and online ? "pending 800ms ease-in-out infinite alternate" : "none") animation-timeline=Activity
              if firstLoad
                column class=Card testId="skeleton-hero" height=265 padding=16 box-sizing="border-box" justify-content="flex-end" align-items="flex-end" grid-column=(wide ? "1" : "auto") grid-row=(wide ? "1" : "auto") margin-left=(fold == "across" ? "16px" : "0px") width=(fold == "across" ? "calc(env(viewport-segment-width 0 0) - env(safe-area-inset-left) - 32px)" : "auto")
                  box width=148 height=48 border-radius=24 background-color="-exact-tertiary-fill"
                column class=Card padding=16 gap=12 grid-column=(wide ? "1" : "auto") margin-left=(fold == "across" ? "16px" : "0px") width=(fold == "across" ? "calc(env(viewport-segment-width 0 0) - env(safe-area-inset-left) - 32px)" : "auto") box-sizing="border-box"
                  row justify-content="space-between"
                    box width=72 height=16 border-radius=6 background-color="-exact-tertiary-fill"
                    box width=110 height=16 border-radius=6 background-color="-exact-tertiary-fill"
                  box height=8 border-radius=4 background-color="-exact-tertiary-fill"
                column testId="skeleton-controls" gap=16 grid-column=(wide ? (fold == "across" ? "1" : "2") : "auto") grid-row=(wide ? "1 / span 5" : "auto") margin-left=(fold == "across" ? "calc(env(viewport-segment-left 1 0) - env(safe-area-inset-left))" : "0px") padding-left=(fold == "across" ? "16px" : "0px") padding-right=(fold == "across" ? "16px" : "0px")
                  column gap=8
                    box width=140 height=21 border-radius=6 margin-left=16 background-color="-exact-tertiary-fill"
                    row gap=8
                      for i in range(3) key=i
                        box flex=1 height=76 border-radius=18 background-color="-exact-secondary-grouped-background"
                  column class=Card height=80
                  column class=Card height=200
              if not firstLoad
                // Hero card (hero-card.ios.tsx): the car over its parked map.
                column class=Card testId="hero" opacity=(heroDim ? 0.6 : 1) transition="opacity 1000ms ease-in-out" overflow="hidden" align-items="center" gap=8 padding-top=8 padding-bottom=16 padding-left=16 padding-right=16 position="relative" grid-column=(wide ? "1" : "auto") grid-row=(wide ? "1" : "auto") margin-left=(fold == "across" ? "16px" : "0px") width=(fold == "across" ? "calc(env(viewport-segment-width 0 0) - env(safe-area-inset-left) - 32px)" : "auto") box-sizing="border-box"
                  if status.ok and (status.latitude != 0 or status.longitude != 0)
                    column position="absolute" top=0 right=0 bottom=0 left=0
                      lexy-map width="100%" height="100%" latitude=status.latitude longitude=status.longitude map-zoom=16 pin="false" places="false" interactive="false"
                    // The card's own colour at 52% over the map dims it to the 48% an opacity on its box gave, without
                    // the offscreen pass group opacity costs in every frame the card scrolls
                    box position="absolute" top=0 right=0 bottom=0 left=0 background-color="-exact-secondary-grouped-background" opacity=0.52 pointer-events="none"
                  // The veil, the car and the button row let a touch through to
                  // the map below them, whose Legal link MapKit requires to work.
                  box position="absolute" top=0 right=0 bottom=0 left=0 background-color="light-dark(#ffffff38, #1c1c1e38)" pointer-events="none"
                  // hero-card.ios.tsx: the render at 110% width (700×631), centred and
                  // clipped to a 185pt frame, which trims its empty margins.
                  // Positioned, as the map and its wash are, so it paints over
                  // them in tree order (CSS paints positioned boxes after flow).
                  row position="relative" width="100%" height=185 overflow="hidden" align-items="center" justify-content="center" pointer-events="none"
                    if car.image != ""
                      image car.image aria-label=car.description width="min(110%, 440px)" max-width=(wide ? "372px" : "none") margin-top=(wide ? "24px" : "0px") aspect-ratio="700 / 631" flex-shrink=0 object-fit="contain"
                  row position="relative" width="100%" justify-content="flex-end" pointer-events="none"
                    button press=openMap pointer-events="auto" testId="last-parked" appearance="auto" buttonStyle="glass" width=148 height=48 border-radius=24 display="flex" flex-direction="row" align-items="center" justify-content="center"
                      image "symbol:icon.map.fill" font-size=15 -exact-tint-color="AccentColor"
                      text "Last Parked" font-size=15 font-weight=600 color="-exact-label"
                // Fuel (fuel-bar.tsx)
                column class=Card testId="fuel" padding=16 gap=8 grid-column=(wide ? "1" : "auto") grid-row=(wide ? "2" : "auto") margin-left=(fold == "across" ? "16px" : "0px") width=(fold == "across" ? "calc(env(viewport-segment-width 0 0) - env(safe-area-inset-left) - 32px)" : "auto") box-sizing="border-box"
                  row justify-content="space-between" align-items="center"
                    row gap=4 align-items="center"
                      image `symbol:icon.${(electric ? "bolt.fill" : "fuelpump.fill")}` font-size=17 color=(fuelKnown ? fuelTint(fuel) : "-exact-tertiary-label") object-fit="scale-down" width=17 height=17
                      text (electric ? "Charge" : "Fuel") class=SmallBold color="-exact-secondary-label"
                    if fuelKnown
                      row
                        text (fuel >= 100 ? "Full" : `${fuel}%`) testId="fuel-value" class=SmallBold color=fuelText(fuel) font-variant-numeric="tabular-nums"
                        text ` · ${grouped(status.range)} ${unit}` testId="range" class=SmallBold color="-exact-label" font-variant-numeric="tabular-nums"
                    if not fuelKnown
                      if loading
                        box testId="fuel-pending" width=110 height=16 border-radius=6 background-color="-exact-tertiary-fill" animation="pending 800ms ease-in-out infinite alternate" animation-timeline=Activity
                      if not loading
                        text "Unavailable" testId="fuel-unavailable" class=SmallBold color="-exact-secondary-label"
                  row gap=4
                    box flex=1 height=8 border-radius=4 background-color="-exact-tertiary-fill" overflow="hidden"
                      box height="100%" border-radius=4 width=`${min(100, max(0, fuel * 4))}%` background-color=fuelTint(fuel)
                    box flex=1 height=8 border-radius=4 background-color="-exact-tertiary-fill" overflow="hidden"
                      box height="100%" border-radius=4 width=`${min(100, max(0, (fuel - 25) * 4))}%` background-color=fuelTint(fuel)
                    box flex=1 height=8 border-radius=4 background-color="-exact-tertiary-fill" overflow="hidden"
                      box height="100%" border-radius=4 width=`${min(100, max(0, (fuel - 50) * 4))}%` background-color=fuelTint(fuel)
                    box flex=1 height=8 border-radius=4 background-color="-exact-tertiary-fill" overflow="hidden"
                      box height="100%" border-radius=4 width=`${min(100, max(0, (fuel - 75) * 4))}%` background-color=fuelTint(fuel)
                column testId="controls-column" gap=16 grid-column=(wide ? (fold == "across" ? "1" : "2") : "auto") grid-row=(wide ? "1 / span 5" : "auto") margin-left=(fold == "across" ? "calc(env(viewport-segment-left 1 0) - env(safe-area-inset-left))" : "0px") padding-left=(fold == "across" ? "16px" : "0px") padding-right=(fold == "across" ? "16px" : "0px")
                  // Remote controls (vehicle-controls.ios.tsx)
