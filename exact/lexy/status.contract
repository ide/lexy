                              Corner(title="Rear passenger", driver=false, door=first(corners.filter(s => cornerOf(s) == "rear-passenger" and partOf(s) == "door")), window=first(corners.filter(s => cornerOf(s) == "rear-passenger" and partOf(s) == "window")), lockPending=lockPending, lockTarget=lockTarget)
                          if openings.length > 0
