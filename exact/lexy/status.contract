                    row justify-content="space-between" align-items="center" flex-wrap="wrap" gap=8 testId="controls-header"
                      text "Remote Controls" role="heading" aria-level=2 class=SectionTitle margin-top=4
                      row gap=8 margin-left=16 margin-right=8 align-items="center" flex-wrap="wrap"
                        row gap=4 align-items="center" flex-shrink=0 testId="lock-state"
                          image `symbol:icon.${(lockState == "unknown" ? "lock.shield.fill" : (lockState == "locked" ? "lock.fill" : "lock.open.fill"))}` font-size=13 color=lockColor object-fit="scale-down" width=13 height=13
                          text lockWord testId="lock-label" class=SmallBold color=lockColor animation=(lockPending ? "pending 800ms ease-in-out infinite alternate" : "none") animation-timeline=Pending
                        // No reading yet, no indicator (vehicle-controls.ios.tsx).
                        if canEngine and (engineKnown or enginePending)
                          row gap=4 align-items="center" flex-shrink=0 testId="engine-state"
                            image "symbol:icon.power" font-size=13 color=(engineRunning ? "-exact-system-green" : "-exact-secondary-label") object-fit="scale-down" width=13 height=13
                            // One label, its width the longest the engine can say:
                            // hidden copies of every word share its cell and size it
                            // at any text size, so Locked beside it never moves. The
                            // label is the one element that changes.
                            box display="grid"
                              for word in ["Stopped", "Starting", "Started", "Stopping"] key=word
                                text word class=SmallBold grid-row="1" grid-column="1" visibility="hidden"
                              text engineWord class=SmallBold grid-row="1" grid-column="1" color=(engineRunning ? "-exact-system-green" : "-exact-secondary-label") animation=(enginePending ? "pending 800ms ease-in-out infinite alternate" : "none") animation-timeline=Pending
                    // vehicle-controls.ios.tsx: Lock, Unlock and Start/Stop, always.
                    row gap=8
                      ControlButton(command="door-lock", label="Lock", symbol="lock.fill", tint="-exact-system-green", title="Lock your vehicle?", message="This locks all doors.", action="Lock", destructive=false, disabled=false, glass=true, iconSize=20, run=run)
                      ControlButton(command="door-unlock", label="Unlock", symbol="lock.open.fill", tint="-exact-system-orange", title="Unlock your vehicle?", message="This unlocks the doors. Only do this when you’re near the vehicle.", action="Unlock", destructive=true, disabled=false, glass=true, iconSize=20, run=run)
                      if engineRunning
                        ControlButton(command="engine-stop", label="Stop", symbol="power", tint="-exact-system-red", title="Stop the engine?", message="This ends the remote start.", action="Stop Engine", destructive=false, disabled=false, glass=true, iconSize=20, run=run)
                      else
                        ControlButton(command="engine-start", label="Start", symbol="power", tint="-exact-system-blue", title="Remotely start the engine?", message="Never remotely start the engine in an enclosed space, or with a child or pet inside the vehicle.", action="Start Engine", destructive=true, disabled=false, glass=true, iconSize=20, run=run)
                    if extras.length > 0
                      column class=Card margin-top=8 overflow="hidden" testId="more-controls"
                        button text-align="left" press=toggleMore disabled=wide testId="toggle-more" min-height=56 padding-top=12 padding-bottom=12 box-sizing="content-box" padding-left=16 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                          // expandable-card.tsx: the badge and words 12 apart, the chevron 8.
