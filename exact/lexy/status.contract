                  if true
                    column class=Card testId="climate" padding=16 gap=16 animation=(climateWriting ? "climateWriting 900ms ease-in-out infinite alternate" : "none")
                      column gap=4
                        row justify-content="space-between" align-items="center"
                          row gap=4 align-items="center"
                            image "symbol:icon.thermometer.medium" font-size=17 color="AccentColor" object-fit="scale-down" width=17 height=17
                            text "Remote Start Climate" role="heading" aria-level=2 font="-exact-headline" color="-exact-secondary-label"
                          // The real switch from the first frame, as the buttons
