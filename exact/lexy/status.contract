                        column box-sizing="border-box" overflow="hidden" height=(moreOpen or wide ? "auto" : "0px") interpolate-size="allow-keywords" transition="height 300ms ease-in-out" inert=(not moreOpen and not wide) testId="more-detail"
                          row flex-wrap="wrap" gap=8 padding-left=16 padding-right=16 padding-bottom=16
                            if can(car.capabilities, "trunkLockUnlockCapable")
                              column width="calc(33.333% - 5.34px)"
                                ControlButton(command="trunk-lock", label="Lock Trunk", symbol="car.side.rear.crop.trunk.partition.fill", tint="-exact-system-green", title="Lock the trunk?", message="This locks the trunk.", action="Lock Trunk", destructive=false, disabled=false, glass=false, iconSize=20, run=run)
                              column width="calc(33.333% - 5.34px)"
                                ControlButton(command="trunk-unlock", label="Unlock Trunk", symbol="car.side.rear.crop.trunk.partition", tint="-exact-system-orange", title="Unlock the trunk?", message="This unlocks the trunk. Only do this when you’re near the vehicle.", action="Unlock Trunk", destructive=true, disabled=false, glass=false, iconSize=20, run=run)
                            if can(car.capabilities, "hazardCapable")
