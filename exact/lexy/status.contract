                          image "symbol:icon.chevron.right" font-size=14 font-weight=600 color="-exact-secondary-label" object-fit="scale-down" width=16 height=20 rotate=(moreOpen ? 90 : 0) transition="rotate 300ms ease-in-out" display=(wide ? "none" : "flex")
                        // expandable-card.tsx: the detail's height eases from 0 to its own
